		part(V3(2.4, 0.2, 5.2), b * CF(i * 7 - 8, 1.4, -15), rgb(60, 64, 72))
		part(V3(0.6, 4, 0.6), b * CF(i * 7 - 8.9, 3, -17.6), C.steel)
		part(V3(0.6, 4, 0.6), b * CF(i * 7 - 7.1, 3, -17.6), C.steel)
		part(V3(2.6, 1.6, 0.8), b * CF(i * 7 - 8, 5, -17.6), rgb(80, 240, 150), MAT.Plastic)
	end
	for i = 0, 3 do
		part(V3(1.4, 1.8, 1.4), b * CF(8 + i * 3, 0.9, -7), rgb(255, 130, 40))
		part(V3(0.9, 0.5, 0.9), b * CF(8 + i * 3, 2.05, -7), WHITE)
	end
	for i = 0, 2 do
		part(V3(0.4, 3, 0.4), b * CF(10 + i * 4, 1.5, -12), WHITE)
		part(V3(0.4, 3, 0.4), b * CF(12.4 + i * 4, 1.5, -12), WHITE)
		part(V3(2.8, 0.4, 0.4), b * CF(11.2 + i * 4, 3, -12), rgb(100, 235, 140), MAT.Plastic)
	end
	part(V3(2.4, 4, 2.4), b * CF(16, 2, -17), rgb(120, 190, 240), MAT.Glass, { Transparency = 0.3 })
	part(V3(2.6, 1, 2.6), b * CF(16, 0.5, -17), C.dark)
end

