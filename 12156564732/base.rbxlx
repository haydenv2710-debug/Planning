local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")

local M = {}
local C = {
	brick = Color3.fromRGB(58, 60, 68), brickDark = Color3.fromRGB(30, 31, 37), brickLight = Color3.fromRGB(88, 91, 102),
	red = Color3.fromRGB(176, 32, 30), redDark = Color3.fromRGB(110, 18, 18),
	purple = Color3.fromRGB(170, 70, 255), blue = Color3.fromRGB(40, 150, 255), green = Color3.fromRGB(110, 220, 50),
	orange = Color3.fromRGB(255, 110, 30), yellow = Color3.fromRGB(255, 214, 70), pink = Color3.fromRGB(255, 96, 130),
	white = Color3.fromRGB(236, 238, 244), black = Color3.fromRGB(14, 14, 18), panel = Color3.fromRGB(22, 23, 29),
}
M.C = C

M.TIERS = {
	{ name = "SUB-5", col = Color3.fromRGB(140, 200, 120), rarity = "45%", desc = "Le bas du bas. Facile a mog." },
	{ name = "LTN", col = Color3.fromRGB(175, 175, 188), rarity = "28%", desc = "Low Tier Normie." },
	{ name = "MTN", col = Color3.fromRGB(110, 170, 255), rarity = "15%", desc = "Mid Tier Normie." },
	{ name = "HTN", col = Color3.fromRGB(255, 170, 70), rarity = "8%", desc = "High Tier Normie. Dangereux." },
	{ name = "CHADLITE", col = Color3.fromRGB(255, 110, 200), rarity = "3.5%", desc = "Presque parfait." },
	{ name = "CHAD", col = Color3.fromRGB(255, 214, 70), rarity = "0.5%", desc = "Le boss de la ville." },
}

local function make(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do i[k] = v end
	i.Parent = parent
	return i
end
M.make = make

function M.tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
local tween = M.tween

function M.sfx(name)
	local ids = { ping = "rbxasset://sounds/electronicpingshort.wav", hit = "rbxasset://sounds/swordslash.wav", ko = "rbxasset://sounds/uuhhh.mp3" }
	local gui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not gui or not ids[name] then return end
	local s = make("Sound", { SoundId = ids[name], Volume = 0.5 }, gui)
	s:Play()
	Debris:AddItem(s, 3)
end

-- grille de studs ronds qui remplit `parent`
function M.studs(parent, cols, rows, color, gap)
	gap = gap or 3
	local holder = make("Frame", { Name = "Studs", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Active = false, ZIndex = 1 }, parent)
	make("UIGridLayout", {
		CellSize = UDim2.new(1 / cols, -gap, 1 / rows, -gap), CellPadding = UDim2.fromOffset(gap, gap),
		SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center,
	}, holder)
	for i = 1, cols * rows do
		local s = make("Frame", { BackgroundColor3 = color, BorderSizePixel = 0, LayoutOrder = i, Active = false }, holder)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, s)
	end
	return holder
end

function M.panel(parent, p)
	local col = p.color or C.brick
	local f = make("Frame", {
		Name = p.Name or "Panel", Size = p.Size, Position = p.Position or UDim2.new(), AnchorPoint = p.AnchorPoint or Vector2.zero,
		BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = p.z or 1,
	}, parent)
	make("UICorner", { CornerRadius = UDim.new(0, p.radius or 8) }, f)
	make("UIStroke", { Color = p.strokeColor or C.brickDark, Thickness = p.stroke or 4 }, f)
	if p.cols then M.studs(f, p.cols, p.rows, col:Lerp(Color3.new(1, 1, 1), p.light or 0.09), p.gap or 3) end
	return f
end

function M.label(parent, text, p)
	p = p or {}
	local l = make("TextLabel", {
		Name = p.Name or "Label", BackgroundTransparency = 1, Text = text, Size = p.Size or UDim2.fromScale(1, 1),
		Position = p.Position or UDim2.new(), AnchorPoint = p.AnchorPoint or Vector2.zero, TextColor3 = p.color or C.white,
		TextScaled = true, Font = p.font or Enum.Font.GothamBlack, TextXAlignment = p.xAlign or Enum.TextXAlignment.Center,
		ZIndex = p.z or 2,
	}, parent)
	if p.stroke ~= false then
		make("UIStroke", { Color = p.strokeColor or Color3.new(0, 0, 0), Thickness = p.strokeThickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, l)
	end
	return l
end

-- titre "extrude" style lettres en briques
function M.title(parent, text, size, pos, color)
	local holder = make("Frame", { BackgroundTransparency = 1, Size = size, Position = pos, ZIndex = 3 }, parent)
	M.label(holder, text, { Position = UDim2.fromOffset(4, 6), color = Color3.fromRGB(16, 16, 20), stroke = false, z = 3 })
	M.label(holder, text, { color = color or Color3.fromRGB(150, 152, 162), strokeColor = Color3.fromRGB(24, 24, 28), strokeThickness = 3, z = 4 })
	return holder
end

function M.button(parent, text, p)
	local col = p.color or C.red
	local b = make("TextButton", {
		Name = p.Name or text, Text = "", AutoButtonColor = false, BackgroundColor3 = col, BorderSizePixel = 0,
		Size = p.Size, Position = p.Position or UDim2.new(), AnchorPoint = p.AnchorPoint or Vector2.zero, ZIndex = p.z or 2,
		LayoutOrder = p.LayoutOrder or 0,
	}, parent)
	make("UICorner", { CornerRadius = UDim.new(0, 7) }, b)
	make("UIStroke", { Color = col:Lerp(Color3.new(0, 0, 0), 0.65), Thickness = 3 }, b)
	M.studs(b, p.cols or 9, p.rows or 3, col:Lerp(Color3.new(1, 1, 1), 0.2), 2)
	M.label(b, text, { Size = UDim2.fromScale(p.textW or 0.86, p.textH or 0.52), Position = UDim2.fromScale((1 - (p.textW or 0.86)) / 2, (1 - (p.textH or 0.52)) / 2), z = 3 })
	local sc = make("UIScale", {}, b)
	b.MouseEnter:Connect(function() tween(sc, 0.12, { Scale = 1.06 }) end)
	b.MouseLeave:Connect(function() tween(sc, 0.12, { Scale = 1 }) end)
	b.MouseButton1Down:Connect(function() tween(sc, 0.08, { Scale = 0.93 }) end)
	b.MouseButton1Up:Connect(function() tween(sc, 0.12, { Scale = 1.06 }, Enum.EasingStyle.Back) end)
	return b
end

------------------------------------------------------------------
-- EFFETS
------------------------------------------------------------------
function M.pop(obj, s)
	local sc = obj:FindFirstChildOfClass("UIScale") or make("UIScale", {}, obj)
	sc.Scale = s or 1.35
	tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

function M.burst(parent, pos, color, count, dist)
	for _ = 1, count or 12 do
		local s = make("Frame", {
			Size = UDim2.fromOffset(math.random(6, 13), math.random(6, 13)), AnchorPoint = Vector2.new(0.5, 0.5),
			Position = pos, BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 50,
		}, parent)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, s)
		local a = math.random() * math.pi * 2
		local d = (dist or 90) * (0.4 + math.random() * 0.8)
		tween(s, 0.5 + math.random() * 0.3, { Position = pos + UDim2.fromOffset(math.cos(a) * d, math.sin(a) * d), BackgroundTransparency = 1, Size = UDim2.fromOffset(3, 3) })
		Debris:AddItem(s, 1.2)
	end
end

function M.shake(obj, mag, dur)
	local id = (obj:GetAttribute("_sh") or 0) + 1
	obj:SetAttribute("_sh", id)
	if obj:GetAttribute("_base") == nil then obj:SetAttribute("_base", obj.Position) end
	local base = obj:GetAttribute("_base")
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < dur and obj.Parent do
			if obj:GetAttribute("_sh") ~= id then return end
			local k = 1 - (os.clock() - t0) / dur
			obj.Position = base + UDim2.fromOffset(math.random(-mag, mag) * k, math.random(-mag, mag) * k)
			task.wait()
		end
		if obj.Parent and obj:GetAttribute("_sh") == id then
			obj.Position = base
			obj:SetAttribute("_base", nil)
		end
	end)
end

function M.flash(gui, color, alpha, dur)
	local f = make("Frame", { BackgroundColor3 = color, BackgroundTransparency = alpha or 0.5, Size = UDim2.fromScale(1, 1), ZIndex = 80, Active = false }, gui)
	tween(f, dur or 0.4, { BackgroundTransparency = 1 })
	Debris:AddItem(f, (dur or 0.4) + 0.1)
end

function M.stamp(parent, text, color, size, pos)
	local l = M.label(parent, text, {
		Size = size or UDim2.fromScale(0.5, 0.4), Position = pos or UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		color = color, z = 60, strokeThickness = 4,
	})
	local sc = make("UIScale", { Scale = 3 }, l)
	l.Rotation = -10
	l.TextTransparency = 1
	tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(l, 0.2, { TextTransparency = 0 })
	return l
end

function M.confetti(parent, n)
	local cols = { C.yellow, C.pink, C.blue, C.green, C.purple, C.orange }
	for i = 1, n or 40 do
		task.delay(math.random() * 0.8, function()
			if not parent.Parent then return end
			local s = make("Frame", {
				Size = UDim2.fromOffset(math.random(8, 14), math.random(8, 14)), AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(math.random(), -0.05), BackgroundColor3 = cols[math.random(1, #cols)], BorderSizePixel = 0, ZIndex = 70, Rotation = math.random(0, 90),
			}, parent)
			make("UICorner", { CornerRadius = UDim.new(0.3, 0) }, s)
			tween(s, 1.6 + math.random(), { Position = UDim2.fromScale(math.random(), 1.1), Rotation = math.random(-300, 300) }, Enum.EasingStyle.Sine)
			Debris:AddItem(s, 3)
		end)
	end
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Minigames</string><ProtectedString name="Source"><![CDATA[-- Minigames : ModuleScript (enfant de MogClient) - un mini-jeu par station
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local S = require(script.Parent.Studs)
local C, make, tween = S.C, S.make, S.tween

local M = {}
M.current = nil
local GAMES = {}

local INFO = {
	face = { title = "FACE LAB", sub = "TIMING - clique dans la zone verte", color = C.pink, hint = "CLIC / TAP / ESPACE pour valider", duration = 28 },
	frame = { title = "IRON GYM", sub = "SPAM pour soulever la barre", color = C.orange, hint = "TAPE le plus vite possible ! (CLIC / ESPACE)", duration = 20 },
	height = { title = "HEIGHT DOJO", sub = "MAINTIENS la barre dans la zone", color = C.blue, hint = "MAINTIENS CLIC / TAP / ESPACE pour monter", duration = 24 },
	bodyfat = { title = "CARDIO CLUB", sub = "ESQUIVE les haies - prends l'eau", color = C.green, hint = "TAP gauche / droite  -  A / D  -  fleches", duration = 22 },
}

local function grade(score)
	if score >= 0.9 then return "S", C.yellow end
	if score >= 0.7 then return "A", C.green end
	if score >= 0.45 then return "B", C.blue end
	return "C", Color3.fromRGB(190, 190, 205)
end

local function newShell(gui, info, onSubmit, onClose)
	local sh = { conns = {}, alive = true, info = info }
	local dim = make("Frame", { Name = "MiniGame", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 10, Active = true }, gui)
	tween(dim, 0.3, { BackgroundTransparency = 0.4 })
	local panel = S.panel(dim, { Size = UDim2.fromScale(0.66, 0.8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), cols = 30, rows = 18, z = 11 })
	make("UIAspectRatioConstraint", { AspectRatio = 1.55 }, panel)
	local sc = make("UIScale", { Scale = 0.5 }, panel)
	tween(sc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	S.title(panel, info.title, UDim2.fromScale(0.56, 0.12), UDim2.fromScale(0.04, 0.02), info.color)
	S.label(panel, info.sub, { Size = UDim2.fromScale(0.5, 0.045), Position = UDim2.fromScale(0.05, 0.145), color = C.white, font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, z = 4 })
	local back = make("Frame", { BackgroundColor3 = C.panel, Size = UDim2.fromScale(0.9, 0.035), Position = UDim2.fromScale(0.05, 0.195), BorderSizePixel = 0, ZIndex = 4 }, panel)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, back)
	local fill = make("Frame", { BackgroundColor3 = info.color, Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, ZIndex = 5 }, back)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, fill)
	function sh.setTimer(frac)
		frac = math.clamp(frac, 0, 1)
		fill.Size = UDim2.fromScale(frac, 1)
		fill.BackgroundColor3 = info.color:Lerp(C.red, 1 - frac)
	end
	local arena = make("Frame", { Name = "Arena", BackgroundColor3 = C.panel, Size = UDim2.fromScale(0.92, 0.64), Position = UDim2.fromScale(0.04, 0.25), BorderSizePixel = 0, ZIndex = 4, ClipsDescendants = true }, panel)
	make("UICorner", { CornerRadius = UDim.new(0, 8) }, arena)
	make("UIStroke", { Color = C.brickDark, Thickness = 4 }, arena)
	S.studs(arena, 28, 12, Color3.fromRGB(30, 31, 38), 4).ZIndex = 4
	S.label(panel, info.hint, { Size = UDim2.fromScale(0.9, 0.05), Position = UDim2.fromScale(0.05, 0.915), color = Color3.fromRGB(190, 192, 205), font = Enum.Font.GothamBold, stroke = false, z = 4 })
	local x = S.button(panel, "X", { Size = UDim2.fromScale(0.07, 0.1), Position = UDim2.fromScale(0.91, 0.02), color = C.red, cols = 3, rows = 3, textW = 0.7, textH = 0.7, z = 12 })
	make("UIAspectRatioConstraint", { AspectRatio = 1 }, x)
	sh.dim, sh.panel, sh.arena = dim, panel, arena
	sh.started = os.clock()

	local function close()
		tween(dim, 0.3, { BackgroundTransparency = 1 })
		tween(sc, 0.3, { Scale = 0.2 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.delay(0.32, function()
			dim:Destroy()
			if M.current == sh then M.current = nil end
			onClose()
		end)
	end
	x.Activated:Connect(function()
		if not sh.alive then return end
		sh.alive = false
		for _, c in ipairs(sh.conns) do c:Disconnect() end
		onSubmit(-1)
		close()
	end)

	function sh.finish(score)
		if not sh.alive then return end
		sh.alive = false
		for _, c in ipairs(sh.conns) do c:Disconnect() end
		score = math.clamp(score, 0, 1)
		local g, col = grade(score)
		local ov = make("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 30, Active = true }, panel)
		make("UICorner", { CornerRadius = UDim.new(0, 8) }, ov)
		tween(ov, 0.3, { BackgroundTransparency = 0.3 })
		local st = S.stamp(panel, g, col, UDim2.fromScale(0.34, 0.5), UDim2.fromScale(0.5, 0.42))
		st.ZIndex = 40
		S.label(panel, "SCORE " .. math.floor(score * 100) .. "%", { Size = UDim2.fromScale(0.5, 0.08), Position = UDim2.fromScale(0.25, 0.68), color = C.white, z = 40 })
		sh.gain = S.label(panel, "...", { Size = UDim2.fromScale(0.7, 0.1), Position = UDim2.fromScale(0.15, 0.78), color = col, z = 40 })
		S.sfx("ping")
		S.burst(panel, UDim2.fromScale(0.5, 0.42), col, 26, 170)
		if score >= 0.9 then S.confetti(panel, 50) end
		S.shake(panel, 8, 0.4)
		onSubmit(score)
		task.delay(3.6, close)
	end
	M.current = sh
	return sh
end

local function tapArea(sh, z)
	return make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = z or 20 }, sh.arena)
end

local function key(sh, fn, ended)
	table.insert(sh.conns, UIS.InputBegan:Connect(function(i, gp)
		if i.UserInputType == Enum.UserInputType.Keyboard then fn(i.KeyCode, true) end
	end))
	table.insert(sh.conns, UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Keyboard then fn(i.KeyCode, false) end
	end))
end

local function corner(o, r) make("UICorner", { CornerRadius = UDim.new(r or 0.15, 0) }, o) end

------------------------------------------------------------------
-- FACE : timing + boutons qui disparaissent
------------------------------------------------------------------
GAMES.face = function(sh)
	local A = sh.arena
	local ROUNDS = 6
	local sick, healthy = Color3.fromRGB(150, 168, 100), Color3.fromRGB(238, 190, 150)
	local head = make("Frame", { Size = UDim2.fromScale(0.2, 0.62), Position = UDim2.fromScale(0.4, 0.04), BackgroundColor3 = sick, BorderSizePixel = 0, ZIndex = 6 }, A)
	corner(head, 0.16)
	make("UIStroke", { Color = Color3.fromRGB(20, 20, 24), Thickness = 4 }, head)
	for _, x in ipairs({ 0.22, 0.62 }) do
		local e = make("Frame", { Size = UDim2.fromScale(0.16, 0.11), Position = UDim2.fromScale(x, 0.3), BackgroundColor3 = C.black, BorderSizePixel = 0, ZIndex = 7 }, head)
		corner(e, 0.3)
	end
	local mouth = make("Frame", { Size = UDim2.fromScale(0.4, 0.06), Position = UDim2.fromScale(0.3, 0.72), BackgroundColor3 = C.black, BorderSizePixel = 0, ZIndex = 7 }, head)
	corner(mouth, 0.5)
	local pimples, cleared = {}, 0
	local spots = { { 0.12, 0.12 }, { 0.62, 0.1 }, { 0.4, 0.2 }, { 0.78, 0.45 }, { 0.08, 0.5 }, { 0.3, 0.55 }, { 0.62, 0.58 }, { 0.46, 0.84 } }
	for _, s in ipairs(spots) do
		local p = make("Frame", { Size = UDim2.fromScale(0.13, 0.1), Position = UDim2.fromScale(s[1], s[2]), BackgroundColor3 = Color3.fromRGB(200, 50, 50), BorderSizePixel = 0, ZIndex = 8 }, head)
		make("UIAspectRatioConstraint", { AspectRatio = 1 }, p)
		corner(p, 0.5)
		table.insert(pimples, p)
	end
	local track = make("Frame", { Size = UDim2.fromScale(0.9, 0.16), Position = UDim2.fromScale(0.05, 0.76), BackgroundColor3 = Color3.fromRGB(40, 42, 54), BorderSizePixel = 0, ZIndex = 6 }, A)
	corner(track, 0.2)
	make("UIStroke", { Color = C.brickDark, Thickness = 3 }, track)
	local zone = make("Frame", { Size = UDim2.fromScale(0.2, 1), BackgroundColor3 = Color3.fromRGB(70, 220, 120), BorderSizePixel = 0, ZIndex = 7 }, track)
	corner(zone, 0.15)
	local gold = make("Frame", { Size = UDim2.fromScale(0.3, 1), Position = UDim2.fromScale(0.35, 0), BackgroundColor3 = C.yellow, BorderSizePixel = 0, ZIndex = 8 }, zone)
	local cursor = make("Frame", { Size = UDim2.fromScale(0.012, 1.35), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 10 }, track)
	local fb = S.label(A, "", { Size = UDim2.fromScale(0.3, 0.12), Position = UDim2.fromScale(0.35, 0.62), color = C.yellow, z = 12 })
	local roundLbl = S.label(A, "ROUND 1/" .. ROUNDS, { Size = UDim2.fromScale(0.18, 0.08), Position = UDim2.fromScale(0.02, 0.03), color = C.white, xAlign = Enum.TextXAlignment.Left, z = 12 })

	local round, pos, dir, total, center, width, locked = 1, 0, 1, 0, 0.5, 0.22, false
	local function setup()
		width = 0.22 - 0.02 * (round - 1)
		center = 0.2 + math.random() * 0.6
		zone.Size = UDim2.fromScale(width, 1)
		zone.Position = UDim2.fromScale(center - width / 2, 0)
		S.pop(zone, 1.2)
		roundLbl.Text = "ROUND " .. round .. "/" .. ROUNDS
		locked = false
	end
	setup()
	local function hit()
		if not sh.alive or locked then return end
		locked = true
		local d = math.abs(pos - center)
		local val, txt, col, rem = 0, "RATE...", C.red, 0
		if d <= width / 2 * 0.3 then val, txt, col, rem = 1, "PERFECT !", C.yellow, 2
		elseif d <= width / 2 then val, txt, col, rem = 0.7, "GOOD", C.green, 1 end
		total += val
		fb.Text, fb.TextColor3 = txt, col
		S.pop(fb, 1.6)
		local bx = UDim2.fromScale(pos, 0.5)
		S.burst(track, bx, col, val > 0 and 16 or 6, 80)
		if val == 0 then S.shake(sh.panel, 6, 0.25) else S.sfx("ping") end
		for _ = 1, rem do
			cleared += 1
			local p = pimples[cleared]
			if p then
				S.burst(head, p.Position, C.white, 8, 60)
				tween(p, 0.3, { BackgroundTransparency = 1, Size = UDim2.fromScale(0, 0) })
			end
		end
		tween(head, 0.35, { BackgroundColor3 = sick:Lerp(healthy, math.min(1, cleared / 8)) })
		S.pop(head, 1.1)
		round += 1
		task.delay(0.55, function()
			if not sh.alive then return end
			if round > ROUNDS then sh.finish(total / ROUNDS) else fb.Text = "" setup() end
		end)
	end
	local tap = tapArea(sh)
	tap.Activated:Connect(hit)
	key(sh, function(k, down) if down and k == Enum.KeyCode.Space then hit() end end)
	table.insert(sh.conns, RunService.RenderStepped:Connect(function(dt)
		local el = os.clock() - sh.started
		sh.setTimer(1 - el / sh.info.duration)
		if el >= sh.info.duration then sh.finish(total / ROUNDS) return end
		local speed = 0.85 + 0.22 * round
		pos += dir * speed * dt
		if pos > 1 then pos, dir = 1, -1 elseif pos < 0 then pos, dir = 0, 1 end
		cursor.Position = UDim2.fromScale(pos, 0.5)
		gold.BackgroundTransparency = 0.15 + 0.15 * math.sin(el * 8)
	end))
end

------------------------------------------------------------------
-- FRAME : spam de tap pour soulever (reps)
------------------------------------------------------------------
GAMES.frame = function(sh)
	local A = sh.arena
	local GOAL = 8
	local meterBack = make("Frame", { Size = UDim2.fromScale(0.07, 0.8), Position = UDim2.fromScale(0.04, 0.1), BackgroundColor3 = Color3.fromRGB(40, 42, 54), BorderSizePixel = 0, ZIndex = 6 }, A)
	corner(meterBack, 0.2)
	make("UIStroke", { Color = C.brickDark, Thickness = 3 }, meterBack)
	local mfill = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0.25), BackgroundColor3 = C.orange, BorderSizePixel = 0, ZIndex = 7 }, meterBack)
	corner(mfill, 0.2)
	S.label(A, "POWER", { Size = UDim2.fromScale(0.1, 0.07), Position = UDim2.fromScale(0.025, 0.01), z = 8 })
	local reps = 0
	local repLbl = S.label(A, "REPS 0/" .. GOAL, { Size = UDim2.fromScale(0.28, 0.12), Position = UDim2.fromScale(0.68, 0.03), color = C.yellow, xAlign = Enum.TextXAlignment.Right, z = 12 })
	-- barre + disques
	local rig = make("Frame", { Size = UDim2.fromScale(0.6, 0.26), Position = UDim2.fromScale(0.22, 0.6), BackgroundTransparency = 1, ZIndex = 6 }, A)
	local sc = make("UIScale", {}, rig)
	local bar = make("Frame", { Size = UDim2.fromScale(1, 0.12), Position = UDim2.fromScale(0, 0.44), BackgroundColor3 = Color3.fromRGB(150, 156, 170), BorderSizePixel = 0, ZIndex = 7 }, rig)
	corner(bar, 0.5)
	for side = 0, 1 do
		for k, w in ipairs({ 0.075, 0.05, 0.03 }) do
			local x = side == 0 and (0.02 + (k - 1) * 0.085) or (0.98 - (k - 1) * 0.085 - w)
			local h = 1 - (k - 1) * 0.2
			local p = make("Frame", { Size = UDim2.fromScale(w, h), Position = UDim2.fromScale(x, (1 - h) / 2), BackgroundColor3 = k == 1 and Color3.fromRGB(190, 40, 40) or (k == 2 and Color3.fromRGB(40, 90, 200) or Color3.fromRGB(230, 200, 50)), BorderSizePixel = 0, ZIndex = 8 }, rig)
			corner(p, 0.12)
			make("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }, p)
		end
	end
	-- haltérophile (tete + corps)
	local body = make("Frame", { Size = UDim2.fromScale(0.07, 0.3), Position = UDim2.fromScale(0.465, 0.64), BackgroundColor3 = C.black, BorderSizePixel = 0, ZIndex = 5 }, A)
	corner(body, 0.2)
	local hd = make("Frame", { Size = UDim2.fromScale(0.05, 0.13), Position = UDim2.fromScale(0.475, 0.5), BackgroundColor3 = Color3.fromRGB(245, 205, 48), BorderSizePixel = 0, ZIndex = 5 }, A)
	corner(hd, 0.2)
	local fb = S.label(A, "", { Size = UDim2.fromScale(0.3, 0.14), Position = UDim2.fromScale(0.35, 0.2), color = C.yellow, z = 12 })

	local p, over = 0.25, false
	local function tapFn()
		if not sh.alive then return end
		p = math.min(1.05, p + 0.085)
		S.burst(A, UDim2.fromScale(0.5, 0.55), C.orange, 3, 50)
		tween(sc, 0.06, { Scale = 1.06 })
		task.delay(0.06, function() if sc.Parent then tween(sc, 0.1, { Scale = 1 }) end end)
	end
	local tap = tapArea(sh)
	tap.Activated:Connect(tapFn)
	key(sh, function(k, down) if down and k == Enum.KeyCode.Space then tapFn() end end)
	table.insert(sh.conns, RunService.RenderStepped:Connect(function(dt)
		local el = os.clock() - sh.started
		sh.setTimer(1 - el / sh.info.duration)
		local score = math.min(1, (reps + p * 0.5) / GOAL)
		if el >= sh.info.duration then sh.finish(score) return end
		if over then return end
		p = math.max(0, p - (0.32 + 0.045 * reps) * dt)
		if p >= 1 then
			reps += 1
			p = 0.3
			repLbl.Text = "REPS " .. reps .. "/" .. GOAL
			S.pop(repLbl, 1.5)
			fb.Text = "REP " .. reps .. " !"
			fb.TextColor3 = C.yellow
			S.pop(fb, 1.7)
			S.shake(sh.panel, 9, 0.3)
			S.burst(A, UDim2.fromScale(0.5, 0.3), C.yellow, 22, 140)
			S.flash(sh.panel, C.orange, 0.75, 0.3)
			S.sfx("hit")
			if reps >= GOAL then
				over = true
				task.delay(0.5, function() sh.finish(1) end)
			end
			task.delay(0.8, function() if fb.Parent then fb.Text = "" end end)
		end
		mfill.Size = UDim2.fromScale(1, math.clamp(p, 0, 1))
		mfill.BackgroundColor3 = C.orange:Lerp(C.red, math.clamp(p, 0, 1))
		rig.Position = UDim2.fromScale(0.22, 0.6 - 0.46 * math.clamp(p, 0, 1))
	end))
end

------------------------------------------------------------------
-- HEIGHT : garde la barre dans la zone, la tour grandit
------------------------------------------------------------------
GAMES.height = function(sh)
	local A = sh.arena
	local track = make("Frame", { Size = UDim2.fromScale(0.12, 0.9), Position = UDim2.fromScale(0.14, 0.05), BackgroundColor3 = Color3.fromRGB(40, 42, 54), BorderSizePixel = 0, ZIndex = 6 }, A)
	corner(track, 0.15)
	make("UIStroke", { Color = C.brickDark, Thickness = 3 }, track)
	for i = 1, 9 do
		make("Frame", { Size = UDim2.fromScale(0.35, 0.008), Position = UDim2.fromScale(0, i / 10), BackgroundColor3 = Color3.fromRGB(80, 84, 100), BorderSizePixel = 0, ZIndex = 6 }, track)
	end
	local TH, BH = 0.26, 0.2
	local zone = make("Frame", { Size = UDim2.fromScale(1, TH), BackgroundColor3 = Color3.fromRGB(70, 220, 120), BackgroundTransparency = 0.35, BorderSizePixel = 0, ZIndex = 7 }, track)
	corner(zone, 0.15)
	local barf = make("Frame", { Size = UDim2.fromScale(0.7, BH), Position = UDim2.fromScale(0.15, 0.7), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 9 }, track)
	corner(barf, 0.2)
	make("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 3 }, barf)
	S.label(A, "GRANDIS", { Size = UDim2.fromScale(0.3, 0.1), Position = UDim2.fromScale(0.55, 0.02), color = C.blue, z = 8 })
	local blocks = {}
	local N = 12
	local col = make("Frame", { Size = UDim2.fromScale(0.22, 0.86), Position = UDim2.fromScale(0.62, 0.1), BackgroundTransparency = 1, ZIndex = 6 }, A)
	local ground = make("Frame", { Size = UDim2.fromScale(1.6, 0.03), Position = UDim2.fromScale(-0.3, 0.97), BackgroundColor3 = Color3.fromRGB(70, 72, 86), BorderSizePixel = 0, ZIndex = 6 }, col)
	for i = 1, N do
		local b = make("Frame", {
			Size = UDim2.fromScale(1, 0.07), Position = UDim2.fromScale(0, 0.97 - i * 0.0735), BackgroundColor3 = C.blue:Lerp(C.purple, i / N),
			BorderSizePixel = 0, ZIndex = 7, Visible = false,
		}, col)
		corner(b, 0.2)
		make("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }, b)
		blocks[i] = b
	end
	local headF = make("Frame", { Size = UDim2.fromScale(0.5, 0.07), Position = UDim2.fromScale(0.25, 0.97 - 0.0735), BackgroundColor3 = Color3.fromRGB(245, 205, 48), BorderSizePixel = 0, ZIndex = 8 }, col)
	corner(headF, 0.2)
	make("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }, headF)
	local pct = S.label(A, "0%", { Size = UDim2.fromScale(0.2, 0.1), Position = UDim2.fromScale(0.34, 0.45), color = C.white, z = 12 })

	local py, vel, g, holding, shown = 0.7, 0, 0, false, 0
	local function setHold(v) holding = v end
	local tap = tapArea(sh)
	tap.MouseButton1Down:Connect(function() setHold(true) end)
	tap.MouseButton1Up:Connect(function() setHold(false) end)
	tap.MouseLeave:Connect(function() setHold(false) end)
	key(sh, function(k, down) if k == Enum.KeyCode.Space then setHold(down) end end)
	table.insert(sh.conns, RunService.RenderStepped:Connect(function(dt)
		local el = os.clock() - sh.started
		sh.setTimer(1 - el / sh.info.duration)
		if el >= sh.info.duration then sh.finish(g) return end
		vel += (holding and -3.4 or 2.6) * dt
		vel = math.clamp(vel, -1.1, 1.1)
		py += vel * dt
		if py < 0 then py, vel = 0, 0 elseif py > 1 - BH then py, vel = 1 - BH, 0 end
		local ty = (1 - TH) * (0.5 + 0.38 * math.sin(el * 0.85) + 0.12 * math.sin(el * 2.3 + 1))
		zone.Position = UDim2.fromScale(0, ty)
		barf.Position = UDim2.fromScale(0.15, py)
		local ov = py < ty + TH and py + BH > ty
		if ov then g = math.min(1, g + dt / 12) else g = math.max(0, g - dt / 30) end
		barf.BackgroundColor3 = ov and Color3.fromRGB(150, 255, 170) or Color3.fromRGB(255, 160, 160)
		zone.BackgroundTransparency = ov and 0.15 or 0.4
		pct.Text = math.floor(g * 100) .. "%"
		local n = math.floor(g * N)
		if n ~= shown then
			if n > shown then
				for i = shown + 1, n do
					blocks[i].Visible = true
					S.pop(blocks[i], 1.5)
					S.burst(col, UDim2.fromScale(0.5, 0.97 - i * 0.0735), C.blue, 6, 50)
				end
			else
				for i = n + 1, shown do blocks[i].Visible = false end
			end
			shown = n
			headF.Position = UDim2.fromScale(0.25, 0.97 - (n + 1) * 0.0735)
		end
		if g >= 1 then sh.finish(1) end
	end))
end

------------------------------------------------------------------
-- BODYFAT : cardio, 3 couloirs, haies et bouteilles d'eau
------------------------------------------------------------------
GAMES.bodyfat = function(sh)
	local A = sh.arena
	local LANES = { 0.32, 0.5, 0.68 }
	for i = 1, 3 do
		make("Frame", { Size = UDim2.fromScale(0.17, 1), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(LANES[i], 0), BackgroundColor3 = Color3.fromRGB(46, 50, 62), BorderSizePixel = 0, ZIndex = 5 }, A)
	end
	local strips = {}
	for i = 1, 9 do
		local s = make("Frame", { Size = UDim2.fromScale(0.55, 0.02), Position = UDim2.fromScale(0.225, (i - 1) / 9), BackgroundColor3 = Color3.fromRGB(80, 220, 130), BackgroundTransparency = 0.6, BorderSizePixel = 0, ZIndex = 5 }, A)
		strips[i] = s
	end
	local runner = make("Frame", { Size = UDim2.fromScale(0.07, 0.2), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(LANES[2], 0.8), BackgroundTransparency = 1, ZIndex = 10 }, A)
	make("UIAspectRatioConstraint", { AspectRatio = 0.7 }, runner)
	local rh = make("Frame", { Size = UDim2.fromScale(0.7, 0.38), Position = UDim2.fromScale(0.15, 0), BackgroundColor3 = Color3.fromRGB(245, 205, 48), BorderSizePixel = 0, ZIndex = 10 }, runner)
	corner(rh, 0.2)
	local rb = make("Frame", { Size = UDim2.fromScale(1, 0.62), Position = UDim2.fromScale(0, 0.38), BackgroundColor3 = C.black, BorderSizePixel = 0, ZIndex = 10 }, runner)
	corner(rb, 0.15)
	local score = S.label(A, "0", { Size = UDim2.fromScale(0.14, 0.1), Position = UDim2.fromScale(0.84, 0.03), color = C.green, z = 12 })
	local fb = S.label(A, "", { Size = UDim2.fromScale(0.3, 0.12), Position = UDim2.fromScale(0.35, 0.3), color = C.yellow, z = 12 })
	local lane, pts, items, spawnT = 2, 0, {}, 0
	local function setLane(l)
		lane = math.clamp(l, 1, 3)
		tween(runner, 0.1, { Position = UDim2.fromScale(LANES[lane], 0.8) })
	end
	local function addPts(n, txt, col)
		pts += n
		score.Text = tostring(math.max(0, pts))
		S.pop(score, 1.4)
		fb.Text, fb.TextColor3 = txt, col
		S.pop(fb, 1.5)
		task.delay(0.5, function() if fb.Parent then fb.Text = "" end end)
	end
	local left = make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(0.5, 1), ZIndex = 20 }, A)
	local right = make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(0.5, 1), Position = UDim2.fromScale(0.5, 0), ZIndex = 20 }, A)
	left.Activated:Connect(function() setLane(lane - 1) end)
	right.Activated:Connect(function() setLane(lane + 1) end)
	key(sh, function(k, down)
		if not down then return end
		if k == Enum.KeyCode.A or k == Enum.KeyCode.Left then setLane(lane - 1) end
		if k == Enum.KeyCode.D or k == Enum.KeyCode.Right then setLane(lane + 1) end
	end)
	table.insert(sh.conns, RunService.RenderStepped:Connect(function(dt)
		local el = os.clock() - sh.started
		sh.setTimer(1 - el / sh.info.duration)
		if el >= sh.info.duration then sh.finish(pts / 40) return end
		local v = 0.75 + el * 0.012
		for i, s in ipairs(strips) do
			local y = (s.Position.Y.Scale + v * dt) % 1
			s.Position = UDim2.fromScale(0.225, y)
		end
		runner.Rotation = math.sin(el * 16) * 4
		spawnT -= dt
		if spawnT <= 0 then
			spawnT = 0.55
			local l = math.random(1, 3)
			local water = math.random() < 0.3
			local f = make("Frame", { Size = UDim2.fromScale(water and 0.05 or 0.14, water and 0.1 or 0.07), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(LANES[l], -0.1), BackgroundColor3 = water and Color3.fromRGB(80, 190, 255) or Color3.fromRGB(230, 60, 60), BorderSizePixel = 0, ZIndex = 8 }, A)
			corner(f, water and 0.3 or 0.15)
			make("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }, f)
			table.insert(items, { f = f, lane = l, water = water, y = -0.1, done = false })
		end
		for i = #items, 1, -1 do
			local it = items[i]
			it.y += v * dt
			it.f.Position = UDim2.fromScale(LANES[it.lane], it.y)
			if not it.done and math.abs(it.y - 0.8) < 0.08 and it.lane == lane then
				it.done = true
				if it.water then
					addPts(2, "+2 EAU", C.blue)
					S.burst(A, it.f.Position, C.blue, 14, 80)
					it.f:Destroy()
					table.remove(items, i)
					continue
				else
					addPts(-2, "AIE !", C.red)
					S.shake(sh.panel, 8, 0.25)
					S.flash(sh.panel, C.red, 0.7, 0.3)
					S.burst(A, it.f.Position, C.red, 12, 80)
				end
			end
			if it.y > 0.92 and not it.done then
				it.done = true
				if not it.water then addPts(1, "+1", C.green) end
			end
			if it.y > 1.15 then
				it.f:Destroy()
				table.remove(items, i)
			end
		end
	end))
end

------------------------------------------------------------------
-- API
------------------------------------------------------------------
function M.run(gui, station, onSubmit, onClose)
	local info = INFO[station]
	if not info or not GAMES[station] then
		onSubmit(-1)
		onClose()
		return
	end
	local sh = newShell(gui, info, onSubmit, onClose)
	GAMES[station](sh)
end

function M.showGain(stat, gain, value)
	local sh = M.current
	if not sh or not sh.gain or not sh.gain.Parent then return end
	if gain > 0 then
		sh.gain.Text = (stat == "Bodyfat" and "-" or "+") .. gain .. " " .. string.upper(stat) .. "  (" .. value .. "/100)"
	else
		sh.gain.Text = "Pas de gain... reessaie !"
	end
	S.pop(sh.gain, 1.5)
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">BattleUI</string><ProtectedString name="Source"><![CDATA[-- BattleUI : ModuleScript (enfant de MogClient) - menu, HUD, animations du Mog Battle
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local S = require(script.Parent.Studs)
local C, make, tween = S.C, S.make, S.tween

local M = {}
M.active = false
M.onActive = nil
local gui, remotes
local menu, hud, invitePanel
local state = {}

local MOVE_INFO = {
	FLEX = { color = C.orange, sub = "FRAME + BODYFAT - bat STARE" },
	STARE = { color = C.pink, sub = "FACE - bat TOWER" },
	TOWER = { color = C.blue, sub = "HEIGHT - bat FLEX" },
}
local MOVE_ORDER = { "FLEX", "STARE", "TOWER" }

------------------------------------------------------------------
-- CAMERA / FX 3D
------------------------------------------------------------------
local function camOn()
	local cam = Workspace.CurrentCamera
	state.shakeMag = 0
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 58
	state.camConn = RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local base = CFrame.lookAt(Vector3.new(math.sin(t * 0.35) * 7, 9.5, 22), Vector3.new(0, 5.4, 0))
		local m = state.shakeMag or 0
		local off = CFrame.new()
		if m > 0.01 then off = CFrame.new((math.random() - 0.5) * m, (math.random() - 0.5) * m, 0) end
		cam.CFrame = base * off
		state.shakeMag = m * 0.9
	end)
end

local function camOff()
	if state.camConn then state.camConn:Disconnect() state.camConn = nil end
	local cam = Workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = 70
end

local function ring(color)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CastShadow = true, false, false, false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = Vector3.new(2, 0.4, 2)
	p.CFrame = CFrame.new(0, 1.7, 0)
	p.Parent = Workspace
	S.tween(p, 0.7, { Size = Vector3.new(34, 0.4, 34), Transparency = 1 })
	Debris:AddItem(p, 1)
end

------------------------------------------------------------------
-- MENU
------------------------------------------------------------------
local function closeMenu()
	if menu then
		local m = menu
		menu = nil
		local sc = m:FindFirstChildOfClass("UIScale")
		if sc then tween(sc, 0.2, { Scale = 0.3 }, Enum.EasingStyle.Back, Enum.EasingDirection.In) end
		task.delay(0.22, function() m:Destroy() end)
	end
end

function M.openMenu()
	if menu or state.id then return end
	menu = S.panel(gui, { Name = "BattleMenu", Size = UDim2.fromScale(0.44, 0.7), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), cols = 18, rows = 18, z = 20 })
	make("UIAspectRatioConstraint", { AspectRatio = 0.95 }, menu)
	local sc = make("UIScale", { Scale = 0.4 }, menu)
	tween(sc, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	S.title(menu, "MOG BATTLE", UDim2.fromScale(0.74, 0.14), UDim2.fromScale(0.04, 0.03), C.purple)
	S.label(menu, "Choisis ton adversaire", { Size = UDim2.fromScale(0.8, 0.05), Position = UDim2.fromScale(0.1, 0.2), font = Enum.Font.GothamBold, stroke = false, z = 4 })
	local x = S.button(menu, "X", { Size = UDim2.fromScale(0.1, 0.1), Position = UDim2.fromScale(0.86, 0.03), color = C.red, cols = 3, rows = 3, textW = 0.7, textH = 0.7, z = 6 })
	make("UIAspectRatioConstraint", { AspectRatio = 1 }, x)
	x.Activated:Connect(closeMenu)
	local T = S.TIERS
	local list = {
		{ "VS SUB-5", T[1].col, "AI", 1 }, { "VS MTN", T[3].col, "AI", 3 }, { "VS HTN", T[4].col, "AI", 4 },
		{ "VS CHAD", T[6].col, "AI", 6 }, { "VS JOUEUR PROCHE", Color3.fromRGB(120, 60, 210), "PVP", 0 },
	}
	for i, it in ipairs(list) do
		local b = S.button(menu, it[1], { Size = UDim2.fromScale(0.84, 0.115), Position = UDim2.fromScale(0.08, 0.27 + (i - 1) * 0.14), color = it[2]:Lerp(C.black, 0.25), cols = 14, rows = 3, z = 6 })
		b.Activated:Connect(function()
			remotes.BattleRequest:FireServer(it[3], it[4])
			closeMenu()
		end)
	end
end

------------------------------------------------------------------
-- HUD
------------------------------------------------------------------
local function hpColor(hp)
	if hp > 55 then return Color3.fromRGB(90, 230, 110) end
	if hp > 25 then return C.yellow end
	return C.red
end

local function makeCard(side, info)
	local f = S.panel(hud, { Size = UDim2.fromScale(0.34, 0.12), Position = UDim2.fromScale(side == 1 and 0.02 or 0.64, 0.03), cols = 16, rows = 3, z = 5 })
	local xa = side == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right
	S.label(f, info.name, { Size = UDim2.fromScale(0.6, 0.38), Position = UDim2.fromScale(side == 1 and 0.04 or 0.36, 0.06), xAlign = xa, z = 6 })
	S.label(f, "MOG " .. info.score, { Size = UDim2.fromScale(0.34, 0.3), Position = UDim2.fromScale(side == 1 and 0.64 or 0.02, 0.1), color = C.yellow, xAlign = side == 1 and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left, z = 6 })
	local back = make("Frame", { BackgroundColor3 = C.black, Size = UDim2.fromScale(0.92, 0.3), Position = UDim2.fromScale(0.04, 0.56), BorderSizePixel = 0, ZIndex = 6 }, f)
	make("UICorner", { CornerRadius = UDim.new(0.3, 0) }, back)
	local fill = make("Frame", {
		BackgroundColor3 = hpColor(100), Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, ZIndex = 7,
		AnchorPoint = side == 2 and Vector2.new(1, 0) or Vector2.zero, Position = side == 2 and UDim2.fromScale(1, 0) or UDim2.new(),
	}, back)
	make("UICorner", { CornerRadius = UDim.new(0.3, 0) }, fill)
	local txt = S.label(back, "100", { Size = UDim2.fromScale(0.3, 1), Position = UDim2.fromScale(0.35, 0), z = 8 })
	return { frame = f, fill = fill, txt = txt }
end

local function setHp(card, hp)
	tween(card.fill, 0.5, { Size = UDim2.fromScale(math.clamp(hp / 100, 0, 1), 1), BackgroundColor3 = hpColor(hp) })
	card.txt.Text = tostring(hp)
end

local function buildHud(d)
	hud = make("Frame", { Name = "BattleHUD", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5, Active = false }, gui)
	state.me = makeCard(1, d.me)
	state.opp = makeCard(2, d.opp)
	state.roundLbl = S.label(hud, "", { Size = UDim2.fromScale(0.2, 0.08), Position = UDim2.fromScale(0.4, 0.04), color = C.white, z = 6 })
	state.wait = S.label(hud, "", { Size = UDim2.fromScale(0.4, 0.06), Position = UDim2.fromScale(0.3, 0.7), color = C.white, font = Enum.Font.GothamBold, z = 6 })
end

local function clearHud()
	if hud then hud:Destroy() hud = nil end
	state.me, state.opp = nil, nil
end

------------------------------------------------------------------
-- TOUR : choix du coup puis timing
------------------------------------------------------------------
local function lockMove(move, timing)
	if state.locked then return end
	state.locked = true
	remotes.BattleMove:FireServer(state.id, move, timing)
	if state.wait then state.wait.Text = "En attente de l'adversaire..." end
end

local function timingMeter(move)
	local holder = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(0.5, 0.2), Position = UDim2.fromScale(0.25, 0.68), ZIndex = 30 }, hud)
	S.label(holder, move .. " - TIMING !", { Size = UDim2.fromScale(1, 0.38), color = MOVE_INFO[move].color, z = 31 })
	local bar = S.panel(holder, { Size = UDim2.fromScale(1, 0.4), Position = UDim2.fromScale(0, 0.45), color = C.panel, z = 31, stroke = 3 })
	local sweet = make("Frame", { Size = UDim2.fromScale(0.3, 1), Position = UDim2.fromScale(0.35, 0), BackgroundColor3 = Color3.fromRGB(70, 200, 110), BorderSizePixel = 0, ZIndex = 32 }, bar)
	make("Frame", { Size = UDim2.fromScale(0.1, 1), Position = UDim2.fromScale(0.45, 0), BackgroundColor3 = C.yellow, BorderSizePixel = 0, ZIndex = 33 }, bar)
	local cur = make("Frame", { Size = UDim2.fromScale(0.02, 1.4), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 35 }, bar)
	local btn = make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 29 }, hud)
	local pos, dir, t0, done = 0, 1, os.clock(), false
	local conns = {}
	local function finish()
		if done then return end
		done = true
		for _, c in ipairs(conns) do c:Disconnect() end
		btn:Destroy()
		local timing = math.clamp(1 - math.abs(pos - 0.5) * 1.6, 0, 1)
		local lbl = S.label(holder, timing > 0.88 and "PERFECT !" or (timing > 0.55 and "GOOD" or "FAIBLE"), { Size = UDim2.fromScale(1, 0.4), Position = UDim2.fromScale(0, 0.45), color = timing > 0.88 and C.yellow or (timing > 0.55 and C.green or C.red), z = 36 })
		S.pop(lbl, 1.6)
		S.burst(hud, UDim2.fromScale(0.5, 0.76), timing > 0.55 and C.yellow or C.red, 16, 110)
		S.sfx("ping")
		lockMove(move, timing)
		task.delay(0.7, function() holder:Destroy() end)
	end
	table.insert(conns, RunService.RenderStepped:Connect(function(dt)
		pos += dir * 1.7 * dt
		if pos > 1 then pos, dir = 1, -1 elseif pos < 0 then pos, dir = 0, 1 end
		cur.Position = UDim2.fromScale(pos, 0.5)
		sweet.BackgroundTransparency = 0.1 + 0.15 * math.sin(os.clock() * 10)
		if os.clock() - t0 > 2.2 then finish() end
	end))
	table.insert(conns, UIS.InputBegan:Connect(function(i)
		if i.KeyCode == Enum.KeyCode.Space then finish() end
	end))
	btn.Activated:Connect(finish)
end

local function startRound(round, time)
	if not hud then return end
	state.locked = false
	state.round = round
	state.roundLbl.Text = "ROUND " .. round
	S.pop(state.roundLbl, 1.6)
	state.wait.Text = ""
	local banner = S.stamp(hud, "ROUND " .. round, C.white, UDim2.fromScale(0.5, 0.18), UDim2.fromScale(0.5, 0.4))
	task.delay(0.9, function() tween(banner, 0.3, { TextTransparency = 1 }) task.delay(0.3, function() banner:Destroy() end) end)
	local moves = make("Frame", { Name = "Moves", BackgroundTransparency = 1, Size = UDim2.fromScale(0.64, 0.22), Position = UDim2.fromScale(0.18, 1.05), ZIndex = 20 }, hud)
	tween(moves, 0.45, { Position = UDim2.fromScale(0.18, 0.74) }, Enum.EasingStyle.Back)
	local cd = make("Frame", { BackgroundColor3 = C.white, Size = UDim2.fromScale(1, 0.05), Position = UDim2.fromScale(0, -0.09), BorderSizePixel = 0, ZIndex = 21 }, moves)
	tween(cd, time, { Size = UDim2.fromScale(0, 0.05), BackgroundColor3 = C.red }, Enum.EasingStyle.Linear)
	for i, mv in ipairs(MOVE_ORDER) do
		local b = S.button(moves, mv, { Size = UDim2.fromScale(0.31, 1), Position = UDim2.fromScale((i - 1) * 0.345, 0), color = MOVE_INFO[mv].color, cols = 10, rows = 5, textW = 0.9, textH = 0.34, z = 21 })
		S.label(b, MOVE_INFO[mv].sub, { Size = UDim2.fromScale(0.9, 0.14), Position = UDim2.fromScale(0.05, 0.74), font = Enum.Font.GothamBold, stroke = false, z = 4 })
		b.Activated:Connect(function()
			if state.locked or state.picking then return end
			state.picking = true
			tween(moves, 0.25, { Position = UDim2.fromScale(0.18, 1.1) })
			task.delay(0.3, function() moves:Destroy() end)
			S.shake(hud, 4, 0.2)
			timingMeter(mv)
			state.picking = false
		end)
	end
	state.moves = moves
end

------------------------------------------------------------------
-- REVELATION DU RESULTAT
------------------------------------------------------------------
local function moveCard(parent, x, who, d, tint)
	local f = S.panel(parent, { Size = UDim2.fromScale(0.27, 0.9), Position = UDim2.fromScale(x < 0.5 and -0.3 or 1.3, 0.05), AnchorPoint = Vector2.new(0.5, 0), cols = 10, rows = 7, color = MOVE_INFO[d.move].color:Lerp(C.black, 0.35), z = 41 })
	S.label(f, who, { Size = UDim2.fromScale(0.9, 0.16), Position = UDim2.fromScale(0.05, 0.04), font = Enum.Font.GothamBold, z = 43 })
	S.label(f, d.move, { Size = UDim2.fromScale(0.9, 0.34), Position = UDim2.fromScale(0.05, 0.22), color = C.white, z = 43 })
	local pw = S.label(f, "0", { Size = UDim2.fromScale(0.6, 0.26), Position = UDim2.fromScale(0.2, 0.58), color = C.yellow, z = 43 })
	S.label(f, "POWER", { Size = UDim2.fromScale(0.5, 0.1), Position = UDim2.fromScale(0.25, 0.86), font = Enum.Font.GothamBold, stroke = false, z = 43 })
	tween(f, 0.5, { Position = UDim2.fromScale(x, 0.05) }, Enum.EasingStyle.Back)
	task.spawn(function()
		task.wait(0.45)
		local t0 = os.clock()
		while os.clock() - t0 < 0.7 and pw.Parent do
			pw.Text = tostring(math.floor(d.power * (os.clock() - t0) / 0.7))
			task.wait()
		end
		if pw.Parent then pw.Text = tostring(d.power) S.pop(pw, 1.4) end
	end)
	return f
end

local function showResult(r)
	if not hud then return end
	if state.moves then state.moves:Destroy() state.moves = nil end
	state.wait.Text = ""
	local band = make("Frame", { BackgroundColor3 = C.black, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 0.38), Position = UDim2.fromScale(0, 0.3), ZIndex = 40, BorderSizePixel = 0 }, hud)
	tween(band, 0.25, { BackgroundTransparency = 0.3 })
	local cMe = moveCard(band, 0.2, "TOI", r.me)
	local cOpp = moveCard(band, 0.8, "ADVERSAIRE", r.opp)
	S.label(band, "VS", { Size = UDim2.fromScale(0.14, 0.4), Position = UDim2.fromScale(0.43, 0.3), color = C.white, z = 44 })
	task.wait(1.35)
	if r.triangle ~= "none" then
		local tag = S.stamp(band, "AVANTAGE !", C.yellow, UDim2.fromScale(0.3, 0.2), UDim2.fromScale(r.triangle == "me" and 0.2 or 0.8, 0.0))
		tag.Rotation = r.triangle == "me" and -8 or 8
		S.sfx("ping")
	end
	task.wait(0.55)
	ring(r.winner == "me" and Color3.fromRGB(80, 200, 255) or (r.winner == "opp" and Color3.fromRGB(255, 70, 90) or Color3.fromRGB(255, 220, 90)))
	S.sfx("hit")
	state.shakeMag = 3.5
	if r.winner == "me" then
		S.flash(gui, Color3.fromRGB(80, 200, 255), 0.7, 0.4)
		local d = S.stamp(hud, "-" .. r.damage, C.red, UDim2.fromScale(0.18, 0.14), UDim2.fromScale(0.8, 0.2))
		S.burst(hud, UDim2.fromScale(0.8, 0.09), C.red, 18, 120)
		S.shake(state.opp.frame, 10, 0.4)
		task.delay(1.2, function() d:Destroy() end)
	elseif r.winner == "opp" then
		S.flash(gui, Color3.fromRGB(255, 60, 70), 0.6, 0.45)
		local d = S.stamp(hud, "-" .. r.damage, C.red, UDim2.fromScale(0.18, 0.14), UDim2.fromScale(0.2, 0.2))
		S.burst(hud, UDim2.fromScale(0.2, 0.09), C.red, 18, 120)
		S.shake(state.me.frame, 10, 0.4)
		state.shakeMag = 5
		task.delay(1.2, function() d:Destroy() end)
	else
		local d = S.stamp(hud, "CLASH !", C.yellow, UDim2.fromScale(0.3, 0.14), UDim2.fromScale(0.5, 0.22))
		task.delay(1.2, function() d:Destroy() end)
	end
	setHp(state.me, r.me.hp)
	setHp(state.opp, r.opp.hp)
	task.wait(1.4)
	tween(band, 0.25, { BackgroundTransparency = 1 })
	band:Destroy()
end

local function showEnd(d)
	if not hud then return end
	if state.moves then state.moves:Destroy() state.moves = nil end
	local win = d.result == "win"
	local txt = win and "YOU MOGGED !" or "GOT MOGGED..."
	local col = win and C.yellow or C.red
	S.flash(gui, col, 0.5, 0.6)
	local st = S.stamp(hud, txt, col, UDim2.fromScale(0.6, 0.22), UDim2.fromScale(0.5, 0.38))
	st.ZIndex = 60
	S.sfx(win and "ping" or "ko")
	if win then
		S.confetti(hud, 80)
		if d.reward ~= "" then
			local rw = S.label(hud, d.reward, { Size = UDim2.fromScale(0.4, 0.1), Position = UDim2.fromScale(0.3, 0.52), color = C.green, z = 60 })
			S.pop(rw, 1.6)
		end
	end
	state.shakeMag = win and 2 or 6
end

------------------------------------------------------------------
-- INVITATION PVP
------------------------------------------------------------------
local function showInvite(name, id)
	if invitePanel then invitePanel:Destroy() end
	invitePanel = S.panel(gui, { Name = "Invite", Size = UDim2.fromScale(0.34, 0.2), Position = UDim2.fromScale(0.5, -0.3), AnchorPoint = Vector2.new(0.5, 0), cols = 14, rows = 6, z = 25 })
	local p = invitePanel
	tween(p, 0.45, { Position = UDim2.fromScale(0.5, 0.04) }, Enum.EasingStyle.Back)
	S.label(p, name .. " te defie !", { Size = UDim2.fromScale(0.92, 0.3), Position = UDim2.fromScale(0.04, 0.07), z = 26 })
	local ok = S.button(p, "ACCEPTER", { Size = UDim2.fromScale(0.44, 0.36), Position = UDim2.fromScale(0.04, 0.52), color = Color3.fromRGB(40, 150, 70), cols = 6, rows = 3, z = 27 })
	local no = S.button(p, "REFUSER", { Size = UDim2.fromScale(0.44, 0.36), Position = UDim2.fromScale(0.52, 0.52), color = C.red, cols = 6, rows = 3, z = 27 })
	local function reply(a)
		remotes.BattleInviteReply:FireServer(id, a)
		if p.Parent then
			tween(p, 0.3, { Position = UDim2.fromScale(0.5, -0.3) })
			task.delay(0.35, function() p:Destroy() end)
		end
	end
	ok.Activated:Connect(function() reply(true) end)
	no.Activated:Connect(function() reply(false) end)
	task.delay(12, function() if p.Parent then reply(false) end end)
end

------------------------------------------------------------------
-- INIT
------------------------------------------------------------------
function M.init(g, rem)
	gui, remotes = g, rem
	remotes.BattleInvite.OnClientEvent:Connect(showInvite)
	remotes.BattleState.OnClientEvent:Connect(function(event, d)
		if event == "menu" then
			M.openMenu()
		elseif event == "start" then
			closeMenu()
			clearHud()
			state.id = d.id
			M.active = true
			if M.onActive then M.onActive(true) end
			buildHud(d)
			camOn()
			S.flash(gui, Color3.new(0, 0, 0), 0, 0.01)
			local vs = S.stamp(hud, d.me.name .. "  VS  " .. d.opp.name, C.white, UDim2.fromScale(0.8, 0.16), UDim2.fromScale(0.5, 0.45))
			S.burst(hud, UDim2.fromScale(0.5, 0.45), C.purple, 30, 220)
			task.delay(2.6, function() if vs.Parent then tween(vs, 0.4, { TextTransparency = 1 }) task.delay(0.4, function() vs:Destroy() end) end end)
		elseif event == "round" then
			task.spawn(startRound, d.round, d.time)
		elseif event == "result" then
			task.spawn(showResult, d)
		elseif event == "end" then
			task.spawn(function()
				showEnd(d)
				task.wait(4.6)
				clearHud()
				camOff()
				state.id = nil
				M.active = false
				if M.onActive then M.onActive(false) end
			end)
		end
	end)
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[-- Tutorial : ModuleScript (enfant de MogClient) - cinematique d'introduction + fiche des niveaux
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local S = require(script.Parent.Studs)
local C, make, tween = S.C, S.make, S.tween

local M = {}
M.running = false

local function corner(o, r) make("UICorner", { CornerRadius = UDim.new(r or 0.2, 0) }, o) end

------------------------------------------------------------------
-- FICHE DES NIVEAUX (SUB-5 -> CHAD)
------------------------------------------------------------------
function M.buildTierCard(parent, pos, size, animate)
	local card = S.panel(parent, { Name = "TierCard", Size = size, Position = pos, cols = 16, rows = 20, z = 110 })
	S.title(card, "NIVEAUX", UDim2.fromScale(0.7, 0.11), UDim2.fromScale(0.15, 0.02), C.yellow)
	for i, t in ipairs(S.TIERS) do
		local y = 0.16 + (i - 1) * 0.138
		local row = make("Frame", { BackgroundColor3 = C.panel, Size = UDim2.fromScale(0.92, 0.12), Position = UDim2.fromScale(0.04, y), BorderSizePixel = 0, ZIndex = 112 }, card)
		corner(row, 0.15)
		make("UIStroke", { Color = t.col, Thickness = 2 }, row)
		make("Frame", { BackgroundColor3 = t.col, Size = UDim2.fromScale(0.035, 0.8), Position = UDim2.fromScale(0.02, 0.1), BorderSizePixel = 0, ZIndex = 113 }, row)
		S.label(row, t.name, { Size = UDim2.fromScale(0.45, 0.5), Position = UDim2.fromScale(0.08, 0.06), color = t.col, xAlign = Enum.TextXAlignment.Left, z = 114 })
		S.label(row, "RARETE " .. t.rarity, { Size = UDim2.fromScale(0.4, 0.4), Position = UDim2.fromScale(0.57, 0.08), color = C.white, font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Right, z = 114 })
		S.label(row, t.desc, { Size = UDim2.fromScale(0.88, 0.32), Position = UDim2.fromScale(0.08, 0.6), color = Color3.fromRGB(176, 180, 194), font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, stroke = false, z = 114 })
		if animate then
			row.Position = UDim2.fromScale(1.2, y)
			task.delay(0.4 + (i - 1) * 0.3, function()
				if row.Parent then
					tween(row, 0.5, { Position = UDim2.fromScale(0.04, y) }, Enum.EasingStyle.Back)
					S.sfx("ping")
				end
			end)
		end
	end
	return card
end

function M.showTiers(gui)
	if gui:FindFirstChild("TierPopup") then return end
	local pop = make("Frame", { Name = "TierPopup", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.fromScale(1, 1), ZIndex = 30, Active = true }, gui)
	local card = M.buildTierCard(pop, UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.42, 0.88), false)
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	make("UIAspectRatioConstraint", { AspectRatio = 0.82 }, card)
	local sc = make("UIScale", { Scale = 0.5 }, card)
	tween(sc, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	local x = S.button(card, "X", { Size = UDim2.fromScale(0.1, 0.08), Position = UDim2.fromScale(0.86, 0.02), color = C.red, cols = 3, rows = 3, textW = 0.7, textH = 0.7, z = 120 })
	make("UIAspectRatioConstraint", { AspectRatio = 1 }, x)
	x.Activated:Connect(function() pop:Destroy() end)
end

------------------------------------------------------------------
-- CINEMATIQUE
------------------------------------------------------------------
local function typeText(label, text, speed)
	local token = (label:GetAttribute("tt") or 0) + 1
	label:SetAttribute("tt", token)
	label.Text = text
	label.MaxVisibleGraphemes = 0
	local n = utf8.len(text) or #text
	task.spawn(function()
		for i = 1, n do
			if not label.Parent or label:GetAttribute("tt") ~= token then return end
			label.MaxVisibleGraphemes = i
			task.wait(speed or 0.03)
		end
	end)
end

local function orbit(c, r, h, a0, a1, ly)
	return function(a)
		local ang = a0 + (a1 - a0) * a
		return c + Vector3.new(math.sin(ang) * r, h, math.cos(ang) * r), c + Vector3.new(0, ly or 5, 0)
	end
end

local function line(p0, l0, p1, l1)
	return function(a) return p0:Lerp(p1, a), l0:Lerp(l1, a) end
end

local function buildShots(spawnPos)
	local T = S.TIERS
	return {
		{
			dur = 8.5, fov = { 74, 58 }, focus = 120, title = true,
			cap = "Bienvenue a MOG STREET. Ici, tout se joue sur une seule chose : le mog.",
			f = line(Vector3.new(0, 165, 205), Vector3.new(0, 10, 0), Vector3.new(0, 62, 132), Vector3.new(0, 8, 22)),
		},
		{
			dur = 8, fov = { 64, 56 }, focus = 70,
			cap = "Ton visage, ta carrure, ta taille, ton physique : chaque stat change vraiment ton apparence.",
			f = line(Vector3.new(0, 5, 112), Vector3.new(0, 9, 0), Vector3.new(0, 6.5, 50), Vector3.new(0, 9, -6)),
		},
		{
			dur = 7.5, fov = { 66, 54 }, focus = 38, chip = { "FRAME", Color3.fromRGB(214, 112, 48) },
			cap = "IRON GYM : souleve de la fonte pour gagner de la FRAME.",
			f = orbit(Vector3.new(-58, 5, -22), 34, 13, 0.2, 1.2, 6),
		},
		{
			dur = 7.5, fov = { 66, 54 }, focus = 38, chip = { "FACE", Color3.fromRGB(200, 92, 112) },
			cap = "FACE LAB : soigne ta peau, fais disparaitre les boutons, deviens beau.",
			f = orbit(Vector3.new(58, 5, -22), 34, 13, -1.2, -0.2, 6),
		},
		{
			dur = 7.5, fov = { 64, 54 }, focus = 38, chip = { "HEIGHT", Color3.fromRGB(70, 150, 200) },
			cap = "HEIGHT DOJO : etire-toi, grandis, et ton personnage prendra de la taille.",
			f = orbit(Vector3.new(-58, 5, 22), 34, 13, math.pi - 1.0, math.pi + 0.1, 6),
		},
		{
			dur = 7.5, fov = { 66, 54 }, focus = 38, chip = { "BODYFAT", Color3.fromRGB(80, 170, 110) },
			cap = "CARDIO CLUB : cours, esquive, et perds ton bodyfat pour afficher des abdos.",
			f = orbit(Vector3.new(58, 5, 22), 34, 13, math.pi + 1.0, math.pi - 0.1, 6),
		},
		{
			dur = 8, fov = { 68, 56 }, focus = 55,
			cap = "Au centre : l'arene. Defie des bots ou d'autres joueurs en Mog Battle.",
			f = orbit(Vector3.new(0, 4, 0), 40, 15, 0, 2.4, 6),
		},
		{
			dur = 11, fov = { 62, 54 }, focus = 75, tiers = true,
			cap = "Des bots de tous les niveaux se promenent en ville, du SUB-5 au CHAD. Plus ils sont forts, plus ils sont rares. Mog-les tous !",
			f = line(Vector3.new(0, 5, 78), Vector3.new(0, 7, 0), Vector3.new(0, 6, 64), Vector3.new(0, 7, 0)),
		},
		{
			dur = 11, fov = { 60, 52 }, focus = 22, buttons = true,
			cap = "Tes 3 boutons : STATS pour suivre ton evolution, BATTLE pour les duels, MAP pour te teleporter. A toi de monter jusqu'a CHAD !",
			f = function(a)
				return spawnPos + Vector3.new(0, 4.6 - 1.2 * a, 15 - 5 * a), spawnPos + Vector3.new(0, 3, 0)
			end,
		},
	}
end

function M.play(gui, ui, onDone)
	if M.running then return end
	M.running = true
	local player = Players.LocalPlayer
	local cam = Workspace.CurrentCamera
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local SHOTS = buildShots(hrp and hrp.Position or Vector3.new(0, 4, 118))
	local skipped = false

	local dof = make("DepthOfFieldEffect", { Name = "TutoDoF", FarIntensity = 0.3, NearIntensity = 0, FocusDistance = 60, InFocusRadius = 30 }, Lighting)
	local cc = make("ColorCorrectionEffect", { Name = "TutoCC", Contrast = 0.1, Saturation = 0.1, TintColor = Color3.fromRGB(255, 244, 230) }, Lighting)
	local blur = make("BlurEffect", { Name = "TutoBlur", Size = 18 }, Lighting)

	local root = make("Frame", { Name = "Cinematic", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 100, Active = true }, gui)
	local barT = make("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 0.12), Position = UDim2.fromScale(0, -0.12), BorderSizePixel = 0, ZIndex = 3 }, root)
	local barB = make("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 0.12), Position = UDim2.fromScale(0, 1), BorderSizePixel = 0, ZIndex = 3 }, root)
	tween(barT, 0.9, { Position = UDim2.fromScale(0, 0) })
	tween(barB, 0.9, { Position = UDim2.fromScale(0, 0.88) })
	local chapter = S.label(root, "", { Size = UDim2.fromScale(0.3, 0.05), Position = UDim2.fromScale(0.03, 0.035), color = Color3.fromRGB(210, 212, 224), font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, z = 6 })
	local skipBtn = S.button(root, "PASSER", { Size = UDim2.fromScale(0.12, 0.06), Position = UDim2.fromScale(0.85, 0.03), color = C.brick, cols = 6, rows = 2, z = 8 })
	skipBtn.Activated:Connect(function() skipped = true end)
	local cap = S.panel(root, { Size = UDim2.fromScale(0.64, 0.14), Position = UDim2.fromScale(0.18, 0.745), cols = 30, rows = 5, color = C.panel, z = 5 })
	S.label(cap, "NARRATEUR", { Size = UDim2.fromScale(0.2, 0.2), Position = UDim2.fromScale(0.03, 0.06), color = C.yellow, font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, z = 7 })
	local capLbl = S.label(cap, "", { Size = UDim2.fromScale(0.94, 0.6), Position = UDim2.fromScale(0.03, 0.3), font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, stroke = false, z = 7 })
	capLbl.TextWrapped = true
	local fade = make("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 1), ZIndex = 50, BorderSizePixel = 0 }, root)

	local conns, extras = {}, {}
	local chip

	local function cleanup()
		for _, c in ipairs(conns) do c:Disconnect() end
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
		if hum then cam.CameraSubject = hum end
		dof:Destroy()
		cc:Destroy()
		blur:Destroy()
		root:Destroy()
		if ui.side then ui.side.Visible = false end
		for _, o in ipairs(extras) do if o.Parent then o:Destroy() end end
	end

	local ok, err = pcall(function()
		cam.CameraType = Enum.CameraType.Scriptable
		task.wait(0.4)
		for i, shot in ipairs(SHOTS) do
			if skipped then break end
			chapter.Text = string.format("%02d / %02d   MOG STREET", i, #SHOTS)
			typeText(capLbl, shot.cap, 0.032)
			if chip then chip:Destroy() chip = nil end
			if shot.chip then
				chip = S.panel(root, { Size = UDim2.fromScale(0.2, 0.09), Position = UDim2.fromScale(-0.3, 0.16), cols = 10, rows = 3, color = C.panel, z = 6 })
				S.label(chip, shot.chip[1], { Size = UDim2.fromScale(0.86, 0.6), Position = UDim2.fromScale(0.07, 0.2), color = shot.chip[2], z = 8 })
				tween(chip, 0.6, { Position = UDim2.fromScale(0.03, 0.16) }, Enum.EasingStyle.Back)
			end
			if shot.title then
				local grp = make("CanvasGroup", { BackgroundTransparency = 1, Size = UDim2.fromScale(0.8, 0.4), Position = UDim2.fromScale(0.1, 0.22), ZIndex = 4, GroupTransparency = 1 }, root)
				S.title(grp, "MOG STREET", UDim2.fromScale(1, 0.62), UDim2.fromScale(0, 0), C.yellow)
				S.label(grp, "LA VILLE DES MOGGERS", { Size = UDim2.fromScale(0.6, 0.14), Position = UDim2.fromScale(0.2, 0.66), font = Enum.Font.GothamBold, z = 6 })
				task.delay(0.8, function() if grp.Parent then tween(grp, 0.9, { GroupTransparency = 0 }) end end)
				task.delay(6.2, function() if grp.Parent then tween(grp, 0.9, { GroupTransparency = 1 }) task.delay(1, function() grp:Destroy() end) end end)
			end
			local card
			if shot.tiers then
				card = M.buildTierCard(root, UDim2.fromScale(0.62, 0.15), UDim2.fromScale(0.35, 0.58), true)
			end
			local marks = {}
			if shot.buttons and ui.side then
				ui.side.Visible = true
				task.wait()
				for _, e in ipairs(ui.buttons) do
					local b = e[1]
					local ap, asz = b.AbsolutePosition, b.AbsoluteSize
					local hl = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(asz.X + 14, asz.Y + 14), Position = UDim2.fromOffset(ap.X - 7, ap.Y - 7), ZIndex = 20 }, root)
					corner(hl, 0.15)
					local st = make("UIStroke", { Color = C.yellow, Thickness = 4 }, hl)
					local tx = S.label(root, e[2], { Size = UDim2.fromOffset(330, 36), Position = UDim2.fromOffset(ap.X - 346, ap.Y + asz.Y / 2 - 18), color = C.yellow, xAlign = Enum.TextXAlignment.Right, z = 20 })
					table.insert(marks, hl)
					table.insert(marks, tx)
					table.insert(conns, RunService.RenderStepped:Connect(function()
						st.Transparency = 0.5 + 0.5 * math.sin(os.clock() * 6)
					end))
				end
			end
			dof.FocusDistance = shot.focus or 50
			fade.BackgroundTransparency = 0
			tween(fade, 0.8, { BackgroundTransparency = 1 })
			tween(blur, 0.8, { Size = 0 })
			S.sfx("ping")
			local t0, outDone = os.clock(), false
			while not skipped do
				local a = (os.clock() - t0) / shot.dur
				if a >= 1 then break end
				local e = a * a * (3 - 2 * a)
				local pos, look = shot.f(e)
				local n = os.clock() * 0.7
				local sh = CFrame.new(math.noise(n, 1) * 0.18, math.noise(n, 5) * 0.18, 0) * CFrame.Angles(math.noise(n, 9) * 0.006, math.noise(n, 13) * 0.006, 0)
				cam.CFrame = CFrame.lookAt(pos, look) * sh
				cam.FieldOfView = shot.fov[1] + (shot.fov[2] - shot.fov[1]) * a
				if not outDone and a > 1 - 0.7 / shot.dur then
					outDone = true
					tween(fade, 0.65, { BackgroundTransparency = 0 })
					tween(blur, 0.65, { Size = 16 })
				end
				RunService.RenderStepped:Wait()
			end
			if card then card:Destroy() end
			for _, o in ipairs(marks) do o:Destroy() end
			if shot.buttons and ui.side then ui.side.Visible = false end
		end
		tween(barT, 0.6, { Position = UDim2.fromScale(0, -0.12) })
		tween(barB, 0.6, { Position = UDim2.fromScale(0, 1) })
		fade.BackgroundTransparency = 0
		task.wait(0.7)
	end)
	if not ok then warn("Tutorial: " .. tostring(err)) end
	cleanup()
	M.running = false
	if onDone then onDone(not skipped) end
end

return M
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>