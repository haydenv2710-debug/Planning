-- Script a placer dans ServerScriptService
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local DS = game:GetService("DataStoreService")
local PPS = game:GetService("ProximityPromptService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local HttpService = game:GetService("HttpService")
local Config = require(RS:WaitForChild("MogConfig"))
local FaceShared = require(RS:WaitForChild("FaceShared"))

local remotes = Instance.new("Folder")
remotes.Name = "MogRemotes"
remotes.Parent = RS
local R = {}
for _, n in ipairs({ "Toast", "OpenStation", "SubmitStation", "StationResult", "BattleRequest", "BattleInvite", "BattleInviteReply", "BattleState", "BattleMove", "TeleportTo", "Announce", "Tutorial", "TutorialDone" }) do
	local r = Instance.new("RemoteEvent")
	r.Name = n
	r.Parent = remotes
	R[n] = r
end

local store = DS:GetDataStore("MogData_v2")
local function START_DATA()
	return {
		Face = 10, Frame = 10, Height = 15, Bodyfat = 85, Wins = 0, Tut = 0, Coins = 0, Prestige = 0, Streak = 0, LastDay = 0, Claimed = 0,
		QDay = 0, QWeek = 0, Hair = 1, Title = "rookie", Zone = 1, Feat = FaceShared.defaults(), Quests = {}, Titles = { rookie = true },
		Badges = {}, Visited = { ["1"] = true }, Life = { Trained = 0, Battles = 0, Mogged = 0 },
	}
end
local data, cooldown, sessions, invites = {}, {}, {}, {}
local boardLabel

local function toast(plr, text, kind)
	R.Toast:FireClient(plr, text, kind or "info")
end

------------------------------------------------------------------
-- STATS / CLASSEMENT
------------------------------------------------------------------
local function mogScore(d)
	return (d.Face + d.Frame + d.Height + (100 - d.Bodyfat)) * 10
end
local function progress(d)
	return math.clamp(((d.Face - 10) + (d.Frame - 10) + (d.Height - 15) + (85 - d.Bodyfat)) / 345, 0, 1)
end

local TIERS = Config.TIERS
local function tierOf(d)
	local a = mogScore(d) / 40
	local t = 6
	if a < 20 then t = 1 elseif a < 36 then t = 2 elseif a < 52 then t = 3 elseif a < 68 then t = 4 elseif a < 84 then t = 5 end
	if t == 6 and (d.Prestige or 0) > 0 then return 6 + math.min(3, d.Prestige) end
	return t
end
local function announce(text, col, level)
	R.Announce:FireAllClients(text, col, level)
end

local function mult(k)
	local api = _G.MogAPI
	return (api and api.mult and api.mult[k]) or 1
end
local function hook(name, ...)
	local api = _G.MogAPI
	if api and api[name] then return api[name](...) end
end
local function boostOn(plr, k)
	return (plr:GetAttribute("Boost" .. k) or 0) > os.time()
end
local function addCoins(plr, n)
	local d = data[plr]
	if not d or n <= 0 then return 0 end
	n = math.floor(n * (1 + 0.1 * (d.Prestige or 0)) * mult("coins") * (boostOn(plr, "Coins") and 2 or 1) + 0.5)
	d.Coins += n
	plr:SetAttribute("Coins", d.Coins)
	hook("onTrack", plr, "coins", n)
	return n
end

local function pushAttrs(plr)
	local d = data[plr]
	if not d then return end
	for _, k in ipairs({ "Face", "Frame", "Height", "Bodyfat", "Wins" }) do
		plr:SetAttribute(k, d[k])
	end
	plr:SetAttribute("MogScore", mogScore(d))
	plr:SetAttribute("TierId", tierOf(d))
	plr:SetAttribute("Coins", d.Coins)
	plr:SetAttribute("Prestige", d.Prestige)
	plr:SetAttribute("Level", math.floor(mogScore(d) / 40))
	plr:SetAttribute("Hair", d.Hair)
	plr:SetAttribute("TitleId", d.Title)
	plr:SetAttribute("FeatJSON", HttpService:JSONEncode(d.Feat))
	plr:SetAttribute("QuestJSON", HttpService:JSONEncode(d.Quests))
	plr:SetAttribute("TitlesJSON", HttpService:JSONEncode(d.Titles))
	plr:SetAttribute("BadgesJSON", HttpService:JSONEncode(d.Badges))
	local ls = plr:FindFirstChild("leaderstats")
	if ls then
		ls.MogScore.Value = mogScore(d)
		ls.Wins.Value = d.Wins
	end
end

local function updateRanks()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if data[p] then table.insert(list, p) end
	end
	table.sort(list, function(a, b) return mogScore(data[a]) > mogScore(data[b]) end)
	local lines = {}
	for i, p in ipairs(list) do
		p:SetAttribute("Rank", i)
		if i <= 8 then
			table.insert(lines, string.format("%d. %s  -  %d", i, p.DisplayName, mogScore(data[p])))
		end
	end
	if boardLabel then boardLabel.Text = table.concat(lines, "\n") end
end

------------------------------------------------------------------
-- APPARENCE : le skin evolue avec les stats
------------------------------------------------------------------
local SKIN_SICK, SKIN_OK = Color3.fromRGB(165, 175, 115), Color3.fromRGB(226, 176, 138)

local function addTag(char, text, sub, col)
	local head = char:FindFirstChild("Head")
	if not head then return end
	local old = head:FindFirstChild("MogTag")
	if old then old:Destroy() end
	local bb = Instance.new("BillboardGui")
	bb.Name = "MogTag"
	bb.Size = UDim2.fromOffset(160, sub and 52 or 28)
	bb.StudsOffset = Vector3.new(0, sub and 3.4 or 3.0, 0)
	bb.LightInfluence = 0
	bb.MaxDistance = 110
	bb.Parent = head
	local function lbl(txt, sz, pos, c, font)
		local t = Instance.new("TextLabel")
		t.Size, t.Position = sz, pos
		t.BackgroundTransparency = 1
		t.Text = txt
		t.TextScaled = true
		t.Font = font
		t.TextColor3 = c
		t.Parent = bb
		local st = Instance.new("UIStroke")
		st.Thickness = 2
		st.Parent = t
	end
	if sub then
		lbl(text, UDim2.fromScale(1, 0.6), UDim2.new(), col, Enum.Font.GothamBlack)
		lbl(sub, UDim2.fromScale(1, 0.38), UDim2.fromScale(0, 0.62), Color3.new(1, 1, 1), Enum.Font.GothamBold)
	else
		lbl(text, UDim2.fromScale(1, 1), UDim2.new(), col, Enum.Font.GothamBlack)
	end
end

local function skinOf(d)
	local sk = (d.Feat and d.Feat.Skin) or 0
	return SKIN_SICK:Lerp(SKIN_OK, math.clamp(progress(d) * 1.4 + 0.04 * sk, 0, 1))
end

local function featFromFace(f)
	local n = math.clamp(math.floor(f / 18), 0, 5)
	local t = FaceShared.defaults()
	for k in pairs(t) do t[k] = n end
	return t
end

local function hairPieces(add, head, hs, style, f, hair, rng)
	if style == 1 then
		if f < 25 then
			for _ = 1, 3 do
				add(head, Vector3.new(hs.X * 0.18, hs.Y * 0.2, hs.Z * 0.18), CFrame.new(rng:NextNumber(-0.3, 0.3) * hs.X, hs.Y * 0.52, rng:NextNumber(-0.2, 0.2) * hs.Z), hair:Lerp(Color3.fromRGB(130, 120, 100), 0.4))
			end
		else
			add(head, Vector3.new(hs.X * 1.02, hs.Y * 0.14, hs.Z * 1.02), CFrame.new(0, hs.Y * 0.5, 0), hair)
		end
		return
	end
	add(head, Vector3.new(hs.X * 1.06, hs.Y * 0.3, hs.Z * 1.06), CFrame.new(0, hs.Y * 0.5, hs.Z * 0.02), hair)
	if style == 2 then
		add(head, Vector3.new(hs.X * 0.95, hs.Y * 0.22, hs.Z * 0.4), CFrame.new(0, hs.Y * 0.62, -hs.Z * 0.32) * CFrame.Angles(math.rad(-20), 0, 0), hair)
	elseif style == 3 then
		add(head, Vector3.new(hs.X * 0.9, hs.Y * 0.45, hs.Z * 0.55), CFrame.new(0, hs.Y * 0.78, -hs.Z * 0.12) * CFrame.Angles(math.rad(-10), 0, 0), hair)
	elseif style == 4 then
		add(head, Vector3.new(hs.X * 1.05, hs.Y * 0.95, hs.Z * 0.3), CFrame.new(0, -hs.Y * 0.05, hs.Z * 0.5), hair)
		for _, s in ipairs({ -1, 1 }) do add(head, Vector3.new(hs.X * 0.14, hs.Y * 0.8, hs.Z * 0.7), CFrame.new(s * hs.X * 0.5, -hs.Y * 0.05, hs.Z * 0.1), hair) end
	elseif style == 5 then
		for k = -2, 2 do
			add(head, Vector3.new(hs.X * 0.16, hs.Y * 0.5, hs.Z * 0.16), CFrame.new(k * hs.X * 0.22, hs.Y * 0.8, 0) * CFrame.Angles(0, 0, math.rad(-k * 12)), hair)
		end
	end
end

-- cosmetiques : cheveux, traits du visage (FaceLab), lunettes, chaine, muscles, ventre, acne, halo, ailes...
local function dress(char, d, opts)
	opts = opts or {}
	for _, c in ipairs(char:GetChildren()) do
		if c:GetAttribute("MogFx") then c:Destroy() end
	end
	local head, ut, lt = char:FindFirstChild("Head"), char:FindFirstChild("UpperTorso"), char:FindFirstChild("LowerTorso")
	if not (head and ut and lt) then return end
	local lua, rua = char:FindFirstChild("LeftUpperArm"), char:FindFirstChild("RightUpperArm")
	local rng = Random.new(opts.seed or 1)
	local p, f, fr, bf = progress(d), d.Face, d.Frame, d.Bodyfat
	local tier = tierOf(d)
	local tcol = TIERS[tier].col
	local black, gold = Color3.fromRGB(18, 16, 18), Color3.fromRGB(240, 196, 70)
	local function add(base, size, off, color, shape, mat)
		local x = Instance.new("Part")
		x.Name = "MogFx"
		x:SetAttribute("MogFx", true)
		x.Size = Vector3.new(math.max(size.X, 0.05), math.max(size.Y, 0.05), math.max(size.Z, 0.05))
		x.Shape = shape or Enum.PartType.Block
		x.Color = color
		x.Material = mat or Enum.Material.SmoothPlastic
		x.CanCollide, x.CanQuery, x.CanTouch, x.Massless, x.CastShadow = false, false, false, true, false
		x.CFrame = base.CFrame * off
		x.Parent = char
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = base, x
		w.Parent = x
		return x
	end
	local V = Vector3.new
	local hs = head.Size
	local skin = head.Color
	local feat = opts.feat or d.Feat or FaceShared.defaults()

	-- visage dessine par le Face Lab (on masque le visage par defaut)
	for _, c in ipairs(head:GetChildren()) do
		if c:IsA("Decal") then c.Transparency = 1 end
	end
	local hair = (f >= 90 or tier >= 6) and Color3.fromRGB(232, 196, 112) or Color3.fromRGB(32, 24, 20)
	for _, sp in ipairs(FaceShared.specs(feat, hs, skin, hair)) do
		add(head, sp.size, sp.off, sp.color, sp.shape, sp.mat)
	end
	hairPieces(add, head, hs, d.Hair or 1, f, hair, rng)
	if (feat.Harmony or 0) >= 5 then
		add(head, V(hs.X * 1.5, 0.05, hs.Z * 1.5), CFrame.new(0, hs.Y * 0.75, 0), Color3.fromRGB(255, 240, 200), nil, Enum.Material.Neon).Transparency = 0.6
	end
	-- cernes (peu de visage), double menton, acne
	if f < 35 then
		for _, sx in ipairs({ -1, 1 }) do add(head, V(hs.X * 0.2, hs.Y * 0.04, 0.05), CFrame.new(sx * hs.X * 0.2, -hs.Y * 0.01, -hs.Z * 0.53), Color3.fromRGB(96, 72, 96)) end
	end
	if bf > 60 and f < 55 then
		add(head, V(hs.X * 0.8, hs.Y * 0.5, hs.Z * 0.7), CFrame.new(0, -hs.Y * 0.5, -hs.Z * 0.1), skin, Enum.PartType.Ball)
	end
	local acne = math.max(0, math.floor((100 - f) / 100 * 14) - 3 * (feat.Skin or 0))
	for _ = 1, acne do
		add(head, Vector3.one * (0.16 * hs.X / 1.2), CFrame.new(rng:NextNumber(-0.4, 0.4) * hs.X, rng:NextNumber(-0.3, 0.35) * hs.Y, -hs.Z * 0.5), Color3.fromRGB(190, 55, 55), Enum.PartType.Ball)
	end
	-- lunettes de soleil puis yeux laser, halo, ailes
	if p >= 0.5 then
		add(head, V(hs.X * 0.92, hs.Y * 0.15, 0.1), CFrame.new(0, hs.Y * 0.08, -hs.Z * 0.55), black, nil, Enum.Material.Glass)
		if p >= 0.78 then add(head, V(hs.X * 0.8, hs.Y * 0.04, 0.12), CFrame.new(0, hs.Y * 0.08, -hs.Z * 0.58), tcol, nil, Enum.Material.Neon) end
	end
	if p >= 0.9 or tier >= 6 then
		local h = add(head, V(0.15, hs.X * 1.3, hs.X * 1.3), CFrame.new(0, hs.Y * 1.0, 0) * CFrame.Angles(0, 0, math.pi / 2), gold, Enum.PartType.Cylinder, Enum.Material.Neon)
		h.Transparency = 0.25
	end
	if tier >= 7 then
		for _, s in ipairs({ -1, 1 }) do
			for k = 1, 3 do
				local w = add(ut, V(0.3, 3.2 - k * 0.6, 0.25), CFrame.new(s * (0.9 + k * 0.55), 0.3 + k * 0.15, 0.9) * CFrame.Angles(0, s * math.rad(35), s * math.rad(-20 - k * 8)), tcol, nil, Enum.Material.Neon)
				w.Transparency = 0.25
			end
		end
	end
	-- chaine en or
	if p >= 0.4 then
		for k = -2, 2 do
			add(ut, V(0.2, 0.2, 0.12), CFrame.new(k * ut.Size.X * 0.1, ut.Size.Y * 0.42 - (2 - math.abs(k)) * ut.Size.Y * 0.08, -ut.Size.Z * 0.5), gold, nil, Enum.Material.Metal)
		end
		add(ut, V(0.45, 0.45, 0.14), CFrame.new(0, ut.Size.Y * 0.1, -ut.Size.Z * 0.52), gold, nil, Enum.Material.Metal)
	end
	-- muscles (Frame)
	local m = math.clamp((fr - 10) / 90, 0, 1)
	local us = ut.Size
	if m > 0.2 then
		for _, sx in ipairs({ -1, 1 }) do
			add(ut, V(us.X * 0.46, us.Y * 0.3, us.Z * (0.3 + 0.3 * m)), CFrame.new(sx * us.X * 0.24, us.Y * 0.1, -us.Z * 0.5), ut.Color)
		end
	end
	if m > 0.3 then
		for _, a in ipairs({ lua, rua }) do
			if a then add(a, Vector3.one * (a.Size.X * (1.1 + m * 0.9)), CFrame.new(0, a.Size.Y * 0.3, 0), a.Color, Enum.PartType.Ball) end
		end
	end
	if m > 0.55 then
		for _, sx in ipairs({ -1, 1 }) do
			add(ut, V(us.X * 0.3, us.Y * 0.16, us.Z * 0.9), CFrame.new(sx * us.X * 0.28, us.Y * 0.5, us.Z * 0.1) * CFrame.Angles(0, 0, sx * math.rad(-18)), ut.Color)
		end
	end
	if m > 0.4 and bf < 45 then
		local line = ut.Color:Lerp(black, 0.4)
		add(ut, V(us.X * 0.5, 0.06, 0.06), CFrame.new(0, -us.Y * 0.05, -us.Z * 0.5), line)
		add(ut, V(us.X * 0.5, 0.06, 0.06), CFrame.new(0, -us.Y * 0.3, -us.Z * 0.5), line)
		add(lt, V(us.X * 0.5, 0.06, 0.06), CFrame.new(0, lt.Size.Y * 0.1, -lt.Size.Z * 0.5), line)
		add(ut, V(0.06, us.Y * 0.55, 0.06), CFrame.new(0, -us.Y * 0.15, -us.Z * 0.5), line)
	end
	if bf > 50 then
		local sz = lt.Size.X * (0.75 + (bf - 50) / 60)
		add(lt, V(sz, sz * 0.9, sz * 0.8), CFrame.new(0, lt.Size.Y * 0.15, -lt.Size.Z * 0.35), lt.Color, Enum.PartType.Ball)
	end
	if bf > 70 then
		for _, sx in ipairs({ -1, 1 }) do
			add(ut, V(us.X * 0.34, us.X * 0.3, us.Z * 0.5), CFrame.new(sx * us.X * 0.22, us.Y * 0.05, -us.Z * 0.5), ut.Color, Enum.PartType.Ball)
		end
	end
end

local function applyLook(plr)
	local d, char = data[plr], plr.Character
	if not d or not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.RigType ~= Enum.HumanoidRigType.R15 then return end
	local f = d.Bodyfat / 100
	local function set(name, val)
		local v = hum:FindFirstChild(name)
		if v then v.Value = val end
	end
	set("BodyHeightScale", 0.78 + 0.5 * d.Height / 100)
	set("BodyWidthScale", 0.85 + 0.6 * f + 0.25 * d.Frame / 100)
	set("BodyDepthScale", 0.85 + 0.6 * f + 0.15 * d.Frame / 100)
	set("HeadScale", 1.3 - 0.3 * d.Face / 100 - 0.02 * (d.Feat.Structure or 0))
	local bc = char:FindFirstChildOfClass("BodyColors")
	if bc then
		local col = skinOf(d)
		bc.HeadColor3, bc.TorsoColor3 = col, col
		bc.LeftArmColor3, bc.RightArmColor3 = col, col
		bc.LeftLegColor3, bc.RightLegColor3 = col, col
	end
	local tier = tierOf(d)
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then
		local aura = hrp:FindFirstChild("MogAura")
		if tier >= 4 then
			if not aura then
				aura = Instance.new("ParticleEmitter")
				aura.Name = "MogAura"
				aura.LightEmission = 1
				aura.SpreadAngle = Vector2.new(180, 180)
				aura.Acceleration = Vector3.new(0, 4, 0)
				aura.Lifetime = NumberRange.new(1, 1.6)
				aura.Speed = NumberRange.new(2, 4)
				aura.Size = NumberSequence.new(0.5, 0)
				aura.Transparency = NumberSequence.new(0.2, 1)
				aura.Parent = hrp
			end
			aura.Color = ColorSequence.new(TIERS[tier].col)
			aura.Rate = 8 + tier * 6
		elseif aura then
			aura:Destroy()
		end
		local glow = hrp:FindFirstChild("MogGlow")
		if tier >= 5 then
			if not glow then
				glow = Instance.new("PointLight")
				glow.Name = "MogGlow"
				glow.Range = 12
				glow.Brightness = 0.9
				glow.Shadows = false
				glow.Parent = hrp
			end
			glow.Color = TIERS[tier].col
		elseif glow then
			glow:Destroy()
		end
	end
	local token = (plr:GetAttribute("LookToken") or 0) + 1
	plr:SetAttribute("LookToken", token)
	task.delay(0.6, function()
		if plr:GetAttribute("LookToken") ~= token or not char.Parent then return end
		dress(char, d, { seed = plr.UserId })
		addTag(char, TIERS[tier].name, Config.TITLES[d.Title], TIERS[tier].col)
		local hl = char:FindFirstChild("MogHL")
		if tier >= 5 then
			if not hl then
				hl = Instance.new("Highlight")
				hl.Name = "MogHL"
				hl.FillTransparency = 1
				hl.DepthMode = Enum.HighlightDepthMode.Occluded
				hl.Parent = char
			end
			hl.OutlineColor = TIERS[tier].col
		elseif hl then
			hl:Destroy()
		end
	end)
end

local function refreshAll(plr)
	local before = plr:GetAttribute("TierId")
	pushAttrs(plr)
	local after = plr:GetAttribute("TierId")
	if before and after and after > before then
		toast(plr, "NIVEAU SUPERIEUR : " .. TIERS[after].name .. " !", "good")
		if after >= 6 then hook("onAscend", plr, after) end
		if after >= 5 then announce(plr.DisplayName .. " est devenu " .. TIERS[after].name .. " !", TIERS[after].col, after) end
	end
	applyLook(plr)
	updateRanks()
end

local function bump(plr, stat, n)
	local d = data[plr]
	if not d or n <= 0 then return 0 end
	local before = d[stat]
	if stat == "Bodyfat" then
		d[stat] = math.max(5, d[stat] - n)
	else
		d[stat] = math.min(100, d[stat] + n)
	end
	return math.abs(d[stat] - before)
end

------------------------------------------------------------------
-- STATIONS : le client joue le mini-jeu, le serveur valide
------------------------------------------------------------------
local STATION = {
	face = { stat = "Face", minDur = 10 },
	frame = { stat = "Frame", minDur = 12 },
	height = { stat = "Height", minDur = 12 },
	bodyfat = { stat = "Bodyfat", minDur = 12 },
}

PPS.PromptTriggered:Connect(function(prompt, plr)
	local key = prompt:GetAttribute("Station")
	if not key or not data[plr] or plr:GetAttribute("Busy") then return end
	if key == "arena" then
		R.BattleState:FireClient(plr, "menu", {})
		return
	end
	if not STATION[key] then return end
	if cooldown[plr] and os.clock() - cooldown[plr] < 1.5 and not boostOn(plr, "Cd") and mult("cdFree") <= 1 then return end
	local token = math.random(100000, 999999)
	sessions[plr] = { station = key, t0 = os.clock(), token = token, zone = prompt:GetAttribute("Zone") or 1 }
	plr:SetAttribute("Busy", true)
	R.OpenStation:FireClient(plr, key, token)
	task.delay(120, function()
		if sessions[plr] and sessions[plr].token == token then
			sessions[plr] = nil
			plr:SetAttribute("Busy", nil)
		end
	end)
end)

R.SubmitStation.OnServerEvent:Connect(function(plr, token, score)
	local s = sessions[plr]
	if not s or s.token ~= token then return end
	sessions[plr] = nil
	plr:SetAttribute("Busy", nil)
	if type(score) ~= "number" or score ~= score or score < 0 then return end
	local cfg = STATION[s.station]
	if os.clock() - s.t0 < cfg.minDur then
		toast(plr, "Trop rapide !", "bad")
		return
	end
	score = math.clamp(score, 0, 1)
	local zone = s.zone or 1
	local gain = (score < 0.15) and 0 or math.clamp(math.floor(score * 4 + 0.5), 1, 4)
	if gain > 0 then
		gain = math.floor(gain * (1 + 0.25 * (zone - 1)) + 0.5)
		if boostOn(plr, "Train") then gain += 1 end
		gain = math.max(1, math.floor(gain * mult("stats") + 0.5))
	end
	local applied = bump(plr, cfg.stat, gain)
	local coins = addCoins(plr, math.floor(score * (20 + 12 * zone)))
	cooldown[plr] = os.clock()
	if data[plr] then data[plr].Life.Trained += 1 end
	hook("onTrack", plr, "train", 1)
	R.StationResult:FireClient(plr, cfg.stat, applied, data[plr][cfg.stat], coins)
	refreshAll(plr)
end)

------------------------------------------------------------------
-- MOG BATTLE
------------------------------------------------------------------
local ARENA_Y = 1.3
local PODIUM = { Vector3.new(-8, ARENA_Y + 3.2, 0), Vector3.new(8, ARENA_Y + 3.2, 0) }
local EXIT_POS = { Vector3.new(-6, 4, 30), Vector3.new(6, 4, 30) }
local battles, battleCount = {}, 0
local queue = {}
local STAT_NAME = { Face = "FACE", Frame = "FRAME", Height = "HEIGHT", Lean = "BODYFAT (secheresse)" }
local STAT_HINT = { Face = "Face Lab", Frame = "Iron Gym", Height = "Height Dojo", Lean = "Cardio Club" }
local ALLW = { Face = 0.25, Frame = 0.25, Height = 0.25, Lean = 0.25 }
local LUCK = 0.08 -- variation aleatoire maximale d'une manche (+-8 %), visible pour les joueurs
local BTYPES = {
	face = {
		name = "FACE BATTLE", desc = "Seule la FACE compte.",
		rounds = { { "JAWLINE", { Face = 1 } }, { "YEUX", { Face = 1 } }, { "PEAU", { Face = 1 } }, { "SYMETRIE", { Face = 1 } }, { "HARMONIE", { Face = 1 } } },
	},
	full = {
		name = "FULL MOG BATTLE", desc = "Frame, bodyfat, taille et visage.",
		rounds = { { "FRAME", { Frame = 1 } }, { "BODYFAT", { Lean = 1 } }, { "TAILLE", { Height = 1 } }, { "VISAGE", { Face = 1 } }, { "OVERALL", ALLW } },
	},
	style = {
		name = "STYLE BATTLE", desc = "Visage, silhouette, posture et charisme.",
		rounds = {
			{ "VISAGE", { Face = 1 } }, { "SILHOUETTE", { Lean = 0.6, Frame = 0.4 } }, { "POSTURE", { Height = 0.6, Frame = 0.4 } },
			{ "AURA", { Face = 0.5, Lean = 0.3, Height = 0.2 } }, { "CHARISME", { Face = 0.4, Lean = 0.3, Frame = 0.3 } },
		},
	},
	height = {
		name = "HEIGHT BATTLE", desc = "Seule la HEIGHT compte.",
		rounds = { { "TAILLE", { Height = 1 } }, { "PRESENCE", { Height = 0.8, Frame = 0.2 } }, { "POSTURE", { Height = 0.8, Lean = 0.2 } }, { "OMBRE", { Height = 1 } }, { "DOMINATION", { Height = 0.7, Frame = 0.3 } } },
	},
	overall = {
		name = "OVERALL BATTLE", desc = "Toutes les stats comptent a parts egales.",
		rounds = { { "FACE", { Face = 1 } }, { "FRAME", { Frame = 1 } }, { "HEIGHT", { Height = 1 } }, { "BODYFAT", { Lean = 1 } }, { "OVERALL", ALLW } },
	},
}

local function statOf(d, k)
	if k == "Lean" then return 100 - d.Bodyfat end
	return d[k]
end
local function catValue(d, w)
	local v = 0
	for k, x in pairs(w) do v += statOf(d, k) * x end
	return v
end
local function typeScore(bt, d)
	local tot = 0
	for _, r in ipairs(bt.rounds) do tot += catValue(d, r[2]) end
	return tot / #bt.rounds
end

local function buildDummy(cf, name)
	local m = Instance.new("Model")
	m.Name = "MogBot"
	local black, yellow = Color3.fromRGB(24, 24, 28), Color3.fromRGB(245, 205, 48)
	local function p(size, off, color, nm)
		local x = Instance.new("Part")
		x.Name = nm or "Part"
		x.Size = size
		x.Anchored = true
		x.CanCollide = false
		x.Color = color
		x.Material = Enum.Material.Plastic
		x.TopSurface = Enum.SurfaceType.Studs
		x.BottomSurface = Enum.SurfaceType.Smooth
		x.CFrame = cf * CFrame.new(off)
		x.Parent = m
		return x
	end
	local root = p(Vector3.new(2, 2, 1), Vector3.new(0, 0, 0), black, "Root")
	local head = p(Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 1.6, 0), yellow, "Head")
	p(Vector3.new(0.22, 0.3, 0.1), Vector3.new(-0.3, 1.75, -0.62), black)
	p(Vector3.new(0.22, 0.3, 0.1), Vector3.new(0.3, 1.75, -0.62), black)
	p(Vector3.new(0.5, 0.12, 0.1), Vector3.new(0, 1.3, -0.62), black)
	for i = -1, 1 do p(Vector3.new(0.4, 0.5, 0.4), Vector3.new(i * 0.4, 2.4, 0.1 * i), black) end
	for _, s in ipairs({ -1, 1 }) do
		p(Vector3.new(1, 1.4, 1), Vector3.new(s * 1.5, 0.3, 0), black)
		p(Vector3.new(1, 0.6, 1), Vector3.new(s * 1.5, -0.7, 0), yellow)
		p(Vector3.new(1, 2, 1), Vector3.new(s * 0.5, -2, 0), black)
		p(Vector3.new(1, 0.5, 1.2), Vector3.new(s * 0.5, -2.75, -0.1), Color3.fromRGB(235, 235, 235))
	end
	m.PrimaryPart = root
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(160, 36)
	bb.StudsOffset = Vector3.new(0, 2.4, 0)
	bb.AlwaysOnTop = true
	bb.Parent = head
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = name
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.TextColor3 = Color3.fromRGB(255, 90, 100)
	t.Parent = bb
	m.Parent = Workspace
	return m
end

local function slide(model, target, t)
	if not model or not model.Parent then return end
	local start = model:GetPivot()
	local n = math.max(1, math.floor(t * 30))
	for i = 1, n do
		if not model.Parent then return end
		model:PivotTo(start:Lerp(target, i / n))
		task.wait(1 / 30)
	end
end

local function lunge(f, dist, t)
	slide(f.model, f.home * CFrame.new(0, 0, -dist), t)
	slide(f.model, f.home, t * 1.6)
end

local function flash(model, color)
	if not model or not model.Parent then return end
	local h = Instance.new("Highlight")
	h.FillColor = color
	h.FillTransparency = 0.35
	h.OutlineColor = Color3.new(1, 1, 1)
	h.Parent = model
	Debris:AddItem(h, 0.55)
end

------------------------------------------------------------------
-- BOTS QUI SE PROMENENT EN VILLE (SUB-5 -> CHAD, plus c'est haut plus c'est rare)
------------------------------------------------------------------
local botsFolder = Instance.new("Folder")
botsFolder.Name = "MogBots"
botsFolder.Parent = Workspace
local bots, botSeq = {}, 0
local BOT_CAP = 12
local LANES = {
	{ "x", 3.5, -170, -34 }, { "x", -3.5, 34, 170 }, { "x", -3.5, -170, -34 }, { "x", 3.5, 34, 170 },
	{ "z", 3.5, -170, -34 }, { "z", -3.5, 34, 170 }, { "z", -3.5, -170, -34 }, { "z", 3.5, 34, 170 },
}
local SHIRTS = {
	Color3.fromRGB(70, 72, 84), Color3.fromRGB(128, 62, 60), Color3.fromRGB(62, 92, 124), Color3.fromRGB(80, 112, 84),
	Color3.fromRGB(112, 92, 62), Color3.fromRGB(40, 40, 48), Color3.fromRGB(190, 184, 170),
}
local PANTS = { Color3.fromRGB(40, 44, 60), Color3.fromRGB(30, 30, 34), Color3.fromRGB(86, 74, 60), Color3.fromRGB(60, 70, 96) }

local function lanePoint(l)
	local t = math.random(l[3] * 10, l[4] * 10) / 10
	if l[1] == "x" then return Vector3.new(t, 4, l[2]) end
	return Vector3.new(l[2], 4, t)
end

local function levelData(level)
	local t = TIERS[level]
	local base = math.random(t.lo, t.hi)
	local function v() return math.clamp(base + math.random(-6, 6), 3, 99) end
	return { Face = v(), Frame = v(), Height = v(), Bodyfat = 100 - v() }
end

local function rollLevel(minL)
	minL = minL or 1
	local total = 0
	for i, t in ipairs(TIERS) do
		if i >= minL and i <= 6 then total += t.w end
	end
	local r = math.random() * total
	for i, t in ipairs(TIERS) do
		if i >= minL and i <= 6 then
			r -= t.w
			if r <= 0 then return i end
		end
	end
	return math.clamp(minL, 1, 6)
end

local function countBots(z)
	local n = 0
	for _, b in pairs(bots) do
		if z == nil or (b.zone or 1) == z then n += 1 end
	end
	return n
end

local function zoneLanes(z)
	local c = Config.ZONES[z].center
	return {
		{ "x", c.Z + 32, c.X - 110, c.X - 40 }, { "x", c.Z - 32, c.X + 40, c.X + 110 },
		{ "z", c.X + 32, c.Z - 110, c.Z - 40 }, { "z", c.X - 32, c.Z + 40, c.Z + 110 },
	}
end

local function createBotModel(d)
	local model
	pcall(function()
		local desc = Instance.new("HumanoidDescription")
		local skin = skinOf(d)
		desc.HeadColor, desc.LeftArmColor, desc.RightArmColor = skin, skin, skin
		desc.TorsoColor = SHIRTS[math.random(1, #SHIRTS)]
		local pants = PANTS[math.random(1, #PANTS)]
		desc.LeftLegColor, desc.RightLegColor = pants, pants
		model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	return model
end

local function scaleRig(model, d)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local f = d.Bodyfat / 100
	local function set(nm, v)
		local o = hum:FindFirstChild(nm)
		if o then o.Value = v end
	end
	set("BodyHeightScale", 0.78 + 0.5 * d.Height / 100)
	set("BodyWidthScale", 0.85 + 0.6 * f + 0.25 * d.Frame / 100)
	set("BodyDepthScale", 0.85 + 0.6 * f + 0.15 * d.Frame / 100)
	set("HeadScale", 1.3 - 0.3 * d.Face / 100)
end

local function loadAnims(hum)
	local ok, idle, walk = pcall(function()
		local an = hum:FindFirstChildOfClass("Animator")
		if not an then
			an = Instance.new("Animator")
			an.Parent = hum
		end
		local function tr(id)
			local a = Instance.new("Animation")
			a.AnimationId = "rbxassetid://" .. id
			local t = an:LoadAnimation(a)
			t.Looped = true
			return t
		end
		return tr(507766666), tr(507777826)
	end)
	if ok then return idle, walk end
	return nil, nil
end

local function poof(pos, col)
	local a = Instance.new("Part")
	a.Anchored, a.CanCollide, a.CanQuery, a.Transparency, a.Size = true, false, false, 1, Vector3.one
	a.Position = pos
	a.Parent = Workspace
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(col)
	e.LightEmission = 1
	e.Speed = NumberRange.new(14, 26)
	e.Lifetime = NumberRange.new(0.6, 1)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new(1.4, 0)
	e.Rate = 0
	e.Parent = a
	e:Emit(60)
	Debris:AddItem(a, 2)
end

local function despawnBot(bot, withPoof)
	if not bot.alive then return end
	bot.alive = false
	bots[bot.id] = nil
	if withPoof and bot.root then poof(bot.root.Position, TIERS[bot.level].col) end
	if bot.model then bot.model:Destroy() end
end

local function releaseBot(bot)
	if not bot or not bot.alive then return end
	bot.busy = false
	if bot.kind == "rig" and bot.root then bot.root.Anchored = false end
	if bot.prompt then bot.prompt.Enabled = true end
end

local function setWalking(bot, on)
	if not (bot.walk and bot.idle) then return end
	if on then
		bot.idle:Stop(0.2)
		if not bot.walk.IsPlaying then bot.walk:Play(0.2) end
	else
		bot.walk:Stop(0.2)
		if not bot.idle.IsPlaying then bot.idle:Play(0.2) end
	end
end

local function glide(bot, target)
	local root = bot.root
	local t0 = os.clock()
	while bot.alive and not bot.busy and os.clock() - t0 < 40 do
		local pos = root.Position
		local flat = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
		if flat.Magnitude < 1.5 then break end
		local np = pos + flat.Unit * bot.speed * 0.1
		bot.model:PivotTo(CFrame.lookAt(np, np + flat.Unit))
		task.wait(0.1)
	end
end

local function runBot(bot)
	while bot.alive do
		if bot.busy then
			task.wait(0.5)
		else
			local target = lanePoint(bot.lane)
			setWalking(bot, true)
			if bot.kind == "rig" then
				local t0 = os.clock()
				while bot.alive and not bot.busy and os.clock() - t0 < 30 do
					local pos = bot.root.Position
					if Vector3.new(pos.X - target.X, 0, pos.Z - target.Z).Magnitude < 2.5 then break end
					bot.hum:MoveTo(target)
					task.wait(0.4)
				end
				if bot.alive then bot.hum:MoveTo(bot.root.Position) end
			else
				glide(bot, target)
			end
			setWalking(bot, false)
			if bot.alive and not bot.busy then task.wait(math.random(20, 60) / 10) end
			if bot.alive and not bot.busy and os.clock() > bot.expire then despawnBot(bot, true) end
		end
	end
end

local function spawnBot(level, silent, zoneId, opts)
	zoneId = zoneId or 1
	opts = opts or {}
	if not opts.force and countBots(zoneId) >= ((zoneId == 1) and BOT_CAP or 4) then return end
	botSeq += 1
	local id = botSeq
	local t = TIERS[level]
	local d = levelData(level)
	local lanes = (zoneId == 1) and LANES or zoneLanes(zoneId)
	local lane = lanes[math.random(1, #lanes)]
	local pos = lanePoint(lane)
	local bot = {
		id = id, level = level, d = d, alive = true, busy = false, tierName = opts.name or t.name, speed = t.speed,
		lane = lane, zone = zoneId, forceType = opts.forceType, tag = opts.tag,
		expire = os.clock() + (opts.life or ((level >= 5) and 300 or math.random(150, 300))),
	}
	local model = createBotModel(d)
	local hum, root
	if model then
		hum = model:FindFirstChildOfClass("Humanoid")
		root = model:FindFirstChild("HumanoidRootPart")
		if not hum or not root then
			model:Destroy()
			model = nil
		end
	end
	if model then
		bot.kind = "rig"
		model.Name = "Bot_" .. t.name
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.WalkSpeed = t.speed
		model:PivotTo(CFrame.new(pos))
		model.Parent = botsFolder
		scaleRig(model, d)
		if opts.giant then
			for _, nm in ipairs({ "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale" }) do
				local o = hum:FindFirstChild(nm)
				if o then o.Value *= 2 end
			end
			hum.WalkSpeed = t.speed * 0.7
		end
		pcall(function() root:SetNetworkOwner(nil) end)
		bot.idle, bot.walk = loadAnims(hum)
		if bot.idle then bot.idle:Play() end
	else
		bot.kind = "dummy"
		model = buildDummy(CFrame.new(pos.X, 3.3, pos.Z), t.name)
		model.Parent = botsFolder
		root = model.PrimaryPart
	end
	bot.model, bot.hum, bot.root = model, hum, root
	bots[id] = bot
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = "Defier en Mog Battle"
	pr.ObjectText = bot.tierName .. " - MOG " .. mogScore(d)
	pr.HoldDuration = 0.3
	pr.MaxActivationDistance = 12
	pr.RequiresLineOfSight = false
	pr:SetAttribute("BotId", id)
	pr.Parent = root
	bot.prompt = pr
	if level >= 5 then
		local e = Instance.new("ParticleEmitter")
		e.Color = ColorSequence.new(t.col)
		e.LightEmission = 1
		e.Rate = 14 + level * 3
		e.SpreadAngle = Vector2.new(180, 180)
		e.Speed = NumberRange.new(2, 4)
		e.Lifetime = NumberRange.new(1, 1.6)
		e.Size = NumberSequence.new(0.5, 0)
		e.Acceleration = Vector3.new(0, 4, 0)
		e.Parent = root
	end
	task.delay(0.7, function()
		if not bot.alive or not model.Parent then return end
		if bot.kind == "rig" then dress(model, d, { seed = id, feat = featFromFace(d.Face) }) end
		addTag(model, bot.tierName, "MOG " .. mogScore(d), t.col)
	end)
	if not silent and level >= 4 then
		local msgs = {
			[4] = "Un HTN se balade dans Mog Street...",
			[5] = "Un CHADLITE vient d'apparaitre dans Mog Street !",
			[6] = "UN CHAD A SPAWN ! Va le mog avant qu'il parte !",
		}
		announce(msgs[level], t.col, level)
	end
	task.spawn(runBot, bot)
end

task.spawn(function()
	task.wait(4)
	for _ = 1, 8 do
		task.spawn(spawnBot, rollLevel(), true)
		task.wait(0.4)
	end
	while true do
		task.wait(6)
		if countBots(1) < BOT_CAP and math.random() < 0.75 then
			task.spawn(spawnBot, rollLevel(), false)
		end
	end
end)

-- bots des autres zones : uniquement quand un joueur s'y trouve
task.spawn(function()
	while true do
		task.wait(8)
		for _, z in ipairs(Config.ZONES) do
			if z.id > 1 then
				local occupied = false
				for _, p in ipairs(Players:GetPlayers()) do
					if p:GetAttribute("Zone") == z.id then occupied = true end
				end
				if occupied then
					if countBots(z.id) < 4 then task.spawn(spawnBot, rollLevel(math.clamp(z.id - 2, 1, 6)), true, z.id) end
				else
					for _, b in pairs(bots) do
						if (b.zone or 1) == z.id then b.expire = math.min(b.expire, os.clock() + 20) end
					end
				end
			end
		end
	end
end)

local function fightAura(f)
	local part = f.model and (f.model:FindFirstChild("HumanoidRootPart") or f.model.PrimaryPart)
	if not part then return end
	local e = Instance.new("ParticleEmitter")
	e.Name = "FightAura"
	e.Color = ColorSequence.new(TIERS[tierOf(f.d)].col)
	e.LightEmission = 1
	e.Rate = 6 + (mogScore(f.d) / 40) * 0.5
	e.Lifetime = NumberRange.new(0.8, 1.3)
	e.Speed = NumberRange.new(3, 6)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new(0.7, 0)
	e.Transparency = NumberSequence.new(0.2, 1)
	e.Acceleration = Vector3.new(0, 6, 0)
	e.Parent = part
end

local function buildSummary(bt, log, fighters, idx, won)
	local me, opp = fighters[idx], fighters[3 - idx]
	local lines = {}
	local rw = 0
	for _, l in ipairs(log) do
		if l.win == idx then rw += 1 end
	end
	table.insert(lines, string.format("Manches gagnees : %d sur %d   |   PV restants : %d contre %d", rw, #log, me.hp, opp.hp))
	local keys = {}
	for _, r in ipairs(bt.rounds) do
		for k in pairs(r[2]) do keys[k] = true end
	end
	local bestK, bestD, worstK, worstD
	for k in pairs(keys) do
		local dd = statOf(me.d, k) - statOf(opp.d, k)
		if not bestD or dd > bestD then bestK, bestD = k, dd end
		if not worstD or dd < worstD then worstK, worstD = k, dd end
	end
	if won then
		if bestD > 0 then
			table.insert(lines, string.format("Victoire : ton %s (%d) depasse celui de l'adversaire (%d) de +%d.", STAT_NAME[bestK], statOf(me.d, bestK), statOf(opp.d, bestK), bestD))
		else
			table.insert(lines, "Stats tres proches : tu gagnes grace a tes meilleures manches et un peu de chance.")
		end
		if worstD < 0 then
			table.insert(lines, string.format("Point faible : ton %s (%d) est inferieur de %d. Entraine-toi a %s.", STAT_NAME[worstK], statOf(me.d, worstK), -worstD, STAT_HINT[worstK]))
		end
	else
		if worstD < 0 then
			table.insert(lines, string.format("Defaite : son %s (%d) depasse le tien (%d) de %d points.", STAT_NAME[worstK], statOf(opp.d, worstK), statOf(me.d, worstK), -worstD))
			table.insert(lines, "Conseil : entraine-toi a " .. STAT_HINT[worstK] .. " pour combler l'ecart.")
		else
			table.insert(lines, "Stats proches : la chance (+-" .. math.floor(LUCK * 100) .. "%) a fait la difference. Retente ta chance !")
		end
	end
	return lines
end

local function runBattle(f1, f2, isAI, btKey)
	btKey = BTYPES[btKey] and btKey or "overall"
	local bt = BTYPES[btKey]
	battleCount += 1
	local b = { id = battleCount, f = { f1, f2 } }
	battles[b.id] = b
	local fighters = b.f
	for _, f in ipairs(fighters) do
		if f.plr then
			local hrp = f.plr.Character and f.plr.Character:FindFirstChild("HumanoidRootPart")
			if not hrp or f.plr:GetAttribute("Busy") or not f.plr.Parent then
				battles[b.id] = nil
				if f2.botRef then releaseBot(f2.botRef) end
				return
			end
		end
	end
	for i, f in ipairs(fighters) do
		f.home = CFrame.lookAt(PODIUM[i], PODIUM[3 - i])
		f.hp = 100
		if f.plr then
			f.plr:SetAttribute("Busy", true)
			f.plr:SetAttribute("BattleId", b.id)
			queue[f.plr] = nil
			f.model = f.plr.Character
			f.ret = f.plr.Character.HumanoidRootPart.CFrame
			f.model:PivotTo(f.home)
			f.model.HumanoidRootPart.Anchored = true
		elseif f.botRef and f.botRef.alive then
			local clone = f.botRef.model:Clone()
			for _, x in ipairs(clone:GetDescendants()) do
				if x:IsA("ProximityPrompt") or x:IsA("BaseScript") then x:Destroy() end
			end
			clone.Name = "MogFighter"
			local cr = clone:FindFirstChild("HumanoidRootPart") or clone.PrimaryPart
			if cr then cr.Anchored = true end
			clone.Parent = Workspace
			clone:PivotTo(f.home)
			f.model = clone
		else
			local rig = createBotModel(f.d)
			local hrp = rig and rig:FindFirstChild("HumanoidRootPart")
			if rig and hrp then
				rig.Name = "MogFighter"
				hrp.Anchored = true
				rig:PivotTo(f.home)
				rig.Parent = Workspace
				scaleRig(rig, f.d)
				f.model = rig
				task.wait(0.7)
				dress(rig, f.d, { seed = 77 + i, feat = featFromFace(f.d.Face) })
				addTag(rig, f.name, nil, TIERS[f.diff or 2].col)
			else
				if rig then rig:Destroy() end
				f.model = buildDummy(f.home, f.name)
			end
		end
	end

	local function pushAll(event, make)
		for i, f in ipairs(fighters) do
			if f.plr and f.plr.Parent then R.BattleState:FireClient(f.plr, event, make(i)) end
		end
	end
	local rel = {}
	for _, r in ipairs(bt.rounds) do
		for k in pairs(r[2]) do rel[(k == "Lean") and "Bodyfat" or k] = true end
	end
	local function statBlock(f)
		return {
			name = f.name, tierId = tierOf(f.d), score = mogScore(f.d), hp = 100,
			stats = { Face = f.d.Face, Frame = f.d.Frame, Height = f.d.Height, Bodyfat = f.d.Bodyfat },
		}
	end
	pushAll("start", function(i)
		return { id = b.id, ai = isAI, type = bt.name, desc = bt.desc, rel = rel, rounds = #bt.rounds, me = statBlock(fighters[i]), opp = statBlock(fighters[3 - i]) }
	end)
	for _, f in ipairs(fighters) do fightAura(f) end
	task.wait(5.6)

	local log = {}
	for round, cat in ipairs(bt.rounds) do
		for _, f in ipairs(fighters) do
			if f.plr and not f.plr.Parent then f.left = true end
		end
		if f1.left or f2.left then break end
		pushAll("round", function() return { round = round, total = #bt.rounds, label = cat[1] } end)
		task.wait(1.5)
		-- calcul 100 % serveur : valeur des stats x chance bornee
		local v1, v2 = catValue(f1.d, cat[2]), catValue(f2.d, cat[2])
		local l1, l2 = (math.random() * 2 - 1) * LUCK, (math.random() * 2 - 1) * LUCK
		local p1, p2 = v1 * (1 + l1), v2 * (1 + l2)
		local win = (math.abs(p1 - p2) < 1) and 0 or ((p1 > p2) and 1 or 2)
		local dmg = 4
		if win ~= 0 then
			dmg = math.clamp(math.floor(8 + math.abs(p1 - p2) * 0.9), 6, 40)
			fighters[3 - win].hp = math.max(0, fighters[3 - win].hp - dmg)
		else
			f1.hp = math.max(0, f1.hp - 4)
			f2.hp = math.max(0, f2.hp - 4)
		end
		table.insert(log, { label = cat[1], win = win })
		pushAll("result", function(i)
			local me, opp = fighters[i], fighters[3 - i]
			local mv, ov = (i == 1) and v1 or v2, (i == 1) and v2 or v1
			local mp, op = (i == 1) and p1 or p2, (i == 1) and p2 or p1
			local ml, ol = (i == 1) and l1 or l2, (i == 1) and l2 or l1
			return {
				round = round, total = #bt.rounds, label = cat[1], damage = dmg,
				me = { value = math.floor(mv + 0.5), power = math.floor(mp + 0.5), luck = math.floor(ml * 100 + 0.5), hp = me.hp },
				opp = { value = math.floor(ov + 0.5), power = math.floor(op + 0.5), luck = math.floor(ol * 100 + 0.5), hp = opp.hp },
				winner = (win == 0) and "draw" or ((win == i) and "me" or "opp"),
			}
		end)
		task.wait(1.1)
		if win == 0 then
			task.spawn(lunge, f1, 2, 0.15)
			task.spawn(lunge, f2, 2, 0.15)
		else
			flash(fighters[3 - win].model, Color3.fromRGB(255, 60, 70))
			task.spawn(lunge, fighters[win], 3.5, 0.16)
			task.spawn(lunge, fighters[3 - win], -4, 0.14)
		end
		task.wait(3)
		if f1.hp <= 0 or f2.hp <= 0 then break end
	end

	-- vainqueur : PV, puis score du type de combat, puis tirage
	local winIdx
	if f1.left then
		winIdx = 2
	elseif f2.left then
		winIdx = 1
	elseif f1.hp ~= f2.hp then
		winIdx = (f1.hp > f2.hp) and 1 or 2
	else
		local s1, s2 = typeScore(bt, f1.d), typeScore(bt, f2.d)
		if s1 ~= s2 then winIdx = (s1 > s2) and 1 or 2 else winIdx = math.random(1, 2) end
	end
	-- animations de victoire / defaite
	local wf, lf = fighters[winIdx], fighters[3 - winIdx]
	task.spawn(function()
		for _ = 1, 2 do
			slide(wf.model, wf.home * CFrame.new(0, 3, 0), 0.18)
			slide(wf.model, wf.home, 0.18)
		end
	end)
	task.spawn(function()
		slide(lf.model, lf.home * CFrame.new(0, -1.4, 2) * CFrame.Angles(math.rad(-80), 0, 0), 0.4)
	end)
	poof(wf.home.Position + Vector3.new(0, 2, 0), TIERS[tierOf(wf.d)].col)
	for i, f in ipairs(fighters) do
		if f.plr and f.plr.Parent and data[f.plr] then
			local won = (i == winIdx)
			local reward = ""
			if won then
				data[f.plr].Wins += 1
				local lvl = f2.diff or tierOf(f2.d)
				local pool = ({ face = { "Face" }, height = { "Height" }, full = { "Frame", "Bodyfat", "Height", "Face" }, style = { "Face", "Bodyfat", "Frame" }, overall = { "Face", "Frame", "Height", "Bodyfat" } })[btKey]
				local pick = pool[math.random(1, #pool)]
				local got = bump(f.plr, pick, 2 + math.floor(lvl / 2))
				reward = "+" .. got .. " " .. string.upper(pick)
				local cn = addCoins(f.plr, f2.boss and (150 * (f2.zone or 1)) or (40 + lvl * 25))
				reward = reward .. "  +" .. cn .. " coins"
				data[f.plr].Life.Battles += 1
				if isAI then data[f.plr].Life.Mogged += 1 end
				hook("onTrack", f.plr, "win", 1, { tier = lvl, ai = isAI })
				hook("onBattleWin", f.plr, f2, isAI, btKey)
				if isAI and lvl >= 5 then
					announce(f.plr.DisplayName .. " a MOG un " .. TIERS[lvl].name .. " !", TIERS[lvl].col, lvl)
				end
			end
			R.BattleState:FireClient(f.plr, "end", { result = won and "win" or "lose", reward = reward, ai = isAI, type = bt.name, lines = buildSummary(bt, log, fighters, i, won) })
		end
	end
	task.wait(11)
	for i, f in ipairs(fighters) do
		if f.plr then
			f.plr:SetAttribute("Busy", nil)
			f.plr:SetAttribute("BattleId", nil)
			local char = f.plr.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.Anchored = false
				char:PivotTo(f.ret or CFrame.new(EXIT_POS[i]))
			end
			if data[f.plr] then refreshAll(f.plr) end
			local fa = hrp and hrp:FindFirstChild("FightAura")
			if fa then fa:Destroy() end
		elseif f.model then
			f.model:Destroy()
		end
	end
	if f2.botRef then
		if winIdx == 1 then despawnBot(f2.botRef, true) else releaseBot(f2.botRef) end
	end
	battles[b.id] = nil
end

local function nearestOpponent(plr)
	local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local best, bd = nil, 150
	for _, o in ipairs(Players:GetPlayers()) do
		if o ~= plr and data[o] and not o:GetAttribute("Busy") and o.Character then
			local r = o.Character:FindFirstChild("HumanoidRootPart")
			if r then
				local dd = (r.Position - root.Position).Magnitude
				if dd < bd then best, bd = o, dd end
			end
		end
	end
	return best
end

local function newFighter(plr)
	return { plr = plr, d = data[plr], name = plr.DisplayName }
end

PPS.PromptTriggered:Connect(function(prompt, plr)
	local id = prompt:GetAttribute("BotId")
	if not id then return end
	local bot = bots[id]
	if not bot or not bot.alive or bot.busy or not data[plr] or plr:GetAttribute("Busy") then return end
	local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - bot.root.Position).Magnitude > 22 then return end
	bot.busy = true
	if bot.kind == "rig" then
		bot.hum:MoveTo(bot.root.Position)
		bot.root.Anchored = true
	end
	prompt.Enabled = false
	setWalking(bot, false)
	task.spawn(runBattle, newFighter(plr), { name = bot.tierName, d = bot.d, diff = bot.level, botRef = bot, tag = bot.tag, zone = bot.zone }, true, bot.forceType or plr:GetAttribute("BType"))
end)

-- adversaire bot de niveau similaire (matchmaking de secours)
local function startBotFight(plr, btype)
	local lvl = tierOf(data[plr])
	local f2 = { name = TIERS[lvl].name, d = levelData(lvl), diff = lvl }
	task.spawn(runBattle, newFighter(plr), f2, true, btype)
end

-- matchmaking : apparie les joueurs de niveau proche (tolerance qui grandit avec l'attente)
task.spawn(function()
	while true do
		task.wait(1)
		local now = os.clock()
		for plr, q in pairs(queue) do
			if not plr.Parent or not data[plr] or plr:GetAttribute("Busy") then
				queue[plr] = nil
			else
				local waited = now - q.t
				local tol = 80 + waited * 40
				local best, bd
				for o, oq in pairs(queue) do
					if o ~= plr and oq.btype == q.btype and o.Parent and data[o] and not o:GetAttribute("Busy") then
						local diff = math.abs(mogScore(data[plr]) - mogScore(data[o]))
						if diff <= tol and (not bd or diff < bd) then best, bd = o, diff end
					end
				end
				if best then
					queue[plr], queue[best] = nil, nil
					R.BattleState:FireClient(plr, "queue", { on = false })
					R.BattleState:FireClient(best, "queue", { on = false })
					task.spawn(runBattle, newFighter(plr), newFighter(best), false, q.btype)
				elseif waited > 15 then
					queue[plr] = nil
					R.BattleState:FireClient(plr, "queue", { on = false })
					toast(plr, "Aucun joueur de ton niveau : bot de niveau similaire.", "info")
					startBotFight(plr, q.btype)
				end
			end
		end
	end
end)

R.BattleRequest.OnServerEvent:Connect(function(plr, mode, arg)
	if not data[plr] then return end
	if mode == "TYPE" then
		if type(arg) == "string" and BTYPES[arg] then plr:SetAttribute("BType", arg) end
		return
	end
	if mode == "LEAVE" then
		if queue[plr] then
			queue[plr] = nil
			R.BattleState:FireClient(plr, "queue", { on = false })
		end
		return
	end
	if plr:GetAttribute("Busy") then return end
	local key = "b" .. plr.UserId
	if cooldown[key] and os.clock() - cooldown[key] < 2 then return end
	cooldown[key] = os.clock()
	local btype = BTYPES[plr:GetAttribute("BType")] and plr:GetAttribute("BType") or "overall"
	if mode == "QUEUE" then
		queue[plr] = { t = os.clock(), btype = btype }
		R.BattleState:FireClient(plr, "queue", { on = true, type = BTYPES[btype].name })
	elseif mode == "BOT" then
		startBotFight(plr, btype)
	elseif mode == "PVP" then
		local opp = nearestOpponent(plr)
		if not opp then
			toast(plr, "Aucun joueur libre a proximite...", "bad")
			return
		end
		invites[opp] = { from = plr, t = os.clock(), btype = btype }
		R.BattleInvite:FireClient(opp, plr.DisplayName, plr.UserId)
		toast(plr, "Invitation envoyee a " .. opp.DisplayName, "info")
	end
end)

R.BattleInviteReply.OnServerEvent:Connect(function(plr, fromId, accept)
	local inv = invites[plr]
	invites[plr] = nil
	if not inv or inv.from.UserId ~= fromId or os.clock() - inv.t > 15 then return end
	if not accept then
		toast(inv.from, plr.DisplayName .. " a refuse le duel.", "bad")
		return
	end
	if not inv.from.Parent or not data[plr] or not data[inv.from] then return end
	if plr:GetAttribute("Busy") or inv.from:GetAttribute("Busy") then
		toast(inv.from, "Duel impossible : un joueur est occupe.", "bad")
		return
	end
	task.spawn(runBattle, newFighter(inv.from), newFighter(plr), false, inv.btype)
end)

------------------------------------------------------------------
-- TELEPORTATION (bouton MAP)
------------------------------------------------------------------
local PLACES = {
	arena = Vector3.new(0, 4, 28),
	face = Vector3.new(58, 4, -13),
	frame = Vector3.new(-58, 4, -13),
	height = Vector3.new(-58, 4, 13),
	bodyfat = Vector3.new(58, 4, 13),
	spawn = Vector3.new(0, 4, 112),
}
R.TutorialDone.OnServerEvent:Connect(function(plr)
	if data[plr] then
		data[plr].Tut = 1
		plr:SetAttribute("Busy", nil)
		pcall(function() store:SetAsync(tostring(plr.UserId), data[plr]) end)
	end
end)

R.TeleportTo.OnServerEvent:Connect(function(plr, key)
	local pos = PLACES[key]
	if not pos or plr:GetAttribute("Busy") or not data[plr] then return end
	if cooldown["t" .. plr.UserId] and os.clock() - cooldown["t" .. plr.UserId] < 2 then return end
	cooldown["t" .. plr.UserId] = os.clock()
	local char = plr.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		char:PivotTo(CFrame.new(pos))
	end
end)

------------------------------------------------------------------
-- JOUEURS / SAUVEGARDE
------------------------------------------------------------------
local function save(plr)
	local d = data[plr]
	if not d then return end
	pcall(function() store:SetAsync(tostring(plr.UserId), d) end)
end

local function onPlayer(plr)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	ls.Parent = plr
	for _, n in ipairs({ "MogScore", "Wins" }) do
		local v = Instance.new("IntValue")
		v.Name = n
		v.Parent = ls
	end
	local d = START_DATA()
	local ok, saved = pcall(function() return store:GetAsync(tostring(plr.UserId)) end)
	local function merge(dst, src)
		for k, v in pairs(src) do
			if type(v) == "table" and type(dst[k]) == "table" then
				merge(dst[k], v)
			elseif dst[k] == nil or type(dst[k]) == type(v) then
				dst[k] = v
			end
		end
	end
	if ok and type(saved) == "table" then merge(d, saved) end
	data[plr] = d
	pushAttrs(plr)
	updateRanks()
	hook("onJoin", plr)
	local function onChar(char)
		if data[plr] and data[plr].Tut == 0 and not plr:GetAttribute("TutSent") then
			plr:SetAttribute("TutSent", true)
			task.delay(2.5, function()
				if plr.Parent then
					plr:SetAttribute("Busy", true)
					R.Tutorial:FireClient(plr)
					task.delay(240, function() if plr.Parent then plr:SetAttribute("Busy", nil) end end)
				end
			end)
		end
		char:WaitForChild("Humanoid")
		char:WaitForChild("BodyColors", 6)
		task.wait(0.3)
		applyLook(plr)
		task.wait(1.5)
		applyLook(plr)
	end
	plr.CharacterAdded:Connect(onChar)
	if plr.Character then task.spawn(onChar, plr.Character) end
end

Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onPlayer, p) end
Players.PlayerRemoving:Connect(function(plr)
	save(plr)
	data[plr], cooldown[plr], sessions[plr], invites[plr], queue[plr] = nil, nil, nil, nil, nil
	updateRanks()
end)
game:BindToClose(function()
	for plr in pairs(data) do save(plr) end
end)
task.spawn(function()
	while true do
		task.wait(90)
		for plr in pairs(data) do save(plr) end
	end
end)

task.spawn(function()
	local map = Workspace:WaitForChild("MogMap", 60)
	local lb = map and map:WaitForChild("Leaderboard", 60)
	local sg = lb and lb:WaitForChild("SurfaceGui", 60)
	boardLabel = sg and sg:WaitForChild("BoardText", 60)
	updateRanks()
end)

------------------------------------------------------------------
-- ZONES : detection de la zone du joueur + API pour les autres scripts
------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(2)
		for _, p in ipairs(Players:GetPlayers()) do
			local d = data[p]
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if d and root then
				local best = 1
				for _, z in ipairs(Config.ZONES) do
					local off = root.Position - z.center
					if Vector3.new(off.X, 0, off.Z).Magnitude < 260 then best = z.id end
				end
				if p:GetAttribute("Zone") ~= best then
					p:SetAttribute("Zone", best)
					d.Zone = best
					local key = tostring(best)
					if not d.Visited[key] then
						d.Visited[key] = true
						toast(p, "Nouvelle zone decouverte : " .. Config.ZONES[best].name, "good")
					end
					if best > 1 then hook("onTrack", p, "zone", 1, { zone = best }) end
				end
			end
		end
	end
end)

_G.MogAPI = _G.MogAPI or {}
local api = _G.MogAPI
api.mult = api.mult or { coins = 1, stats = 1, cdFree = 1, sale = 1 }
api.data, api.R, api.remotes, api.Config, api.TIERS = data, R, remotes, Config, TIERS
api.toast, api.announce, api.refreshAll, api.pushAttrs, api.updateRanks = toast, announce, refreshAll, pushAttrs, updateRanks
api.bump, api.tierOf, api.mogScore, api.store, api.levelData, api.spawnBot = bump, tierOf, mogScore, store, levelData, spawnBot
api.addCoins, api.boostOn, api.applyLook, api.bots, api.cooldown, api.despawnBot, api.save = addCoins, boostOn, applyLook, bots, cooldown, despawnBot, save
api.startFight = function(plr, f2, btype)
	if not data[plr] or plr:GetAttribute("Busy") then return end
	task.spawn(runBattle, newFighter(plr), f2, true, btype)
end
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX15"><Properties><string name="Name">MogSystems</string><ProtectedString name="Source"><![CDATA[-- MogSystems : Face Lab, boutiques, quetes, titres, succes, connexion quotidienne, prestige, classements, portails, boss
-- Script a placer dans ServerScriptService (utilise _G.MogAPI cree par MogGame)
while not _G.MogAPI do task.wait(0.2) end
local api = _G.MogAPI
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local PPS = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local DSS = game:GetService("DataStoreService")
local Debris = game:GetService("Debris")

local Config, data, remotes = api.Config, api.data, api.remotes
local TIERS = Config.TIERS
local Req = Instance.new("RemoteFunction")
Req.Name = "MogReq"
Req.Parent = remotes
local FX = Instance.new("RemoteEvent")
FX.Name = "FX"
FX.Parent = remotes
api.FX = FX

local function today() return math.floor(os.time() / 86400) end
local function weekId() return math.floor((os.time() / 86400 + 3) / 7) end
local function sale() return api.mult.sale or 1 end
local function lvlOf(d) return math.floor(api.mogScore(d) / 40) end

------------------------------------------------------------------
-- TITRES / SUCCES
------------------------------------------------------------------
local function giveBadge(plr, id)
	local d = data[plr]
	if d and not d.Badges[id] then
		d.Badges[id] = true
		api.toast(plr, "SUCCES : " .. Config.BADGES[id][1], "good")
		api.pushAttrs(plr)
	end
end
local function giveTitle(plr, id, silent)
	local d = data[plr]
	if d and not d.Titles[id] then
		d.Titles[id] = true
		if not silent then api.toast(plr, "Nouveau titre : " .. Config.TITLES[id], "good") end
		api.pushAttrs(plr)
	end
end
api.giveBadge, api.giveTitle = giveBadge, giveTitle

local function progressCheck(plr)
	local d = data[plr]
	if not d then return end
	local t = api.tierOf(d)
	for i = 2, t do giveTitle(plr, "t" .. i, true) end
	if t >= 6 then giveBadge(plr, "chad") end
	if d.Wins >= 1 then giveBadge(plr, "first_win") end
	if d.Wins >= 10 then giveBadge(plr, "win10") giveTitle(plr, "battler") end
	if d.Wins >= 100 then giveBadge(plr, "win100") giveTitle(plr, "master") end
	local visited = 0
	for _ in pairs(d.Visited) do visited += 1 end
	if visited >= 8 then giveBadge(plr, "explorer") giveTitle(plr, "explorer") end
	for _, lv in pairs(d.Feat) do
		if lv >= Config.MAXLV then giveBadge(plr, "face_max") end
	end
	if d.Streak >= 7 then giveBadge(plr, "streak7") end
end

------------------------------------------------------------------
-- QUETES
------------------------------------------------------------------
local QLOOK = {}
for _, q in ipairs(Config.DAILY) do QLOOK[q.id] = q end
for _, q in ipairs(Config.WEEKLY) do QLOOK[q.id] = q end

local function rollQuests(plr)
	local d = data[plr]
	if not d then return end
	local day, wk = today(), weekId()
	local function pick(prefix, list, n, seed)
		for id in pairs(d.Quests) do
			if string.sub(id, 1, 2) == prefix then d.Quests[id] = nil end
		end
		local rng = Random.new(seed)
		local pool = table.clone(list)
		for _ = 1, n do
			local i = rng:NextInteger(1, #pool)
			d.Quests[pool[i].id] = { p = 0, c = false }
			table.remove(pool, i)
		end
	end
	if d.QDay ~= day then pick("d_", Config.DAILY, 3, day) d.QDay = day end
	if d.QWeek ~= wk then pick("w_", Config.WEEKLY, 2, wk + 1000) d.QWeek = wk end
end

function api.onTrack(plr, kind, n, extra)
	local d = data[plr]
	if not d then return end
	local changed = false
	for id, q in pairs(d.Quests) do
		local cfg = QLOOK[id]
		if cfg and not q.c and q.p < cfg.goal then
			local match = (cfg.kind == kind) or (cfg.kind == "winTier" and kind == "win" and extra and extra.ai and (extra.tier or 0) >= (cfg.min or 1))
			if match then
				q.p = math.min(cfg.goal, q.p + ((kind == "coins") and n or 1))
				changed = true
			end
		end
	end
	progressCheck(plr)
	if changed then api.pushAttrs(plr) end
end

function api.onBattleWin(plr, f2, isAI, btKey)
	local d = data[plr]
	if not d then return end
	if f2.tag == "scout" then
		giveBadge(plr, "scouted")
		giveTitle(plr, "scouted")
		d.Coins += 300
		api.toast(plr, "Recruteur impressionne : +300 coins !", "good")
	elseif f2.tag == "giant" then
		d.Coins += 1000
		api.toast(plr, "GIGA CHAD vaincu : +1000 coins !", "good")
	end
	if (f2.diff or 0) >= 6 and isAI then giveBadge(plr, "mog_chad") end
	if api.compAdd then api.compAdd(plr, 10 + (f2.diff or 1) * 5) end
	progressCheck(plr)
	api.pushAttrs(plr)
end

function api.onJoin(plr)
	local d = data[plr]
	if not d then return end
	local t = today()
	if d.LastDay ~= t then
		if d.LastDay == t - 1 then d.Streak += 1 else d.Streak = 1 end
		d.LastDay = t
	end
	rollQuests(plr)
	plr:SetAttribute("DailyReady", d.Claimed ~= t)
	plr:SetAttribute("Streak", d.Streak)
	progressCheck(plr)
	api.pushAttrs(plr)
end
for plr in pairs(data) do api.onJoin(plr) end
task.spawn(function()
	while true do
		task.wait(60)
		for plr in pairs(data) do
			rollQuests(plr)
			api.pushAttrs(plr)
		end
	end
end)

------------------------------------------------------------------
-- EFFETS DE RANG
------------------------------------------------------------------
function api.onAscend(plr, tier)
	local char = plr.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local col = TIERS[tier].col
	local beam = Instance.new("Part")
	beam.Anchored, beam.CanCollide, beam.CanQuery = true, false, false
	beam.Material = Enum.Material.Neon
	beam.Color = col
	beam.Size = Vector3.new(7, 320, 7)
	beam.Position = hrp.Position + Vector3.new(0, 150, 0)
	beam.Transparency = 0.25
	beam.Parent = Workspace
	TweenService:Create(beam, TweenInfo.new(4.5), { Transparency = 1, Size = Vector3.new(0.5, 320, 0.5) }):Play()
	Debris:AddItem(beam, 5)
	for i = 1, 3 do
		task.delay(i * 0.35, function()
			local r = Instance.new("Part")
			r.Anchored, r.CanCollide, r.CanQuery = true, false, false
			r.Material = Enum.Material.Neon
			r.Color = col
			r.Size = Vector3.new(2, 0.4, 2)
			r.Position = hrp.Position - Vector3.new(0, 2.5, 0)
			r.Parent = Workspace
			TweenService:Create(r, TweenInfo.new(1.1), { Size = Vector3.new(40, 0.4, 40), Transparency = 1 }):Play()
			Debris:AddItem(r, 1.3)
		end)
	end
	FX:FireAllClients("ascend", plr.UserId, col, TIERS[tier].name)
end

------------------------------------------------------------------
-- ZONES / PORTAILS / BOSS
------------------------------------------------------------------
local function goZone(plr, id)
	local z = Config.ZONES[id]
	local d = data[plr]
	if not z or not d then return false end
	if lvlOf(d) < z.req then
		api.toast(plr, string.format("%s : niveau %d requis (tu es niveau %d)", z.name, z.req, lvlOf(d)), "bad")
		return false
	end
	local char = plr.Character
	if char and char:FindFirstChild("HumanoidRootPart") then char:PivotTo(CFrame.new(z.arrive)) end
	api.toast(plr, "Bienvenue : " .. z.name, "good")
	FX:FireClient(plr, "zone", z.name, z.col)
	return true
end

local bossCd = {}
local function startBoss(plr, z)
	local zc = Config.ZONES[z]
	if not zc then return end
	local key = plr.UserId .. ":" .. z
	if bossCd[key] and os.clock() - bossCd[key] < 120 then
		api.toast(plr, "Le boss se repose... reviens dans " .. math.ceil(120 - (os.clock() - bossCd[key])) .. "s", "bad")
		return
	end
	bossCd[key] = os.clock()
	local tier = math.clamp(z, 1, 6)
	local bd = api.levelData(tier)
	for k, v in pairs(bd) do bd[k] = (k == "Bodyfat") and math.max(3, v - 5) or math.min(99, v + 5) end
	api.startFight(plr, { name = zc.boss, d = bd, diff = tier, boss = true, zone = z }, "overall")
end

local photoSeen = {}
PPS.PromptTriggered:Connect(function(prompt, plr)
	local d = data[plr]
	if not d then return end
	local photo = prompt:GetAttribute("Photo")
	if photo then
		FX:FireClient(plr, "photo", photo)
		api.onTrack(plr, "photo", 1)
		giveBadge(plr, "photo")
		local k = plr.UserId .. photo
		if not photoSeen[k] then
			photoSeen[k] = true
			api.addCoins(plr, 30)
		end
		return
	end
	if plr:GetAttribute("Busy") then return end
	local open = prompt:GetAttribute("Open")
	if open then FX:FireClient(plr, "ui", open, prompt:GetAttribute("OpenZone")) return end
	local portal = prompt:GetAttribute("Portal")
	if portal then goZone(plr, portal) return end
	local boss = prompt:GetAttribute("Boss")
	if boss then startBoss(plr, boss) return end
	if prompt:GetAttribute("Contest") and api.contestJoin then api.contestJoin(plr) end
end)

------------------------------------------------------------------
-- REQUETES CLIENT (le serveur reste l'autorite)
------------------------------------------------------------------
local ATTR = { coins = "Coins", train = "Train", cd = "Cd" }
local lastReq = {}

Req.OnServerInvoke = function(plr, action, a, b)
	local d = data[plr]
	if not d or type(action) ~= "string" then return { ok = false } end
	if lastReq[plr] and os.clock() - lastReq[plr] < 0.12 then return { ok = false, msg = "Trop vite" } end
	lastReq[plr] = os.clock()

	if action == "feat_buy" then
		local f
		for _, x in ipairs(Config.FEATURES) do
			if x.id == a then f = x end
		end
		if not f then return { ok = false, msg = "Trait inconnu" } end
		local lv = d.Feat[f.id] or 0
		if lv >= Config.MAXLV then return { ok = false, msg = "Niveau maximum" } end
		local price = math.floor(Config.featPrice(f, lv) * sale())
		if d.Coins < price then return { ok = false, msg = "Pas assez de coins" } end
		d.Coins -= price
		d.Feat[f.id] = lv + 1
		local got = api.bump(plr, "Face", f.pts)
		api.onTrack(plr, "feature", 1)
		api.refreshAll(plr)
		FX:FireClient(plr, "feature", f.id, lv + 1)
		return { ok = true, level = lv + 1, pts = got }

	elseif action == "shop_list" then
		local out = {}
		for _, it in ipairs(Config.SHOP) do
			local z = Config.ZONES[it.zone]
			local owned = (it.kind == "hair" and d.Titles["hair_" .. it.n]) or (it.kind == "title" and d.Titles[it.title]) or false
			table.insert(out, { id = it.id, name = it.name, desc = it.desc, price = math.floor(it.price * sale()), owned = owned and true or false, locked = lvlOf(d) < z.req, req = z.req, zone = z.name, kind = it.kind })
		end
		return { ok = true, items = out, sale = sale() < 1 }

	elseif action == "shop_buy" then
		local it
		for _, x in ipairs(Config.SHOP) do
			if x.id == a then it = x end
		end
		if not it then return { ok = false, msg = "Objet inconnu" } end
		if lvlOf(d) < Config.ZONES[it.zone].req then return { ok = false, msg = "Zone non debloquee" } end
		local owned = (it.kind == "hair" and d.Titles["hair_" .. it.n]) or (it.kind == "title" and d.Titles[it.title])
		if owned then return { ok = false, msg = "Deja possede" } end
		local price = math.floor(it.price * sale())
		if d.Coins < price then return { ok = false, msg = "Pas assez de coins" } end
		d.Coins -= price
		if it.kind == "boost" then
			local k = "Boost" .. ATTR[it.key]
			plr:SetAttribute(k, math.max(plr:GetAttribute(k) or 0, os.time()) + it.secs)
		elseif it.kind == "hair" then
			d.Titles["hair_" .. it.n] = true
			d.Hair = it.n
		elseif it.kind == "title" then
			d.Titles[it.title] = true
			d.Title = it.title
		end
		api.refreshAll(plr)
		return { ok = true }

	elseif action == "hair_set" then
		local n = math.floor(tonumber(a) or 1)
		if n >= 1 and n <= #Config.HAIR and (n == 1 or d.Titles["hair_" .. n]) then
			d.Hair = n
			api.refreshAll(plr)
			return { ok = true }
		end
		return { ok = false }

	elseif action == "title_equip" then
		if type(a) == "string" and Config.TITLES[a] and d.Titles[a] then
			d.Title = a
			api.refreshAll(plr)
			return { ok = true }
		end
		return { ok = false }

	elseif action == "quest_claim" then
		local q, cfg = d.Quests[a], QLOOK[a]
		if not q or not cfg or q.c or q.p < cfg.goal then return { ok = false } end
		q.c = true
		d.Coins += cfg.reward
		api.pushAttrs(plr)
		return { ok = true, reward = cfg.reward }

	elseif action == "daily_claim" then
		local t = today()
		if d.Claimed == t then return { ok = false } end
		d.Claimed = t
		local idx = ((d.Streak - 1) % 7) + 1
		local amt = Config.LOGIN[idx]
		d.Coins += amt
		plr:SetAttribute("DailyReady", false)
		progressCheck(plr)
		api.pushAttrs(plr)
		return { ok = true, reward = amt, day = idx }

	elseif action == "prestige" then
		if lvlOf(d) < 90 or d.Prestige >= 3 then return { ok = false, msg = "Niveau 90 requis (max 3 prestiges)" } end
		d.Prestige += 1
		local fpts = 0
		for _, v in pairs(d.Feat) do fpts += v * 2 end
		d.Face = math.min(100, 10 + fpts + 3 * d.Prestige)
		d.Frame = 10 + 3 * d.Prestige
		d.Height = 15 + 3 * d.Prestige
		d.Bodyfat = 85 - 3 * d.Prestige
		d.Coins += 2000 * d.Prestige
		giveBadge(plr, "prestige")
		giveTitle(plr, "t" .. (6 + d.Prestige))
		api.refreshAll(plr)
		api.onAscend(plr, 6 + d.Prestige)
		api.announce(plr.DisplayName .. " passe PRESTIGE " .. d.Prestige .. " !", TIERS[6 + d.Prestige].col, 6)
		return { ok = true, prestige = d.Prestige }

	elseif action == "zone_go" then
		if plr:GetAttribute("Busy") then return { ok = false, msg = "Occupe" } end
		return { ok = goZone(plr, a) }

	elseif action == "board" then
		return { ok = true, list = (api.boards and api.boards[a]) or {} }

	elseif action == "contest_join" then
		if api.contestJoin then return { ok = api.contestJoin(plr) } end
		return { ok = false }
	end
	return { ok = false }
end

------------------------------------------------------------------
-- CLASSEMENTS MONDIAUX (OrderedDataStore) + ecrans dans la ville
------------------------------------------------------------------
local KEYS = { score = "MogB_Score", Face = "MogB_Face", Frame = "MogB_Frame", Height = "MogB_Height", Lean = "MogB_Lean" }
local TITLE = { score = "TOP MOGGERS", Face = "TOP FACE", Frame = "TOP FRAME", Height = "TOP HEIGHT", Lean = "TOP BODYFAT", global = "GLOBAL MOG COMPETITION" }
local boards, nameCache = api.boards or {}, {}
api.boards = boards

local function statVal(d, k)
	if k == "score" then return api.mogScore(d) end
	if k == "Lean" then return 100 - d.Bodyfat end
	return d[k]
end
local function nameOf(uid)
	if nameCache[uid] then return nameCache[uid] end
	local ok, n = pcall(function() return Players:GetNameFromUserIdAsync(uid) end)
	nameCache[uid] = ok and n or ("Joueur " .. uid)
	return nameCache[uid]
end

local function localBoard(k)
	local list = {}
	for plr, d in pairs(data) do table.insert(list, { name = plr.DisplayName, value = statVal(d, k) }) end
	table.sort(list, function(x, y) return x.value > y.value end)
	while #list > 10 do table.remove(list) end
	return list
end

local function render()
	local map = Workspace:FindFirstChild("MogMap")
	if not map then return end
	for key, title in pairs(TITLE) do
		local part = map:FindFirstChild("Board_" .. key)
		local sg = part and part:FindFirstChildOfClass("SurfaceGui")
		local lbl = sg and sg:FindFirstChild("BoardText")
		if lbl then
			local lines = {}
			for i, e in ipairs(boards[key] or {}) do
				if i <= 8 then table.insert(lines, string.format("%d. %s  -  %d", i, e.name, e.value)) end
			end
			lbl.Text = (#lines > 0) and table.concat(lines, "\n") or "..."
			local t = sg:FindFirstChild("BoardTitle")
			if t then t.Text = title end
		end
	end
end
api.renderBoards = render

task.spawn(function()
	while true do
		for k in pairs(KEYS) do boards[k] = localBoard(k) end
		render()
		-- synchronisation mondiale (silencieuse si les DataStores sont indisponibles)
		for k, name in pairs(KEYS) do
			local ok, ods = pcall(function() return DSS:GetOrderedDataStore(name) end)
			if ok then
				for plr, d in pairs(data) do
					pcall(function() ods:SetAsync(tostring(plr.UserId), statVal(d, k)) end)
				end
				local ok2, pages = pcall(function() return ods:GetSortedAsync(false, 10) end)
				if ok2 then
					local ok3, page = pcall(function() return pages:GetCurrentPage() end)
					if ok3 and #page > 0 then
						local list = {}
						for _, e in ipairs(page) do table.insert(list, { name = nameOf(tonumber(e.key)), value = e.value }) end
						boards[k] = list
					end
				end
			end
			task.wait(2)
		end
		render()
		task.wait(45)
	end
end)

print("MogSystems pret")
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX16"><Properties><string name="Name">MogEvents</string><ProtectedString name="Source"><![CDATA[-- MogEvents : evenements aleatoires, competition mondiale, King of the City, etc.
-- Script a placer dans ServerScriptService (utilise _G.MogAPI cree par MogGame)
while not _G.MogAPI do task.wait(0.2) end
local api = _G.MogAPI
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local DSS = game:GetService("DataStoreService")
local Debris = game:GetService("Debris")

local Config, data, remotes = api.Config, api.data, api.remotes
local TIERS = Config.TIERS
local ES = Instance.new("RemoteEvent")
ES.Name = "EventState"
ES.Parent = remotes

api.boards = api.boards or {}
local EV = {}
local current
local flags = {}
local globalOn = false
local weekendOn = false

local function recompute()
	local m = api.mult
	m.coins = math.max((weekendOn or flags.double) and 2 or 1, flags.festival and 1.5 or 1)
	m.stats = (weekendOn or flags.double) and 1.5 or 1
	m.cdFree = flags.rush and 2 or 1
	m.sale = flags.sale and 0.7 or 1
end

local function broadcast(target)
	local list = {}
	if current then
		local c = Config.EVENTS[current.id]
		table.insert(list, { name = c.name, ends = current.ends, col = c.col })
	end
	if globalOn then
		local c = Config.EVENTS.global
		table.insert(list, { name = c.name, ends = api.globalEnds or (os.time() + 600), col = c.col })
	end
	if weekendOn then
		table.insert(list, { name = "DOUBLE MOG WEEKEND", ends = os.time() + 3600, col = Config.EVENTS.double.col })
	end
	if target then ES:FireClient(target, list) else ES:FireAllClients(list) end
end
Players.PlayerAdded:Connect(function(p) task.delay(3, function() if p.Parent then broadcast(p) end end) end)

local function say(id, text, level)
	api.announce(text, Config.EVENTS[id].col, level or 5)
end

local function zonePlayers()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local z = p:GetAttribute("Zone")
		if z then list[#list + 1] = z end
	end
	return list
end

------------------------------------------------------------------
-- EVENEMENTS
------------------------------------------------------------------
EV.contest = function(cur)
	local parts = {}
	local map = Workspace:FindFirstChild("MogMap")
	local pad = map and map:FindFirstChild("ContestPad")
	local prompt = pad and pad:FindFirstChildOfClass("ProximityPrompt")
	if prompt then prompt.Enabled = true end
	say("contest", "MOG CONTEST ! Rejoins-le a l'arene dans les 60 secondes : le meilleur Mog gagne !", 6)
	api.contestJoin = function(plr)
		if cur.closed or not current or current.id ~= "contest" then return false end
		if not parts[plr] then
			parts[plr] = true
			api.toast(plr, "Inscrit au Mog Contest !", "good")
		end
		return true
	end
	task.delay(60, function()
		cur.closed = true
		if prompt then prompt.Enabled = false end
		local cats = {
			{ "FACE", { Face = 1 } }, { "HEIGHT", { Height = 1 } }, { "FRAME", { Frame = 1 } },
			{ "OVERALL", { Face = 0.25, Frame = 0.25, Height = 0.25, Lean = 0.25 } },
		}
		local cat = cats[math.random(1, #cats)]
		local res = {}
		for plr in pairs(parts) do
			local d = data[plr]
			if d and plr.Parent then
				local v = 0
				for k, w in pairs(cat[2]) do v += ((k == "Lean") and (100 - d.Bodyfat) or d[k]) * w end
				table.insert(res, { plr = plr, v = v * (1 + (math.random() * 2 - 1) * 0.08) })
			end
		end
		table.sort(res, function(a, b) return a.v > b.v end)
		if #res == 0 then
			say("contest", "Mog Contest annule : personne ne s'est inscrit.", 5)
			return
		end
		local prizes = { 1000, 500, 250 }
		for i, r in ipairs(res) do
			api.addCoins(r.plr, prizes[i] or 100)
			api.toast(r.plr, string.format("Mog Contest : %de place (+%d coins)", i, prizes[i] or 100), i == 1 and "good" or "info")
		end
		local w = res[1].plr
		api.giveTitle(w, "champion")
		api.giveBadge(w, "champion")
		say("contest", string.format("%s remporte le MOG CONTEST (%s) !", w.DisplayName, cat[1]), 6)
	end)
	cur.cleanup = function()
		api.contestJoin = nil
		if prompt then prompt.Enabled = false end
	end
end

EV.invasion = function(cur)
	say("invasion", "CHAD INVASION ! Un GIGA CHAD geant est apparu dans la ville : defie-le !", 6)
	api.spawnBot(6, true, 1, { giant = true, name = "GIGA CHAD", life = 240, force = true, tag = "giant" })
	cur.cleanup = function()
		for _, b in pairs(api.bots) do
			if b.tag == "giant" and not b.busy then api.despawnBot(b, true) end
		end
	end
end

EV.scouting = function(cur)
	say("scouting", "MODEL SCOUTING : des recruteurs sont en ville ! Defie-les en STYLE BATTLE pour un bonus.", 5)
	for _ = 1, 3 do
		api.spawnBot(3, true, 1, { name = "SCOUT", tag = "scout", forceType = "style", life = 240, force = true })
		task.wait(0.5)
	end
	cur.cleanup = function()
		for _, b in pairs(api.bots) do
			if b.tag == "scout" and not b.busy then api.despawnBot(b, false) end
		end
	end
end

EV.festival = function(cur)
	flags.festival = true
	recompute()
	local f = Instance.new("Folder")
	f.Name = "FestivalDeco"
	f.Parent = Workspace
	local cols = { Color3.fromRGB(255, 120, 160), Color3.fromRGB(255, 200, 80), Color3.fromRGB(110, 200, 255), Color3.fromRGB(150, 230, 130), Color3.fromRGB(190, 140, 255) }
	for i = 1, 16 do
		local a = i / 16 * math.pi * 2
		local pos = Vector3.new(math.sin(a) * 34, 14 + (i % 3) * 4, math.cos(a) * 34)
		local b = Instance.new("Part")
		b.Shape = Enum.PartType.Ball
		b.Size = Vector3.new(4, 4.6, 4)
		b.Anchored, b.CanCollide, b.CanQuery = true, false, false
		b.Material = Enum.Material.SmoothPlastic
		b.Color = cols[(i % #cols) + 1]
		b.Position = pos
		b.Parent = f
		local s = Instance.new("Part")
		s.Anchored, s.CanCollide, s.CanQuery = true, false, false
		s.Size = Vector3.new(0.15, pos.Y, 0.15)
		s.Position = Vector3.new(pos.X, pos.Y / 2, pos.Z)
		s.Color = Color3.fromRGB(230, 230, 230)
		s.Parent = f
	end
	say("festival", "MOG FESTIVAL ! Coins x1.5 sur tous les mini-jeux et combats pendant 5 minutes !", 6)
	cur.loop = true
	task.spawn(function()
		while current == cur do
			task.wait(5)
			local p = Instance.new("Part")
			p.Anchored, p.CanCollide, p.CanQuery, p.Transparency = true, false, false, 1
			p.Position = Vector3.new(math.random(-30, 30), math.random(30, 50), math.random(-30, 30))
			p.Parent = Workspace
			local e = Instance.new("ParticleEmitter")
			e.Color = ColorSequence.new(cols[math.random(1, #cols)])
			e.LightEmission = 1
			e.Rate = 0
			e.Speed = NumberRange.new(20, 34)
			e.Lifetime = NumberRange.new(0.9, 1.4)
			e.SpreadAngle = Vector2.new(180, 180)
			e.Size = NumberSequence.new(1.6, 0)
			e.Acceleration = Vector3.new(0, -14, 0)
			e.Parent = p
			e:Emit(70)
			Debris:AddItem(p, 2)
		end
	end)
	cur.cleanup = function()
		flags.festival = nil
		recompute()
		f:Destroy()
		for plr in pairs(data) do api.addCoins(plr, 100) end
		say("festival", "Le Mog Festival est termine ! +100 coins pour tous les participants.", 5)
	end
end

EV.king = function(cur)
	local best, bs
	for plr, d in pairs(data) do
		local s = api.mogScore(d)
		if plr.Character and (not bs or s > bs) then best, bs = plr, s end
	end
	if not best then return end
	local head = best.Character:FindFirstChild("Head")
	local crown
	if head then
		crown = Instance.new("Part")
		crown.Name = "KingCrown"
		crown.Size = Vector3.new(2.4, 1, 2.4)
		crown.Material = Enum.Material.Neon
		crown.Color = Color3.fromRGB(255, 214, 70)
		crown.CanCollide, crown.CanQuery, crown.Massless = false, false, true
		crown.CFrame = head.CFrame * CFrame.new(0, head.Size.Y * 0.9 + 0.8, 0)
		crown.Parent = best.Character
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = head, crown
		w.Parent = crown
		local e = Instance.new("ParticleEmitter")
		e.Color = ColorSequence.new(Color3.fromRGB(255, 214, 70))
		e.LightEmission = 1
		e.Rate = 25
		e.Lifetime = NumberRange.new(1, 1.5)
		e.Speed = NumberRange.new(2, 5)
		e.Size = NumberSequence.new(0.6, 0)
		e.Parent = crown
	end
	best:SetAttribute("King", true)
	api.giveBadge(best, "king")
	api.giveTitle(best, "king")
	say("king", best.DisplayName .. " est le KING OF THE CITY pendant 3 minutes (meilleur score en ligne) !", 6)
	task.spawn(function()
		while current == cur and best.Parent do
			task.wait(10)
			if best.Parent then api.addCoins(best, 25) end
		end
	end)
	cur.cleanup = function()
		if crown then crown:Destroy() end
		if best.Parent then best:SetAttribute("King", nil) end
	end
end

EV.rare = function(cur)
	local zs = zonePlayers()
	local z = (#zs > 0) and zs[math.random(1, #zs)] or 1
	local level = (math.random() < 0.7) and 5 or 6
	api.spawnBot(level, true, z, { force = true, life = 240 })
	say("rare", "RARE NPC : un " .. TIERS[level].name .. " vient d'apparaitre dans " .. Config.ZONES[z].name .. " !", 6)
end

EV.double = function(cur)
	flags.double = true
	recompute()
	say("double", "DOUBLE MOG ! Coins x2 et progression boostee pendant 10 minutes !", 5)
	cur.cleanup = function()
		flags.double = nil
		recompute()
	end
end

EV.sigma = function(cur)
	local orig = { ClockTime = Lighting.ClockTime, Brightness = Lighting.Brightness, Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient }
	TweenService:Create(Lighting, TweenInfo.new(6), { ClockTime = 23, Brightness = 1.2, Ambient = Color3.fromRGB(62, 62, 104), OutdoorAmbient = Color3.fromRGB(72, 72, 124) }):Play()
	say("sigma", "SIGMA NIGHT : la nuit tombe... des bots rares rodent dans la ville !", 5)
	for _ = 1, 2 do
		api.spawnBot(math.random(4, 5), true, 1, { force = true, life = 280 })
		task.wait(0.5)
	end
	cur.cleanup = function()
		TweenService:Create(Lighting, TweenInfo.new(6), orig):Play()
	end
end

EV.sale = function(cur)
	flags.sale = true
	recompute()
	say("sale", "FLASH SALE : -30% sur le Face Lab et la boutique pendant 5 minutes !", 5)
	cur.cleanup = function()
		flags.sale = nil
		recompute()
	end
end

EV.rush = function(cur)
	flags.rush = true
	recompute()
	say("rush", "TRAINING RUSH : plus aucune pause entre les entrainements pendant 5 minutes !", 5)
	cur.cleanup = function()
		flags.rush = nil
		recompute()
	end
end

local RANDOM = { "contest", "invasion", "scouting", "festival", "king", "rare", "double", "sigma", "sale", "rush" }
local function startEvent(id)
	local cfg = Config.EVENTS[id]
	local cur = { id = id, ends = os.time() + cfg.secs }
	current = cur
	local ok, err = pcall(EV[id], cur)
	if not ok then warn("Event " .. id .. ": " .. tostring(err)) end
	broadcast()
	task.delay(cfg.secs, function()
		if current == cur then
			if cur.cleanup then pcall(cur.cleanup) end
			current = nil
			broadcast()
		end
	end)
end
api.startEvent = startEvent

task.spawn(function()
	task.wait(90)
	while true do
		if not current and #Players:GetPlayers() > 0 then startEvent(RANDOM[math.random(1, #RANDOM)]) end
		task.wait(math.random(240, 420))
	end
end)

------------------------------------------------------------------
-- DOUBLE MOG WEEKEND (samedi/dimanche UTC) + COMPETITION MONDIALE (minutes 0-19 de chaque heure)
------------------------------------------------------------------
local compPts, compSent = {}, {}
function api.compAdd(plr, pts)
	if globalOn then compPts[plr.UserId] = (compPts[plr.UserId] or 0) + pts end
end

local function weekKey() return "MogComp_" .. math.floor((os.time() / 86400 + 3) / 7) end

task.spawn(function()
	while true do
		local t = os.date("!*t")
		local wk = (t.wday == 1 or t.wday == 7)
		if wk ~= weekendOn then
			weekendOn = wk
			recompute()
			if wk then api.announce("DOUBLE MOG WEEKEND : coins x2 tout le week-end !", Config.EVENTS.double.col, 5) end
			broadcast()
		end
		local on = t.min < 20
		if on ~= globalOn then
			globalOn = on
			api.globalEnds = os.time() + (on and (20 - t.min) * 60 or 0)
			if on then
				api.announce("GLOBAL MOG COMPETITION : gagne des combats pour grimper au classement MONDIAL !", Config.EVENTS.global.col, 6)
			else
				local top = api.boards.global and api.boards.global[1]
				api.announce("Competition mondiale terminee" .. (top and (" - en tete : " .. top.name) or "") .. " !", Config.EVENTS.global.col, 5)
			end
			broadcast()
		end
		task.wait(15)
	end
end)

task.spawn(function()
	while true do
		task.wait(30)
		local local_list = {}
		for plr in pairs(data) do
			local v = compPts[plr.UserId] or 0
			if v > 0 then table.insert(local_list, { name = plr.DisplayName, value = v }) end
		end
		table.sort(local_list, function(a, b) return a.value > b.value end)
		api.boards.global = local_list
		local ok, ods = pcall(function() return DSS:GetOrderedDataStore(weekKey()) end)
		if ok then
			for uid, total in pairs(compPts) do
				local delta = total - (compSent[uid] or 0)
				if delta > 0 then
					local okU = pcall(function()
						ods:UpdateAsync(tostring(uid), function(old) return (old or 0) + delta end)
					end)
					if okU then compSent[uid] = total end
				end
			end
			local ok2, pages = pcall(function() return ods:GetSortedAsync(false, 10) end)
			if ok2 then
				local ok3, page = pcall(function() return pages:GetCurrentPage() end)
				if ok3 and #page > 0 then
					local list = {}
					for _, e in ipairs(page) do
						local ok4, n = pcall(function() return Players:GetNameFromUserIdAsync(tonumber(e.key)) end)
						table.insert(list, { name = ok4 and n or ("Joueur " .. e.key), value = e.value })
					end
					api.boards.global = list
				end
			end
		end
		if api.renderBoards then api.renderBoards() end
	end
end)

print("MogEvents pret")
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX19"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX18"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX7"><Properties><string name="Name">MogClient</string><ProtectedString name="Source"><![CDATA[-- MogClient : LocalScript (StarterPlayer > StarterPlayerScripts)
-- 3 boutons a droite (STATS / BATTLE / MAP), menu Mog Stats (affichage uniquement),
-- mini-jeux des stations, Mog Battle, notifications.
-- Les ModuleScripts Studs, Minigames et BattleUI sont enfants de ce script.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local S = require(script:WaitForChild("Studs"))
local Minigames = require(script:WaitForChild("Minigames"))
local Battle = require(script:WaitForChild("BattleUI"))
local Tutorial = require(script:WaitForChild("Tutorial"))
local Menus = require(script:WaitForChild("Menus"))
local City = require(script:WaitForChild("City"))
local C, make, tween = S.C, S.make, S.tween

local player = Players.LocalPlayer
local remotes = RS:WaitForChild("MogRemotes")
local gui = make("ScreenGui", {
	Name = "MogUI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 5,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, player:WaitForChild("PlayerGui"))
Battle.init(gui, remotes)

local busy = false
local side
local startTutorial

------------------------------------------------------------------
-- NOTIFICATIONS
------------------------------------------------------------------
local toastFrame
local function toast(text, kind)
	if toastFrame then toastFrame:Destroy() end
	local col = kind == "bad" and C.red or (kind == "good" and Color3.fromRGB(40, 150, 70) or C.brick)
	local f = S.panel(gui, { Name = "Toast", Size = UDim2.fromScale(0.4, 0.07), Position = UDim2.fromScale(0.5, -0.12), AnchorPoint = Vector2.new(0.5, 0), color = col, cols = 20, rows = 2, z = 90 })
	S.label(f, text, { Size = UDim2.fromScale(0.94, 0.62), Position = UDim2.fromScale(0.03, 0.19), z = 91 })
	toastFrame = f
	tween(f, 0.4, { Position = UDim2.fromScale(0.5, 0.03) }, Enum.EasingStyle.Back)
	task.delay(3.2, function()
		if f.Parent then
			tween(f, 0.3, { Position = UDim2.fromScale(0.5, -0.12) })
			task.delay(0.35, function() f:Destroy() end)
		end
	end)
end
remotes.Toast.OnClientEvent:Connect(toast)

local announceFrame
local function announce(text, col, level)
	if announceFrame then announceFrame:Destroy() end
	local f = S.panel(gui, { Name = "Announce", Size = UDim2.fromScale(0.62, 0.13), Position = UDim2.fromScale(0.5, -0.2), AnchorPoint = Vector2.new(0.5, 0), color = C.panel, cols = 30, rows = 4, z = 95, strokeColor = col, stroke = 4 })
	make("Frame", { Size = UDim2.fromScale(0.012, 0.8), Position = UDim2.fromScale(0.02, 0.1), BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 97 }, f)
	S.label(f, "ANNONCE SERVEUR", { Size = UDim2.fromScale(0.3, 0.2), Position = UDim2.fromScale(0.05, 0.08), color = col, font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, z = 98 })
	S.label(f, text, { Size = UDim2.fromScale(0.92, 0.5), Position = UDim2.fromScale(0.05, 0.34), xAlign = Enum.TextXAlignment.Left, z = 98 })
	announceFrame = f
	tween(f, 0.5, { Position = UDim2.fromScale(0.5, 0.1) }, Enum.EasingStyle.Back)
	S.sfx("ping")
	if level >= 6 then
		S.flash(gui, col, 0.6, 0.8)
		S.confetti(gui, 60)
		S.shake(f, 10, 0.5)
		S.sfx("hit")
	elseif level >= 5 then
		S.flash(gui, col, 0.8, 0.5)
	end
	task.delay(level >= 6 and 8 or 5.5, function()
		if f.Parent then
			tween(f, 0.4, { Position = UDim2.fromScale(0.5, -0.2) })
			task.delay(0.45, function() f:Destroy() end)
		end
	end)
end
remotes.Announce.OnClientEvent:Connect(announce)

------------------------------------------------------------------
-- MOG STATS (affichage uniquement, pas de bouton d'amelioration)
------------------------------------------------------------------
local ROWS = {
	{ key = "Face", name = "Face", color = C.purple },
	{ key = "Frame", name = "Frame", color = C.blue },
	{ key = "Height", name = "Height", color = C.green },
	{ key = "Bodyfat", name = "Bodyfat", color = C.orange, note = "moins = mieux" },
}

local stats = S.panel(gui, { Name = "StatsPanel", Size = UDim2.fromScale(0.74, 0.86), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), cols = 36, rows = 24, z = 15 })
stats.Visible = false
make("UIAspectRatioConstraint", { AspectRatio = 1.5 }, stats)
local statsScale = make("UIScale", { Scale = 0.6 }, stats)

for _, c in ipairs({ { 0, 0 }, { 0.945, 0 } }) do
	S.panel(stats, { Size = UDim2.fromScale(0.055, 0.075), Position = UDim2.fromScale(c[1], c[2]), color = C.red, cols = 2, rows = 2, z = 16, stroke = 2 })
end
S.title(stats, "MOG STATS", UDim2.fromScale(0.5, 0.15), UDim2.fromScale(0.25, 0.025))
local closeX = S.button(stats, "X", { Size = UDim2.fromScale(0.07, 0.1), Position = UDim2.fromScale(0.89, 0.03), color = C.red, cols = 3, rows = 3, textW = 0.7, textH = 0.7, z = 20 })
make("UIAspectRatioConstraint", { AspectRatio = 1 }, closeX)

local function icon(key, box)
	local function f(size, pos, col, r, z)
		local x = make("Frame", { Size = size, Position = pos, BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = z or 19 }, box)
		if r then make("UICorner", { CornerRadius = UDim.new(r, 0) }, x) end
		return x
	end
	if key == "Face" then
		local h = f(UDim2.fromScale(0.62, 0.7), UDim2.fromScale(0.19, 0.15), Color3.fromRGB(250, 205, 40), 0.2)
		make("Frame", { Size = UDim2.fromScale(0.14, 0.2), Position = UDim2.fromScale(0.22, 0.3), BackgroundColor3 = C.black, BorderSizePixel = 0, ZIndex = 20 }, h)
		make("Frame", { Size = UDim2.fromScale(0.14, 0.2), Position = UDim2.fromScale(0.64, 0.3), BackgroundColor3 = C.black, BorderSizePixel = 0, ZIndex = 20 }, h)
		f(UDim2.fromScale(0.4, 0.07), UDim2.fromScale(0.3, 0.7), C.black, 0.5, 20).Parent = h
	elseif key == "Frame" then
		f(UDim2.fromScale(0.74, 0.74), UDim2.fromScale(0.13, 0.13), Color3.fromRGB(120, 124, 136), 0.1)
		f(UDim2.fromScale(0.42, 0.42), UDim2.fromScale(0.29, 0.29), C.black, 0.08, 20)
	elseif key == "Height" then
		f(UDim2.fromScale(0.26, 0.8), UDim2.fromScale(0.37, 0.1), Color3.fromRGB(90, 200, 40), 0.12)
		for i = 1, 5 do f(UDim2.fromScale(i % 2 == 0 and 0.3 or 0.18, 0.04), UDim2.fromScale(0.37, 0.1 + i * 0.12), Color3.fromRGB(30, 80, 20), nil, 20) end
	else
		local t = f(UDim2.fromScale(0.62, 0.74), UDim2.fromScale(0.19, 0.13), Color3.fromRGB(190, 40, 36), 0.2)
		make("Frame", { Size = UDim2.fromScale(0.06, 0.8), Position = UDim2.fromScale(0.47, 0.1), BackgroundColor3 = Color3.fromRGB(90, 16, 16), BorderSizePixel = 0, ZIndex = 20 }, t)
		for i = 1, 3 do make("Frame", { Size = UDim2.fromScale(0.7, 0.05), Position = UDim2.fromScale(0.15, 0.2 + i * 0.17), BackgroundColor3 = Color3.fromRGB(90, 16, 16), BorderSizePixel = 0, ZIndex = 20 }, t) end
	end
end

local segs, valueLbls, rowFrames = {}, {}, {}
for i, r in ipairs(ROWS) do
	local row = S.panel(stats, { Size = UDim2.fromScale(0.62, 0.155), Position = UDim2.fromScale(0.04, 0.215 + (i - 1) * 0.17), color = C.panel, cols = 22, rows = 3, light = 0.04, z = 16, stroke = 3 })
	rowFrames[r.key] = row
	local box = S.panel(row, { Size = UDim2.fromScale(0.15, 0.8), Position = UDim2.fromScale(0.02, 0.1), color = C.brick, z = 17, stroke = 3 })
	icon(r.key, box)
	S.label(row, r.name, { Size = UDim2.fromScale(0.3, 0.34), Position = UDim2.fromScale(0.2, 0.08), xAlign = Enum.TextXAlignment.Left, z = 18 })
	if r.note then
		S.label(row, "(" .. r.note .. ")", { Size = UDim2.fromScale(0.3, 0.2), Position = UDim2.fromScale(0.42, 0.14), color = Color3.fromRGB(150, 154, 168), font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, stroke = false, z = 18 })
	end
	local back = make("Frame", { BackgroundColor3 = C.black, Size = UDim2.fromScale(0.5, 0.3), Position = UDim2.fromScale(0.2, 0.55), BorderSizePixel = 0, ZIndex = 17 }, row)
	make("UICorner", { CornerRadius = UDim.new(0.2, 0) }, back)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0.012, 0), VerticalAlignment = Enum.VerticalAlignment.Center, HorizontalAlignment = Enum.HorizontalAlignment.Center }, back)
	segs[r.key] = {}
	for k = 1, 10 do
		local sg = make("Frame", { Size = UDim2.fromScale(0.086, 0.7), BackgroundColor3 = Color3.fromRGB(40, 41, 50), BorderSizePixel = 0, ZIndex = 18, LayoutOrder = k }, back)
		make("UICorner", { CornerRadius = UDim.new(0.2, 0) }, sg)
		segs[r.key][k] = sg
	end
	local vb = S.panel(row, { Size = UDim2.fromScale(0.24, 0.5), Position = UDim2.fromScale(0.73, 0.25), color = C.brickDark, z = 17, stroke = 3 })
	valueLbls[r.key] = S.label(vb, "0 / 100", { Size = UDim2.fromScale(0.86, 0.6), Position = UDim2.fromScale(0.07, 0.2), z = 18 })
end

-- colonne droite : avatar, score, rang
S.panel(stats, { Size = UDim2.fromScale(0.27, 0.065), Position = UDim2.fromScale(0.69, 0.215), color = C.panel, z = 16, stroke = 3 })
S.label(stats, "YOUR AVATAR", { Size = UDim2.fromScale(0.24, 0.04), Position = UDim2.fromScale(0.705, 0.228), font = Enum.Font.GothamBold, z = 18 })
local avBox = S.panel(stats, { Size = UDim2.fromScale(0.27, 0.4), Position = UDim2.fromScale(0.69, 0.29), color = C.panel, cols = 12, rows = 10, light = 0.04, z = 16, stroke = 3 })
local vp = make("ViewportFrame", {
	BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 18, Ambient = Color3.fromRGB(170, 170, 185),
	LightColor = Color3.fromRGB(255, 240, 220), LightDirection = Vector3.new(-0.4, -0.6, -0.6),
}, avBox)
local vpCam = make("Camera", { FieldOfView = 40 }, vp)
vp.CurrentCamera = vpCam
local tierLbl = S.label(avBox, "SUB-5", { Size = UDim2.fromScale(0.9, 0.12), Position = UDim2.fromScale(0.05, 0.86), z = 19 })
local scorePanel = S.panel(stats, { Size = UDim2.fromScale(0.27, 0.185), Position = UDim2.fromScale(0.69, 0.7), color = C.panel, z = 16, stroke = 3 })
S.label(scorePanel, "MOG SCORE", { Size = UDim2.fromScale(0.8, 0.2), Position = UDim2.fromScale(0.1, 0.06), color = C.purple, font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, z = 18 })
local scoreLbl = S.label(scorePanel, "0", { Size = UDim2.fromScale(0.8, 0.25), Position = UDim2.fromScale(0.1, 0.26), xAlign = Enum.TextXAlignment.Left, z = 18 })
S.label(scorePanel, "RANK", { Size = UDim2.fromScale(0.5, 0.16), Position = UDim2.fromScale(0.1, 0.55), color = C.purple, font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, z = 18 })
make("Frame", { Size = UDim2.fromScale(0.1, 0.14), Position = UDim2.fromScale(0.1, 0.74), BackgroundColor3 = C.yellow, BorderSizePixel = 0, ZIndex = 18 }, scorePanel)
local rankLbl = S.label(scorePanel, "#1", { Size = UDim2.fromScale(0.6, 0.22), Position = UDim2.fromScale(0.24, 0.71), xAlign = Enum.TextXAlignment.Left, z = 18 })
local banner = S.panel(stats, { Size = UDim2.fromScale(0.62, 0.07), Position = UDim2.fromScale(0.04, 0.9), color = C.panel, z = 16, stroke = 3 })
make("Frame", { Size = UDim2.fromScale(0.03, 0.5), Position = UDim2.fromScale(0.03, 0.25), BackgroundColor3 = C.purple, BorderSizePixel = 0, ZIndex = 18 }, banner)
S.label(banner, "BUILD YOUR MOG. TRAIN EVERYTHING.", { Size = UDim2.fromScale(0.86, 0.6), Position = UDim2.fromScale(0.1, 0.2), color = Color3.fromRGB(200, 202, 214), stroke = false, z = 18 })

local statsOpen, avatarConn = false, nil

local function refreshStats(animate)
	for _, r in ipairs(ROWS) do
		local v = player:GetAttribute(r.key) or 0
		local filled = (r.key == "Bodyfat") and math.floor((100 - v) / 10 + 0.5) or math.floor(v / 10 + 0.5)
		valueLbls[r.key].Text = v .. " / 100"
		for k, sg in ipairs(segs[r.key]) do
			local on = k <= filled
			local target = on and r.color or Color3.fromRGB(40, 41, 50)
			if animate then
				task.delay((k - 1) * 0.045 + (table.find(ROWS, r) - 1) * 0.08, function()
					if not stats.Visible then return end
					tween(sg, 0.2, { BackgroundColor3 = target })
					if on then S.pop(sg, 1.5) end
				end)
			else
				sg.BackgroundColor3 = target
			end
		end
	end
	local tier = S.TIERS[player:GetAttribute("TierId") or 1]
	tierLbl.Text, tierLbl.TextColor3 = tier.name, tier.col
	scoreLbl.Text = tostring(player:GetAttribute("MogScore") or 0)
	rankLbl.Text = "#" .. tostring(player:GetAttribute("Rank") or 1)
end

local function buildAvatar()
	for _, c in ipairs(vp:GetChildren()) do
		if c:IsA("Model") then c:Destroy() end
	end
	local char = player.Character
	if not char then return end
	char.Archivable = true
	local ok, clone = pcall(function() return char:Clone() end)
	if not ok or not clone then return end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("ParticleEmitter") or d:IsA("Highlight") then d:Destroy() end
	end
	local hum = clone:FindFirstChildOfClass("Humanoid")
	if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
	clone:PivotTo(CFrame.new(0, 0, 0))
	clone.Parent = vp
	local cf, size = clone:GetBoundingBox()
	local center = cf.Position
	local dist = (size.Y * 0.5) / math.tan(math.rad(20)) * 1.2 + size.Z
	if avatarConn then avatarConn:Disconnect() end
	avatarConn = RunService.RenderStepped:Connect(function()
		local a = math.sin(os.clock() * 1.1) * 0.8
		vpCam.CFrame = CFrame.lookAt(center + Vector3.new(math.sin(a), 0.12, -math.cos(a)) * dist, center)
	end)
end

local function closeStats()
	if not statsOpen then return end
	statsOpen = false
	if avatarConn then avatarConn:Disconnect() avatarConn = nil end
	tween(statsScale, 0.25, { Scale = 0.5 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.delay(0.26, function() if not statsOpen then stats.Visible = false end end)
end

local function openStats()
	if statsOpen or busy or Battle.active then return end
	statsOpen = true
	stats.Visible = true
	statsScale.Scale = 0.5
	tween(statsScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	for _, r in ipairs(ROWS) do
		for _, sg in ipairs(segs[r.key]) do sg.BackgroundColor3 = Color3.fromRGB(40, 41, 50) end
	end
	refreshStats(true)
	buildAvatar()
	S.sfx("ping")
end
closeX.Activated:Connect(closeStats)
local menuBtn = S.button(stats, "MENU", { Size = UDim2.fromScale(0.27, 0.07), Position = UDim2.fromScale(0.69, 0.9), color = Color3.fromRGB(120, 56, 205), cols = 8, rows = 2, z = 20 })
menuBtn.Activated:Connect(function()
	closeStats()
	Menus.openHub()
end)

for _, k in ipairs({ "Face", "Frame", "Height", "Bodyfat", "MogScore", "Rank", "TierId" }) do
	player:GetAttributeChangedSignal(k):Connect(function()
		if statsOpen then
			refreshStats(false)
			if k == "Face" or k == "Frame" or k == "Height" or k == "Bodyfat" then S.pop(valueLbls[k], 1.4) end
		end
	end)
end

------------------------------------------------------------------
-- MENU MAP (teleportation)
------------------------------------------------------------------
local mapPanel
local function closeMap()
	if mapPanel then
		local m = mapPanel
		mapPanel = nil
		tween(m.UIScale, 0.2, { Scale = 0.3 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.delay(0.22, function() m:Destroy() end)
	end
end

local function openMap()
	if mapPanel or busy or Battle.active then return end
	mapPanel = S.panel(gui, { Name = "MapPanel", Size = UDim2.fromScale(0.46, 0.7), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), cols = 18, rows = 18, z = 20 })
	make("UIAspectRatioConstraint", { AspectRatio = 1.0 }, mapPanel)
	local sc = make("UIScale", { Scale = 0.4 }, mapPanel)
	tween(sc, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	S.title(mapPanel, "MOG MAP", UDim2.fromScale(0.6, 0.15), UDim2.fromScale(0.04, 0.03), C.blue)
	local x = S.button(mapPanel, "X", { Size = UDim2.fromScale(0.1, 0.1), Position = UDim2.fromScale(0.86, 0.03), color = C.red, cols = 3, rows = 3, textW = 0.7, textH = 0.7, z = 22 })
	make("UIAspectRatioConstraint", { AspectRatio = 1 }, x)
	x.Activated:Connect(closeMap)
	local list = {
		{ "FACE LAB", "face", C.pink }, { "IRON GYM", "frame", C.orange },
		{ "HEIGHT DOJO", "height", C.blue }, { "CARDIO CLUB", "bodyfat", Color3.fromRGB(60, 170, 90) },
		{ "ARENE", "arena", Color3.fromRGB(120, 60, 210) }, { "ZONES", "zones", Color3.fromRGB(60, 170, 120) },
		{ "TUTORIEL", "tuto", Color3.fromRGB(176, 130, 40) }, { "NIVEAUX", "tiers", Color3.fromRGB(150, 70, 110) },
	}
	for i, it in ipairs(list) do
		local col, row = (i - 1) % 2, math.floor((i - 1) / 2)
		local b = S.button(mapPanel, it[1], { Size = UDim2.fromScale(0.43, 0.14), Position = UDim2.fromScale(0.05 + col * 0.47, 0.24 + row * 0.17), color = it[3], cols = 9, rows = 3, z = 22 })
		b.Activated:Connect(function()
			closeMap()
			if it[2] == "tuto" then
				task.spawn(startTutorial, false)
			elseif it[2] == "tiers" then
				Tutorial.showTiers(gui)
			elseif it[2] == "zones" then
				Menus.openZones()
			else
				remotes.TeleportTo:FireServer(it[2])
			end
		end)
	end
end

------------------------------------------------------------------
-- 3 BOUTONS A DROITE
------------------------------------------------------------------
side = make("Frame", { Name = "SideButtons", BackgroundTransparency = 1, Size = UDim2.fromOffset(176, 270), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), ZIndex = 8 }, gui)
make("UIListLayout", { Padding = UDim.new(0, 14), HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, side)
local sideScale = make("UIScale", {}, side)
local function fitSide()
	local cam = Workspace.CurrentCamera
	if cam then sideScale.Scale = math.clamp(cam.ViewportSize.Y / 720, 0.65, 1.3) end
end
fitSide()
if Workspace.CurrentCamera then Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitSide) end

local btnStats = S.button(side, "STATS", { Size = UDim2.fromOffset(176, 78), color = C.red, cols = 10, rows = 4, z = 9, LayoutOrder = 1 })
local btnBattle = S.button(side, "BATTLE", { Size = UDim2.fromOffset(176, 78), color = Color3.fromRGB(120, 56, 205), cols = 10, rows = 4, z = 9, LayoutOrder = 2 })
local btnMap = S.button(side, "MAP", { Size = UDim2.fromOffset(176, 78), color = Color3.fromRGB(36, 96, 180), cols = 10, rows = 4, z = 9, LayoutOrder = 3 })

local function setSideVisible()
	side.Visible = not busy and not Battle.active
end

btnStats.Activated:Connect(function()
	if statsOpen then closeStats() else closeMap() openStats() end
end)
btnBattle.Activated:Connect(function()
	if busy or Battle.active then return end
	closeStats()
	closeMap()
	Battle.openMenu()
end)
btnMap.Activated:Connect(function()
	if mapPanel then closeMap() else closeStats() openMap() end
end)
Battle.onActive = function(on)
	if on then closeStats() closeMap() end
	setSideVisible()
end

UIS.InputBegan:Connect(function(i, gp)
	if gp or busy or Battle.active then return end
	if i.KeyCode == Enum.KeyCode.M then
		if statsOpen then closeStats() else closeMap() openStats() end
	elseif i.KeyCode == Enum.KeyCode.B then
		closeStats()
		closeMap()
		Battle.openMenu()
	elseif i.KeyCode == Enum.KeyCode.K then
		closeStats()
		closeMap()
		Menus.openHub()
	elseif i.KeyCode == Enum.KeyCode.T then
		if mapPanel then closeMap() else closeStats() openMap() end
	end
end)

------------------------------------------------------------------
-- STATIONS / MINI-JEUX
------------------------------------------------------------------
local frozen
local function freeze(on)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	if on then
		frozen = { ws = hum.WalkSpeed, jp = hum.JumpPower, jh = hum.JumpHeight }
		hum.WalkSpeed, hum.JumpPower, hum.JumpHeight = 0, 0, 0
	elseif frozen then
		hum.WalkSpeed, hum.JumpPower, hum.JumpHeight = frozen.ws, frozen.jp, frozen.jh
		frozen = nil
	end
end

remotes.OpenStation.OnClientEvent:Connect(function(station, token)
	if busy then return end
	busy = true
	closeStats()
	closeMap()
	setSideVisible()
	freeze(true)
	Minigames.run(gui, station, function(score)
		remotes.SubmitStation:FireServer(token, score)
	end, function()
		freeze(false)
		busy = false
		setSideVisible()
	end)
end)

remotes.StationResult.OnClientEvent:Connect(function(stat, gain, value)
	Minigames.showGain(stat, gain, value)
end)

startTutorial = function(first)
	if busy or Battle.active or Tutorial.running then return end
	busy = true
	closeStats()
	closeMap()
	setSideVisible()
	freeze(true)
	Tutorial.play(gui, {
		side = side,
		buttons = { { btnStats, "STATS : tes stats" }, { btnBattle, "BATTLE : duels" }, { btnMap, "MAP : teleportation" } },
	}, function()
		freeze(false)
		busy = false
		setSideVisible()
		if first then remotes.TutorialDone:FireServer() end
		toast("Objectif : va t'entrainer a une station (bouton MAP) !", "good")
	end)
end
remotes.Tutorial.OnClientEvent:Connect(function()
	task.spawn(startTutorial, true)
end)

Menus.init(gui, remotes, { toast = toast, isBusy = function() return busy or Battle.active or Tutorial.running end })
City.init()
toast("Bienvenue a MOG STREET ! Utilise les 3 boutons a droite (touche K : menu).", "info")
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">Studs</string><ProtectedString name="Source"><![CDATA[-- Studs : ModuleScript (enfant de MogClient) - UI style briques/studs + effets
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")

local M = {}
local C = {
	brick = Color3.fromRGB(58, 60, 68), brickDark = Color3.fromRGB(30, 31, 37), brickLight = Color3.fromRGB(88, 91, 102),
	red = Color3.fromRGB(176, 32, 30), redDark = Color3.fromRGB(110, 18, 18),
	purple = Color3.fromRGB(170, 70, 255), blue = Color3.fromRGB(40, 150, 255), green = Color3.fromRGB(110, 220, 50),
	orange = Color3.fromRGB(255, 110, 30), yellow = Color3.fromRGB(255, 214, 70), pink = Color3.fromRGB(255, 96, 130),
	white = Color3.fromRGB(236, 238, 244), black = Color3.fromRGB(14, 14, 18), panel = Color3.fromRGB(22, 23, 29),
}
M.C = C

M.Config = require(game:GetService("ReplicatedStorage"):WaitForChild("MogConfig"))
M.TIERS = M.Config.TIERS

local function make(class, props, parent)
	local i = Instance.new(class)
	for k, v in pairs(props) do i[k] = v end
	i.Parent = parent
	return i
end
M.make = make

function M.tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
local tween = M.tween

function M.sfx(name)
	local ids = { ping = "rbxasset://sounds/electronicpingshort.wav", hit = "rbxasset://sounds/swordslash.wav", ko = "rbxasset://sounds/uuhhh.mp3" }
	local gui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not gui or not ids[name] then return end
	local s = make("Sound", { SoundId = ids[name], Volume = 0.5 }, gui)
	s:Play()
	Debris:AddItem(s, 3)
end

-- grille de studs ronds qui remplit `parent`
function M.studs(parent, cols, rows, color, gap)
	gap = gap or 3
	local holder = make("Frame", { Name = "Studs", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Active = false, ZIndex = 1 }, parent)
	make("UIGridLayout", {
		CellSize = UDim2.new(1 / cols, -gap, 1 / rows, -gap), CellPadding = UDim2.fromOffset(gap, gap),
		SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center,
	}, holder)
	for i = 1, cols * rows do
		local s = make("Frame", { BackgroundColor3 = color, BorderSizePixel = 0, LayoutOrder = i, Active = false }, holder)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, s)
	end
	return holder
end

function M.panel(parent, p)
	local col = p.color or C.brick
	local f = make("Frame", {
		Name = p.Name or "Panel", Size = p.Size, Position = p.Position or UDim2.new(), AnchorPoint = p.AnchorPoint or Vector2.zero,
		BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = p.z or 1,
	}, parent)
	make("UICorner", { CornerRadius = UDim.new(0, p.radius or 8) }, f)
	make("UIStroke", { Color = p.strokeColor or C.brickDark, Thickness = p.stroke or 4 }, f)
	if p.cols then M.studs(f, p.cols, p.rows, col:Lerp(Color3.new(1, 1, 1), p.light or 0.09), p.gap or 3) end
	return f
end

function M.label(parent, text, p)
	p = p or {}
	local l = make("TextLabel", {
		Name = p.Name or "Label", BackgroundTransparency = 1, Text = text, Size = p.Size or UDim2.fromScale(1, 1),
		Position = p.Position or UDim2.new(), AnchorPoint = p.AnchorPoint or Vector2.zero, TextColor3 = p.color or C.white,
		TextScaled = true, Font = p.font or Enum.Font.GothamBlack, TextXAlignment = p.xAlign or Enum.TextXAlignment.Center,
		ZIndex = p.z or 2,
	}, parent)
	if p.stroke ~= false then
		make("UIStroke", { Color = p.strokeColor or Color3.new(0, 0, 0), Thickness = p.strokeThickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, l)
	end
	return l
end

-- titre "extrude" style lettres en briques
function M.title(parent, text, size, pos, color)
	local holder = make("Frame", { BackgroundTransparency = 1, Size = size, Position = pos, ZIndex = 3 }, parent)
	M.label(holder, text, { Position = UDim2.fromOffset(4, 6), color = Color3.fromRGB(16, 16, 20), stroke = false, z = 3 })
	M.label(holder, text, { color = color or Color3.fromRGB(150, 152, 162), strokeColor = Color3.fromRGB(24, 24, 28), strokeThickness = 3, z = 4 })
	return holder
end

function M.button(parent, text, p)
	local col = p.color or C.red
	local b = make("TextButton", {
		Name = p.Name or text, Text = "", AutoButtonColor = false, BackgroundColor3 = col, BorderSizePixel = 0,
		Size = p.Size, Position = p.Position or UDim2.new(), AnchorPoint = p.AnchorPoint or Vector2.zero, ZIndex = p.z or 2,
		LayoutOrder = p.LayoutOrder or 0,
	}, parent)
	make("UICorner", { CornerRadius = UDim.new(0, 7) }, b)
	make("UIStroke", { Color = col:Lerp(Color3.new(0, 0, 0), 0.65), Thickness = 3 }, b)
	M.studs(b, p.cols or 9, p.rows or 3, col:Lerp(Color3.new(1, 1, 1), 0.2), 2)
	M.label(b, text, { Size = UDim2.fromScale(p.textW or 0.86, p.textH or 0.52), Position = UDim2.fromScale((1 - (p.textW or 0.86)) / 2, (1 - (p.textH or 0.52)) / 2), z = 3 })
	local sc = make("UIScale", {}, b)
	b.MouseEnter:Connect(function() tween(sc, 0.12, { Scale = 1.06 }) end)
	b.MouseLeave:Connect(function() tween(sc, 0.12, { Scale = 1 }) end)
	b.MouseButton1Down:Connect(function() tween(sc, 0.08, { Scale = 0.93 }) end)
	b.MouseButton1Up:Connect(function() tween(sc, 0.12, { Scale = 1.06 }, Enum.EasingStyle.Back) end)
	return b
end

------------------------------------------------------------------
-- EFFETS
------------------------------------------------------------------
function M.pop(obj, s)
	local sc = obj:FindFirstChildOfClass("UIScale") or make("UIScale", {}, obj)
	sc.Scale = s or 1.35
	tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

function M.burst(parent, pos, color, count, dist)
	for _ = 1, count or 12 do
		local s = make("Frame", {
			Size = UDim2.fromOffset(math.random(6, 13), math.random(6, 13)), AnchorPoint = Vector2.new(0.5, 0.5),
			Position = pos, BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 50,
		}, parent)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, s)
		local a = math.random() * math.pi * 2
		local d = (dist or 90) * (0.4 + math.random() * 0.8)
		tween(s, 0.5 + math.random() * 0.3, { Position = pos + UDim2.fromOffset(math.cos(a) * d, math.sin(a) * d), BackgroundTransparency = 1, Size = UDim2.fromOffset(3, 3) })
		Debris:AddItem(s, 1.2)
	end
end

function M.shake(obj, mag, dur)
	local id = (obj:GetAttribute("_sh") or 0) + 1
	obj:SetAttribute("_sh", id)
	if obj:GetAttribute("_base") == nil then obj:SetAttribute("_base", obj.Position) end
	local base = obj:GetAttribute("_base")
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < dur and obj.Parent do
			if obj:GetAttribute("_sh") ~= id then return end
			local k = 1 - (os.clock() - t0) / dur
			obj.Position = base + UDim2.fromOffset(math.random(-mag, mag) * k, math.random(-mag, mag) * k)
			task.wait()
		end
		if obj.Parent and obj:GetAttribute("_sh") == id then
			obj.Position = base
			obj:SetAttribute("_base", nil)
		end
	end)
end

function M.flash(gui, color, alpha, dur)
	local f = make("Frame", { BackgroundColor3 = color, BackgroundTransparency = alpha or 0.5, Size = UDim2.fromScale(1, 1), ZIndex = 80, Active = false }, gui)
	tween(f, dur or 0.4, { BackgroundTransparency = 1 })
	Debris:AddItem(f, (dur or 0.4) + 0.1)
end

function M.stamp(parent, text, color, size, pos)
	local l = M.label(parent, text, {
		Size = size or UDim2.fromScale(0.5, 0.4), Position = pos or UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		color = color, z = 60, strokeThickness = 4,
	})
	local sc = make("UIScale", { Scale = 3 }, l)
	l.Rotation = -10
	l.TextTransparency = 1
	tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(l, 0.2, { TextTransparency = 0 })
	return l
end

function M.confetti(parent, n)
	local cols = { C.yellow, C.pink, C.blue, C.green, C.purple, C.orange }
	for i = 1, n or 40 do
		task.delay(math.random() * 0.8, function()
			if not parent.Parent then return end
			local s = make("Frame", {
				Size = UDim2.fromOffset(math.random(8, 14), math.random(8, 14)), AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(math.random(), -0.05), BackgroundColor3 = cols[math.random(1, #cols)], BorderSizePixel = 0, ZIndex = 70, Rotation = math.random(0, 90),
			}, parent)
			make("UICorner", { CornerRadius = UDim.new(0.3, 0) }, s)
			tween(s, 1.6 + math.random(), { Position = UDim2.fromScale(math.random(), 1.1), Rotation = math.random(-300, 300) }, Enum.EasingStyle.Sine)
			Debris:AddItem(s, 3)
		end)
	end
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Minigames</string><ProtectedString name="Source"><![CDATA[-- Minigames : ModuleScript (enfant de MogClient) - un mini-jeu par station
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local S = require(script.Parent.Studs)
local C, make, tween = S.C, S.make, S.tween

local M = {}
M.current = nil
local GAMES = {}

local INFO = {
	face = { title = "FACE LAB", sub = "TIMING - clique dans la zone verte", color = C.pink, hint = "CLIC / TAP / ESPACE pour valider", duration = 28 },
	frame = { title = "IRON GYM", sub = "SPAM pour soulever la barre", color = C.orange, hint = "TAPE le plus vite possible ! (CLIC / ESPACE)", duration = 20 },
	height = { title = "HEIGHT DOJO", sub = "MAINTIENS la barre dans la zone", color = C.blue, hint = "MAINTIENS CLIC / TAP / ESPACE pour monter", duration = 24 },
	bodyfat = { title = "CARDIO CLUB", sub = "ESQUIVE les haies - prends l'eau", color = C.green, hint = "TAP gauche / droite  -  A / D  -  fleches", duration = 22 },
}

local function grade(score)
	if score >= 0.9 then return "S", C.yellow end
	if score >= 0.7 then return "A", C.green end
	if score >= 0.45 then return "B", C.blue end
	return "C", Color3.fromRGB(190, 190, 205)
end

local function newShell(gui, info, onSubmit, onClose)
	local sh = { conns = {}, alive = true, info = info }
	local dim = make("Frame", { Name = "MiniGame", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 10, Active = true }, gui)
	tween(dim, 0.3, { BackgroundTransparency = 0.4 })
	local panel = S.panel(dim, { Size = UDim2.fromScale(0.66, 0.8), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), cols = 30, rows = 18, z = 11 })
	make("UIAspectRatioConstraint", { AspectRatio = 1.55 }, panel)
	local sc = make("UIScale", { Scale = 0.5 }, panel)
	tween(sc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	S.title(panel, info.title, UDim2.fromScale(0.56, 0.12), UDim2.fromScale(0.04, 0.02), info.color)
	S.label(panel, info.sub, { Size = UDim2.fromScale(0.5, 0.045), Position = UDim2.fromScale(0.05, 0.145), color = C.white, font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, z = 4 })
	local back = make("Frame", { BackgroundColor3 = C.panel, Size = UDim2.fromScale(0.9, 0.035), Position = UDim2.fromScale(0.05, 0.195), BorderSizePixel = 0, ZIndex = 4 }, panel)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, back)
	local fill = make("Frame", { BackgroundColor3 = info.color, Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, ZIndex = 5 }, back)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, fill)
	function sh.setTimer(frac)
		frac = math.clamp(frac, 0, 1)
		fill.Size = UDim2.fromScale(frac, 1)
		fill.BackgroundColor3 = info.color:Lerp(C.red, 1 - frac)
	end
	local arena = make("Frame", { Name = "Arena", BackgroundColor3 = C.panel, Size = UDim2.fromScale(0.92, 0.64), Position = UDim2.fromScale(0.04, 0.25), BorderSizePixel = 0, ZIndex = 4, ClipsDescendants = true }, panel)
	make("UICorner", { CornerRadius = UDim.new(0, 8) }, arena)
	make("UIStroke", { Color = C.brickDark, Thickness = 4 }, arena)
	S.studs(arena, 28, 12, Color3.fromRGB(30, 31, 38), 4).ZIndex = 4
	S.label(panel, info.hint, { Size = UDim2.fromScale(0.9, 0.05), Position = UDim2.fromScale(0.05, 0.915), color = Color3.fromRGB(190, 192, 205), font = Enum.Font.GothamBold, stroke = false, z = 4 })
	local x = S.button(panel, "X", { Size = UDim2.fromScale(0.07, 0.1), Position = UDim2.fromScale(0.91, 0.02), color = C.red, cols = 3, rows = 3, textW = 0.7, textH = 0.7, z = 12 })
	make("UIAspectRatioConstraint", { AspectRatio = 1 }, x)
	sh.dim, sh.panel, sh.arena = dim, panel, arena
	sh.started = os.clock()

	local function close()
		tween(dim, 0.3, { BackgroundTransparency = 1 })
		tween(sc, 0.3, { Scale = 0.2 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.delay(0.32, function()
			dim:Destroy()
			if M.current == sh then M.current = nil end
			onClose()
		end)
	end
	x.Activated:Connect(function()
		if not sh.alive then return end
		sh.alive = false
		for _, c in ipairs(sh.conns) do c:Disconnect() end
		onSubmit(-1)
		close()
	end)

	function sh.finish(score)
		if not sh.alive then return end
		sh.alive = false
		for _, c in ipairs(sh.conns) do c:Disconnect() end
		score = math.clamp(score, 0, 1)
		local g, col = grade(score)
		local ov = make("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 30, Active = true }, panel)
		make("UICorner", { CornerRadius = UDim.new(0, 8) }, ov)
		tween(ov, 0.3, { BackgroundTransparency = 0.3 })
		local st = S.stamp(panel, g, col, UDim2.fromScale(0.34, 0.5), UDim2.fromScale(0.5, 0.42))
		st.ZIndex = 40
		S.label(panel, "SCORE " .. math.floor(score * 100) .. "%", { Size = UDim2.fromScale(0.5, 0.08), Position = UDim2.fromScale(0.25, 0.68), color = C.white, z = 40 })
		sh.gain = S.label(panel, "...", { Size = UDim2.fromScale(0.7, 0.1), Position = UDim2.fromScale(0.15, 0.78), color = col, z = 40 })
		S.sfx("ping")
		S.burst(panel, UDim2.fromScale(0.5, 0.42), col, 26, 170)
		if score >= 0.9 then S.confetti(panel, 50) end
		S.shake(panel, 8, 0.4)
		onSubmit(score)
		task.delay(3.6, close)
	end
	M.current = sh
	return sh
end

local function tapArea(sh, z)
	return make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = z or 20 }, sh.arena)
end

local function key(sh, fn, ended)
	table.insert(sh.conns, UIS.InputBegan:Connect(function(i, gp)
		if i.UserInputType == Enum.UserInputType.Keyboard then fn(i.KeyCode, true) end
	end))
	table.insert(sh.conns, UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Keyboard then fn(i.KeyCode, false) end
	end))
end

local function corner(o, r) make("UICorner", { CornerRadius = UDim.new(r or 0.15, 0) }, o) end

------------------------------------------------------------------
-- FACE : timing + boutons qui disparaissent
------------------------------------------------------------------
GAMES.face = function(sh)
	local A = sh.arena
	local ROUNDS = 6
	local sick, healthy = Color3.fromRGB(150, 168, 100), Color3.fromRGB(238, 190, 150)
	local head = make("Frame", { Size = UDim2.fromScale(0.2, 0.62), Position = UDim2.fromScale(0.4, 0.04), BackgroundColor3 = sick, BorderSizePixel = 0, ZIndex = 6 }, A)
	corner(head, 0.16)
	make("UIStroke", { Color = Color3.fromRGB(20, 20, 24), Thickness = 4 }, head)
	for _, x in ipairs({ 0.22, 0.62 }) do
		local e = make("Frame", { Size = UDim2.fromScale(0.16, 0.11), Position = UDim2.fromScale(x, 0.3), BackgroundColor3 = C.black, BorderSizePixel = 0, ZIndex = 7 }, head)
		corner(e, 0.3)
	end
	local mouth = make("Frame", { Size = UDim2.fromScale(0.4, 0.06), Position = UDim2.fromScale(0.3, 0.72), BackgroundColor3 = C.black, BorderSizePixel = 0, ZIndex = 7 }, head)
	corner(mouth, 0.5)
	local pimples, cleared = {}, 0
	local spots = { { 0.12, 0.12 }, { 0.62, 0.1 }, { 0.4, 0.2 }, { 0.78, 0.45 }, { 0.08, 0.5 }, { 0.3, 0.55 }, { 0.62, 0.58 }, { 0.46, 0.84 } }
	for _, s in ipairs(spots) do
		local p = make("Frame", { Size = UDim2.fromScale(0.13, 0.1), Position = UDim2.fromScale(s[1], s[2]), BackgroundColor3 = Color3.fromRGB(200, 50, 50), BorderSizePixel = 0, ZIndex = 8 }, head)
		make("UIAspectRatioConstraint", { AspectRatio = 1 }, p)
		corner(p, 0.5)
		table.insert(pimples, p)
	end
	local track = make("Frame", { Size = UDim2.fromScale(0.9, 0.16), Position = UDim2.fromScale(0.05, 0.76), BackgroundColor3 = Color3.fromRGB(40, 42, 54), BorderSizePixel = 0, ZIndex = 6 }, A)
	corner(track, 0.2)
	make("UIStroke", { Color = C.brickDark, Thickness = 3 }, track)
	local zone = make("Frame", { Size = UDim2.fromScale(0.2, 1), BackgroundColor3 = Color3.fromRGB(70, 220, 120), BorderSizePixel = 0, ZIndex = 7 }, track)
	corner(zone, 0.15)
	local gold = make("Frame", { Size = UDim2.fromScale(0.3, 1), Position = UDim2.fromScale(0.35, 0), BackgroundColor3 = C.yellow, BorderSizePixel = 0, ZIndex = 8 }, zone)
	local cursor = make("Frame", { Size = UDim2.fromScale(0.012, 1.35), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 10 }, track)
	local fb = S.label(A, "", { Size = UDim2.fromScale(0.3, 0.12), Position = UDim2.fromScale(0.35, 0.62), color = C.yellow, z = 12 })
	local roundLbl = S.label(A, "ROUND 1/" .. ROUNDS, { Size = UDim2.fromScale(0.18, 0.08), Position = UDim2.fromScale(0.02, 0.03), color = C.white, xAlign = Enum.TextXAlignment.Left, z = 12 })

	local round, pos, dir, total, center, width, locked = 1, 0, 1, 0, 0.5, 0.22, false
	local function setup()
		width = 0.22 - 0.02 * (round - 1)
		center = 0.2 + math.random() * 0.6
		zone.Size = UDim2.fromScale(width, 1)
		zone.Position = UDim2.fromScale(center - width / 2, 0)
		S.pop(zone, 1.2)
		roundLbl.Text = "ROUND " .. round .. "/" .. ROUNDS
		locked = false
	end
	setup()
	local function hit()
		if not sh.alive or locked then return end
		locked = true
		local d = math.abs(pos - center)
		local val, txt, col, rem = 0, "RATE...", C.red, 0
		if d <= width / 2 * 0.3 then val, txt, col, rem = 1, "PERFECT !", C.yellow, 2
		elseif d <= width / 2 then val, txt, col, rem = 0.7, "GOOD", C.green, 1 end
		total += val
		fb.Text, fb.TextColor3 = txt, col
		S.pop(fb, 1.6)
		local bx = UDim2.fromScale(pos, 0.5)
		S.burst(track, bx, col, val > 0 and 16 or 6, 80)
		if val == 0 then S.shake(sh.panel, 6, 0.25) else S.sfx("ping") end
		for _ = 1, rem do
			cleared += 1
			local p = pimples[cleared]
			if p then
				S.burst(head, p.Position, C.white, 8, 60)
				tween(p, 0.3, { BackgroundTransparency = 1, Size = UDim2.fromScale(0, 0) })
			end
		end
		tween(head, 0.35, { BackgroundColor3 = sick:Lerp(healthy, math.min(1, cleared / 8)) })
		S.pop(head, 1.1)
		round += 1
		task.delay(0.55, function()
			if not sh.alive then return end
			if round > ROUNDS then sh.finish(total / ROUNDS) else fb.Text = "" setup() end
		end)
	end
	local tap = tapArea(sh)
	tap.Activated:Connect(hit)
	key(sh, function(k, down) if down and k == Enum.KeyCode.Space then hit() end end)
	table.insert(sh.conns, RunService.RenderStepped:Connect(function(dt)
		local el = os.clock() - sh.started
		sh.setTimer(1 - el / sh.info.duration)
		if el >= sh.info.duration then sh.finish(total / ROUNDS) return end
		local speed = 0.85 + 0.22 * round
		pos += dir * speed * dt
		if pos > 1 then pos, dir = 1, -1 elseif pos < 0 then pos, dir = 0, 1 end
		cursor.Position = UDim2.fromScale(pos, 0.5)
		gold.BackgroundTransparency = 0.15 + 0.15 * math.sin(el * 8)
	end))
end

------------------------------------------------------------------
-- FRAME : spam de tap pour soulever (reps)
------------------------------------------------------------------
GAMES.frame = function(sh)
	local A = sh.arena
	local GOAL = 8
	local meterBack = make("Frame", { Size = UDim2.fromScale(0.07, 0.8), Position = UDim2.fromScale(0.04, 0.1), BackgroundColor3 = Color3.fromRGB(40, 42, 54), BorderSizePixel = 0, ZIndex = 6 }, A)
	corner(meterBack, 0.2)
	make("UIStroke", { Color = C.brickDark, Thickness = 3 }, meterBack)
	local mfill = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0.25), BackgroundColor3 = C.orange, BorderSizePixel = 0, ZIndex = 7 }, meterBack)
	corner(mfill, 0.2)
	S.label(A, "POWER", { Size = UDim2.fromScale(0.1, 0.07), Position = UDim2.fromScale(0.025, 0.01), z = 8 })
	local reps = 0
	local repLbl = S.label(A, "REPS 0/" .. GOAL, { Size = UDim2.fromScale(0.28, 0.12), Position = UDim2.fromScale(0.68, 0.03), color = C.yellow, xAlign = Enum.TextXAlignment.Right, z = 12 })
	-- barre + disques
	local rig = make("Frame", { Size = UDim2.fromScale(0.6, 0.26), Position = UDim2.fromScale(0.22, 0.6), BackgroundTransparency = 1, ZIndex = 6 }, A)
	local sc = make("UIScale", {}, rig)
	local bar = make("Frame", { Size = UDim2.fromScale(1, 0.12), Position = UDim2.fromScale(0, 0.44), BackgroundColor3 = Color3.fromRGB(150, 156, 170), BorderSizePixel = 0, ZIndex = 7 }, rig)
	corner(bar, 0.5)
	for side = 0, 1 do
		for k, w in ipairs({ 0.075, 0.05, 0.03 }) do
			local x = side == 0 and (0.02 + (k - 1) * 0.085) or (0.98 - (k - 1) * 0.085 - w)
			local h = 1 - (k - 1) * 0.2
			local p = make("Frame", { Size = UDim2.fromScale(w, h), Position = UDim2.fromScale(x, (1 - h) / 2), BackgroundColor3 = k == 1 and Color3.fromRGB(190, 40, 40) or (k == 2 and Color3.fromRGB(40, 90, 200) or Color3.fromRGB(230, 200, 50)), BorderSizePixel = 0, ZIndex = 8 }, rig)
			corner(p, 0.12)
			make("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }, p)
		end
	end
	-- haltérophile (tete + corps)
	local body = make("Frame", { Size = UDim2.fromScale(0.07, 0.3), Position = UDim2.fromScale(0.465, 0.64), BackgroundColor3 = C.black, BorderSizePixel = 0, ZIndex = 5 }, A)
	corner(body, 0.2)
	local hd = make("Frame", { Size = UDim2.fromScale(0.05, 0.13), Position = UDim2.fromScale(0.475, 0.5), BackgroundColor3 = Color3.fromRGB(245, 205, 48), BorderSizePixel = 0, ZIndex = 5 }, A)
	corner(hd, 0.2)
	local fb = S.label(A, "", { Size = UDim2.fromScale(0.3, 0.14), Position = UDim2.fromScale(0.35, 0.2), color = C.yellow, z = 12 })

	local p, over = 0.25, false
	local function tapFn()
		if not sh.alive then return end
		p = math.min(1.05, p + 0.085)
		S.burst(A, UDim2.fromScale(0.5, 0.55), C.orange, 3, 50)
		tween(sc, 0.06, { Scale = 1.06 })
		task.delay(0.06, function() if sc.Parent then tween(sc, 0.1, { Scale = 1 }) end end)
	end
	local tap = tapArea(sh)
	tap.Activated:Connect(tapFn)
	key(sh, function(k, down) if down and k == Enum.KeyCode.Space then tapFn() end end)
	table.insert(sh.conns, RunService.RenderStepped:Connect(function(dt)
		local el = os.clock() - sh.started
		sh.setTimer(1 - el / sh.info.duration)
		local score = math.min(1, (reps + p * 0.5) / GOAL)
		if el >= sh.info.duration then sh.finish(score) return end
		if over then return end
		p = math.max(0, p - (0.32 + 0.045 * reps) * dt)
		if p >= 1 then
			reps += 1
			p = 0.3
			repLbl.Text = "REPS " .. reps .. "/" .. GOAL
			S.pop(repLbl, 1.5)
			fb.Text = "REP " .. reps .. " !"
			fb.TextColor3 = C.yellow
			S.pop(fb, 1.7)
			S.shake(sh.panel, 9, 0.3)
			S.burst(A, UDim2.fromScale(0.5, 0.3), C.yellow, 22, 140)
			S.flash(sh.panel, C.orange, 0.75, 0.3)
			S.sfx("hit")
			if reps >= GOAL then
				over = true
				task.delay(0.5, function() sh.finish(1) end)
			end
			task.delay(0.8, function() if fb.Parent then fb.Text = "" end end)
		end
		mfill.Size = UDim2.fromScale(1, math.clamp(p, 0, 1))
		mfill.BackgroundColor3 = C.orange:Lerp(C.red, math.clamp(p, 0, 1))
		rig.Position = UDim2.fromScale(0.22, 0.6 - 0.46 * math.clamp(p, 0, 1))
	end))
end

------------------------------------------------------------------
-- HEIGHT : garde la barre dans la zone, la tour grandit
------------------------------------------------------------------
GAMES.height = function(sh)
	local A = sh.arena
	local track = make("Frame", { Size = UDim2.fromScale(0.12, 0.9), Position = UDim2.fromScale(0.14, 0.05), BackgroundColor3 = Color3.fromRGB(40, 42, 54), BorderSizePixel = 0, ZIndex = 6 }, A)
	corner(track, 0.15)
	make("UIStroke", { Color = C.brickDark, Thickness = 3 }, track)
	for i = 1, 9 do
		make("Frame", { Size = UDim2.fromScale(0.35, 0.008), Position = UDim2.fromScale(0, i / 10), BackgroundColor3 = Color3.fromRGB(80, 84, 100), BorderSizePixel = 0, ZIndex = 6 }, track)
	end
	local TH, BH = 0.26, 0.2
	local zone = make("Frame", { Size = UDim2.fromScale(1, TH), BackgroundColor3 = Color3.fromRGB(70, 220, 120), BackgroundTransparency = 0.35, BorderSizePixel = 0, ZIndex = 7 }, track)
	corner(zone, 0.15)
	local barf = make("Frame", { Size = UDim2.fromScale(0.7, BH), Position = UDim2.fromScale(0.15, 0.7), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 9 }, track)
	corner(barf, 0.2)
	make("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 3 }, barf)
	S.label(A, "GRANDIS", { Size = UDim2.fromScale(0.3, 0.1), Position = UDim2.fromScale(0.55, 0.02), color = C.blue, z = 8 })
	local blocks = {}
	local N = 12
	local col = make("Frame", { Size = UDim2.fromScale(0.22, 0.86), Position = UDim2.fromScale(0.62, 0.1), BackgroundTransparency = 1, ZIndex = 6 }, A)
	local ground = make("Frame", { Size = UDim2.fromScale(1.6, 0.03), Position = UDim2.fromScale(-0.3, 0.97), BackgroundColor3 = Color3.fromRGB(70, 72, 86), BorderSizePixel = 0, ZIndex = 6 }, col)
	for i = 1, N do
		local b = make("Frame", {
			Size = UDim2.fromScale(1, 0.07), Position = UDim2.fromScale(0, 0.97 - i * 0.0735), BackgroundColor3 = C.blue:Lerp(C.purple, i / N),
			BorderSizePixel = 0, ZIndex = 7, Visible = false,
		}, col)
		corner(b, 0.2)
		make("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }, b)
		blocks[i] = b
	end
	local headF = make("Frame", { Size = UDim2.fromScale(0.5, 0.07), Position = UDim2.fromScale(0.25, 0.97 - 0.0735), BackgroundColor3 = Color3.fromRGB(245, 205, 48), BorderSizePixel = 0, ZIndex = 8 }, col)
	corner(headF, 0.2)
	make("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }, headF)
	local pct = S.label(A, "0%", { Size = UDim2.fromScale(0.2, 0.1), Position = UDim2.fromScale(0.34, 0.45), color = C.white, z = 12 })

	local py, vel, g, holding, shown = 0.7, 0, 0, false, 0
	local function setHold(v) holding = v end
	local tap = tapArea(sh)
	tap.MouseButton1Down:Connect(function() setHold(true) end)
	tap.MouseButton1Up:Connect(function() setHold(false) end)
	tap.MouseLeave:Connect(function() setHold(false) end)
	key(sh, function(k, down) if k == Enum.KeyCode.Space then setHold(down) end end)
	table.insert(sh.conns, RunService.RenderStepped:Connect(function(dt)
		local el = os.clock() - sh.started
		sh.setTimer(1 - el / sh.info.duration)
		if el >= sh.info.duration then sh.finish(g) return end
		vel += (holding and -3.4 or 2.6) * dt
		vel = math.clamp(vel, -1.1, 1.1)
		py += vel * dt
		if py < 0 then py, vel = 0, 0 elseif py > 1 - BH then py, vel = 1 - BH, 0 end
		local ty = (1 - TH) * (0.5 + 0.38 * math.sin(el * 0.85) + 0.12 * math.sin(el * 2.3 + 1))
		zone.Position = UDim2.fromScale(0, ty)
		barf.Position = UDim2.fromScale(0.15, py)
		local ov = py < ty + TH and py + BH > ty
		if ov then g = math.min(1, g + dt / 12) else g = math.max(0, g - dt / 30) end
		barf.BackgroundColor3 = ov and Color3.fromRGB(150, 255, 170) or Color3.fromRGB(255, 160, 160)
		zone.BackgroundTransparency = ov and 0.15 or 0.4
		pct.Text = math.floor(g * 100) .. "%"
		local n = math.floor(g * N)
		if n ~= shown then
			if n > shown then
				for i = shown + 1, n do
					blocks[i].Visible = true
					S.pop(blocks[i], 1.5)
					S.burst(col, UDim2.fromScale(0.5, 0.97 - i * 0.0735), C.blue, 6, 50)
				end
			else
				for i = n + 1, shown do blocks[i].Visible = false end
			end
			shown = n
			headF.Position = UDim2.fromScale(0.25, 0.97 - (n + 1) * 0.0735)
		end
		if g >= 1 then sh.finish(1) end
	end))
end

------------------------------------------------------------------
-- BODYFAT : cardio, 3 couloirs, haies et bouteilles d'eau
------------------------------------------------------------------
GAMES.bodyfat = function(sh)
	local A = sh.arena
	local LANES = { 0.32, 0.5, 0.68 }
	for i = 1, 3 do
		make("Frame", { Size = UDim2.fromScale(0.17, 1), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(LANES[i], 0), BackgroundColor3 = Color3.fromRGB(46, 50, 62), BorderSizePixel = 0, ZIndex = 5 }, A)
	end
	local strips = {}
	for i = 1, 9 do
		local s = make("Frame", { Size = UDim2.fromScale(0.55, 0.02), Position = UDim2.fromScale(0.225, (i - 1) / 9), BackgroundColor3 = Color3.fromRGB(80, 220, 130), BackgroundTransparency = 0.6, BorderSizePixel = 0, ZIndex = 5 }, A)
		strips[i] = s
	end
	local runner = make("Frame", { Size = UDim2.fromScale(0.07, 0.2), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(LANES[2], 0.8), BackgroundTransparency = 1, ZIndex = 10 }, A)
	make("UIAspectRatioConstraint", { AspectRatio = 0.7 }, runner)
	local rh = make("Frame", { Size = UDim2.fromScale(0.7, 0.38), Position = UDim2.fromScale(0.15, 0), BackgroundColor3 = Color3.fromRGB(245, 205, 48), BorderSizePixel = 0, ZIndex = 10 }, runner)
	corner(rh, 0.2)
	local rb = make("Frame", { Size = UDim2.fromScale(1, 0.62), Position = UDim2.fromScale(0, 0.38), BackgroundColor3 = C.black, BorderSizePixel = 0, ZIndex = 10 }, runner)
	corner(rb, 0.15)
	local score = S.label(A, "0", { Size = UDim2.fromScale(0.14, 0.1), Position = UDim2.fromScale(0.84, 0.03), color = C.green, z = 12 })
	local fb = S.label(A, "", { Size = UDim2.fromScale(0.3, 0.12), Position = UDim2.fromScale(0.35, 0.3), color = C.yellow, z = 12 })
	local lane, pts, items, spawnT = 2, 0, {}, 0
	local function setLane(l)
		lane = math.clamp(l, 1, 3)
		tween(runner, 0.1, { Position = UDim2.fromScale(LANES[lane], 0.8) })
	end
	local function addPts(n, txt, col)
		pts += n
		score.Text = tostring(math.max(0, pts))
		S.pop(score, 1.4)
		fb.Text, fb.TextColor3 = txt, col
		S.pop(fb, 1.5)
		task.delay(0.5, function() if fb.Parent then fb.Text = "" end end)
	end
	local left = make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(0.5, 1), ZIndex = 20 }, A)
	local right = make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(0.5, 1), Position = UDim2.fromScale(0.5, 0), ZIndex = 20 }, A)
	left.Activated:Connect(function() setLane(lane - 1) end)
	right.Activated:Connect(function() setLane(lane + 1) end)
	key(sh, function(k, down)
		if not down then return end
		if k == Enum.KeyCode.A or k == Enum.KeyCode.Left then setLane(lane - 1) end
		if k == Enum.KeyCode.D or k == Enum.KeyCode.Right then setLane(lane + 1) end
	end)
	table.insert(sh.conns, RunService.RenderStepped:Connect(function(dt)
		local el = os.clock() - sh.started
		sh.setTimer(1 - el / sh.info.duration)
		if el >= sh.info.duration then sh.finish(pts / 40) return end
		local v = 0.75 + el * 0.012
		for i, s in ipairs(strips) do
			local y = (s.Position.Y.Scale + v * dt) % 1
			s.Position = UDim2.fromScale(0.225, y)
		end
		runner.Rotation = math.sin(el * 16) * 4
		spawnT -= dt
		if spawnT <= 0 then
			spawnT = 0.55
			local l = math.random(1, 3)
			local water = math.random() < 0.3
			local f = make("Frame", { Size = UDim2.fromScale(water and 0.05 or 0.14, water and 0.1 or 0.07), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(LANES[l], -0.1), BackgroundColor3 = water and Color3.fromRGB(80, 190, 255) or Color3.fromRGB(230, 60, 60), BorderSizePixel = 0, ZIndex = 8 }, A)
			corner(f, water and 0.3 or 0.15)
			make("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }, f)
			table.insert(items, { f = f, lane = l, water = water, y = -0.1, done = false })
		end
		for i = #items, 1, -1 do
			local it = items[i]
			it.y += v * dt
			it.f.Position = UDim2.fromScale(LANES[it.lane], it.y)
			if not it.done and math.abs(it.y - 0.8) < 0.08 and it.lane == lane then
				it.done = true
				if it.water then
					addPts(2, "+2 EAU", C.blue)
					S.burst(A, it.f.Position, C.blue, 14, 80)
					it.f:Destroy()
					table.remove(items, i)
					continue
				else
					addPts(-2, "AIE !", C.red)
					S.shake(sh.panel, 8, 0.25)
					S.flash(sh.panel, C.red, 0.7, 0.3)
					S.burst(A, it.f.Position, C.red, 12, 80)
				end
			end
			if it.y > 0.92 and not it.done then
				it.done = true
				if not it.water then addPts(1, "+1", C.green) end
			end
			if it.y > 1.15 then
				it.f:Destroy()
				table.remove(items, i)
			end
		end
	end))
end

------------------------------------------------------------------
-- API
------------------------------------------------------------------
function M.run(gui, station, onSubmit, onClose)
	local info = INFO[station]
	if not info or not GAMES[station] then
		onSubmit(-1)
		onClose()
		return
	end
	local sh = newShell(gui, info, onSubmit, onClose)
	GAMES[station](sh)
end

function M.showGain(stat, gain, value, coins)
	local sh = M.current
	if not sh or not sh.gain or not sh.gain.Parent then return end
	if gain > 0 then
		sh.gain.Text = (stat == "Bodyfat" and "-" or "+") .. gain .. " " .. string.upper(stat) .. "  (" .. value .. "/100)  +" .. (coins or 0) .. " coins"
	else
		sh.gain.Text = "Pas de gain... reessaie !"
	end
	S.pop(sh.gain, 1.5)
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">BattleUI</string><ProtectedString name="Source"><![CDATA[-- BattleUI : ModuleScript (enfant de MogClient)
-- Combat 100 % calcule par le serveur : le client ne fait qu'afficher (menu, stats, manches, resume).
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local S = require(script.Parent.Studs)
local C, make, tween = S.C, S.make, S.tween

local M = {}
M.active = false
M.onActive = nil
local gui, remotes
local menu, hud, invitePanel, queuePanel
local state = {}

local TYPES = {
	{ "overall", "OVERALL BATTLE", "Toutes les stats a parts egales", Color3.fromRGB(120, 60, 210) },
	{ "full", "FULL MOG BATTLE", "Frame, bodyfat, taille et visage", Color3.fromRGB(176, 32, 30) },
	{ "style", "STYLE BATTLE", "Visage, silhouette, posture", Color3.fromRGB(200, 92, 112) },
	{ "face", "FACE BATTLE", "Seule la FACE compte", Color3.fromRGB(150, 70, 200) },
	{ "height", "HEIGHT BATTLE", "Seule la HEIGHT compte", Color3.fromRGB(40, 120, 180) },
}
local STATS = {
	{ "FACE", "Face", C.purple }, { "FRAME", "Frame", C.blue }, { "HEIGHT", "Height", C.green }, { "BODYFAT", "Bodyfat", C.orange },
}

------------------------------------------------------------------
-- CAMERA / FX 3D
------------------------------------------------------------------
local function camOn()
	local cam = Workspace.CurrentCamera
	state.shakeMag = 0
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 58
	if state.camConn then state.camConn:Disconnect() end
	state.camConn = RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local base = CFrame.lookAt(Vector3.new(math.sin(t * 0.35) * 7, 9.5, 22), Vector3.new(0, 5.4, 0))
		local m = state.shakeMag or 0
		local off = CFrame.new()
		if m > 0.01 then off = CFrame.new((math.random() - 0.5) * m, (math.random() - 0.5) * m, 0) end
		cam.CFrame = base * off
		state.shakeMag = m * 0.9
	end)
end

local function camOff()
	if state.camConn then state.camConn:Disconnect() state.camConn = nil end
	local cam = Workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = 70
end

local function ring(color)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CastShadow = true, false, false, false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = Vector3.new(2, 0.4, 2)
	p.CFrame = CFrame.new(0, 1.7, 0)
	p.Parent = Workspace
	S.tween(p, 0.7, { Size = Vector3.new(34, 0.4, 34), Transparency = 1 })
	Debris:AddItem(p, 1)
end

------------------------------------------------------------------
-- MENU (2 etapes : type de combat puis adversaire)
------------------------------------------------------------------
local function closeMenu()
	if menu then
		local m = menu
		menu = nil
		local sc = m:FindFirstChildOfClass("UIScale")
		if sc then tween(sc, 0.2, { Scale = 0.3 }, Enum.EasingStyle.Back, Enum.EasingDirection.In) end
		task.delay(0.22, function() m:Destroy() end)
	end
end

function M.openMenu()
	if menu or state.id then return end
	menu = S.panel(gui, { Name = "BattleMenu", Size = UDim2.fromScale(0.46, 0.78), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), cols = 18, rows = 20, z = 20 })
	make("UIAspectRatioConstraint", { AspectRatio = 0.92 }, menu)
	local sc = make("UIScale", { Scale = 0.4 }, menu)
	tween(sc, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	S.title(menu, "MOG BATTLE", UDim2.fromScale(0.74, 0.13), UDim2.fromScale(0.04, 0.02), C.purple)
	local x = S.button(menu, "X", { Size = UDim2.fromScale(0.1, 0.09), Position = UDim2.fromScale(0.86, 0.03), color = C.red, cols = 3, rows = 3, textW = 0.7, textH = 0.7, z = 6 })
	make("UIAspectRatioConstraint", { AspectRatio = 1 }, x)
	x.Activated:Connect(closeMenu)
	local body = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 6 }, menu)

	local function clear()
		for _, c in ipairs(body:GetChildren()) do c:Destroy() end
	end
	local step2
	local function step1()
		clear()
		S.label(body, "1. Choisis le type de combat", { Size = UDim2.fromScale(0.8, 0.045), Position = UDim2.fromScale(0.1, 0.17), font = Enum.Font.GothamBold, stroke = false, z = 7 })
		for i, t in ipairs(TYPES) do
			local b = S.button(body, t[2], { Size = UDim2.fromScale(0.84, 0.125), Position = UDim2.fromScale(0.08, 0.23 + (i - 1) * 0.15), color = t[4], cols = 14, rows = 4, textW = 0.9, textH = 0.4, z = 7 })
			S.label(b, t[3], { Size = UDim2.fromScale(0.9, 0.2), Position = UDim2.fromScale(0.05, 0.68), font = Enum.Font.GothamBold, stroke = false, z = 5 })
			b.Activated:Connect(function()
				remotes.BattleRequest:FireServer("TYPE", t[1])
				step2(t)
			end)
		end
	end
	step2 = function(t)
		clear()
		S.label(body, "2. Type : " .. t[2], { Size = UDim2.fromScale(0.8, 0.05), Position = UDim2.fromScale(0.1, 0.17), color = t[4]:Lerp(C.white, 0.5), z = 7 })
		local opts = {
			{ "MATCHMAKING", "Joueur de ton niveau (bot si personne)", "QUEUE", Color3.fromRGB(40, 130, 70) },
			{ "BOT DE MON NIVEAU", "Adversaire bot du meme rang", "BOT", Color3.fromRGB(176, 120, 30) },
			{ "DUEL JOUEUR PROCHE", "Invite le joueur le plus proche", "PVP", Color3.fromRGB(120, 60, 210) },
		}
		for i, o in ipairs(opts) do
			local b = S.button(body, o[1], { Size = UDim2.fromScale(0.84, 0.14), Position = UDim2.fromScale(0.08, 0.26 + (i - 1) * 0.19), color = o[4], cols = 14, rows = 4, textW = 0.9, textH = 0.4, z = 7 })
			S.label(b, o[2], { Size = UDim2.fromScale(0.9, 0.2), Position = UDim2.fromScale(0.05, 0.68), font = Enum.Font.GothamBold, stroke = false, z = 5 })
			b.Activated:Connect(function()
				remotes.BattleRequest:FireServer(o[3])
				closeMenu()
			end)
		end
		local back = S.button(body, "< RETOUR", { Size = UDim2.fromScale(0.4, 0.09), Position = UDim2.fromScale(0.3, 0.86), color = C.brickLight, cols = 8, rows = 3, z = 7 })
		back.Activated:Connect(step1)
	end
	step1()
end

local function showQueue(d)
	if queuePanel then queuePanel:Destroy() queuePanel = nil end
	if not d.on then return end
	local p = S.panel(gui, { Name = "Queue", Size = UDim2.fromScale(0.34, 0.15), Position = UDim2.fromScale(0.5, -0.25), AnchorPoint = Vector2.new(0.5, 0), cols = 14, rows = 5, z = 25 })
	queuePanel = p
	tween(p, 0.45, { Position = UDim2.fromScale(0.5, 0.04) }, Enum.EasingStyle.Back)
	S.label(p, "RECHERCHE D'ADVERSAIRE", { Size = UDim2.fromScale(0.92, 0.28), Position = UDim2.fromScale(0.04, 0.06), z = 26 })
	local sub = S.label(p, d.type or "", { Size = UDim2.fromScale(0.92, 0.2), Position = UDim2.fromScale(0.04, 0.34), font = Enum.Font.GothamBold, color = C.yellow, z = 26 })
	local cancel = S.button(p, "ANNULER", { Size = UDim2.fromScale(0.4, 0.3), Position = UDim2.fromScale(0.3, 0.62), color = C.red, cols = 6, rows = 2, z = 27 })
	cancel.Activated:Connect(function() remotes.BattleRequest:FireServer("LEAVE") end)
	task.spawn(function()
		local n = 0
		while p.Parent do
			n = (n % 3) + 1
			sub.Text = (d.type or "") .. string.rep(".", n)
			task.wait(0.4)
		end
	end)
end

------------------------------------------------------------------
-- HUD
------------------------------------------------------------------
local function hpColor(hp)
	if hp > 55 then return Color3.fromRGB(90, 230, 110) end
	if hp > 25 then return C.yellow end
	return C.red
end

local function makeCard(side, info)
	local tier = S.TIERS[info.tierId]
	local f = S.panel(hud, { Size = UDim2.fromScale(0.34, 0.13), Position = UDim2.fromScale(side == 1 and 0.02 or 0.64, 0.03), cols = 16, rows = 3, z = 5 })
	local xa = side == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right
	S.label(f, info.name, { Size = UDim2.fromScale(0.58, 0.36), Position = UDim2.fromScale(side == 1 and 0.04 or 0.38, 0.05), xAlign = xa, z = 6 })
	S.label(f, tier.name .. "  " .. info.score, { Size = UDim2.fromScale(0.36, 0.3), Position = UDim2.fromScale(side == 1 and 0.62 or 0.02, 0.08), color = tier.col, xAlign = side == 1 and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left, z = 6 })
	local back = make("Frame", { BackgroundColor3 = C.black, Size = UDim2.fromScale(0.92, 0.3), Position = UDim2.fromScale(0.04, 0.58), BorderSizePixel = 0, ZIndex = 6 }, f)
	make("UICorner", { CornerRadius = UDim.new(0.3, 0) }, back)
	local fill = make("Frame", {
		BackgroundColor3 = hpColor(100), Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, ZIndex = 7,
		AnchorPoint = side == 2 and Vector2.new(1, 0) or Vector2.zero, Position = side == 2 and UDim2.fromScale(1, 0) or UDim2.new(),
	}, back)
	make("UICorner", { CornerRadius = UDim.new(0.3, 0) }, fill)
	local txt = S.label(back, "100", { Size = UDim2.fromScale(0.3, 1), Position = UDim2.fromScale(0.35, 0), z = 8 })
	return { frame = f, fill = fill, txt = txt }
end

local function setHp(card, hp)
	tween(card.fill, 0.5, { Size = UDim2.fromScale(math.clamp(hp / 100, 0, 1), 1), BackgroundColor3 = hpColor(hp) })
	card.txt.Text = tostring(hp)
end

local function buildHud(d)
	hud = make("Frame", { Name = "BattleHUD", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5, Active = false }, gui)
	state.me = makeCard(1, d.me)
	state.opp = makeCard(2, d.opp)
	state.roundLbl = S.label(hud, d.type, { Size = UDim2.fromScale(0.24, 0.06), Position = UDim2.fromScale(0.38, 0.04), color = C.yellow, z = 6 })
	state.subLbl = S.label(hud, "", { Size = UDim2.fromScale(0.2, 0.045), Position = UDim2.fromScale(0.4, 0.105), font = Enum.Font.GothamBold, z = 6 })
end

local function clearHud()
	if hud then hud:Destroy() hud = nil end
	state.me, state.opp = nil, nil
end

------------------------------------------------------------------
-- ECRAN DE STATS AVANT LE COMBAT
------------------------------------------------------------------
local function statColumn(parent, side, info, rel)
	local tier = S.TIERS[info.tierId]
	local xpos = side == 1 and 0.04 or 0.58
	local col = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(0.38, 0.62), Position = UDim2.fromScale(side == 1 and -0.5 or 1.2, 0.3), ZIndex = 44 }, parent)
	tween(col, 0.7, { Position = UDim2.fromScale(xpos, 0.3) }, Enum.EasingStyle.Back)
	S.label(col, info.name, { Size = UDim2.fromScale(1, 0.12), color = C.white, z = 45 })
	S.label(col, tier.name, { Size = UDim2.fromScale(0.6, 0.1), Position = UDim2.fromScale(0.2, 0.12), color = tier.col, z = 45 })
	S.label(col, "MOG SCORE " .. info.score, { Size = UDim2.fromScale(0.7, 0.07), Position = UDim2.fromScale(0.15, 0.23), color = Color3.fromRGB(190, 192, 205), font = Enum.Font.GothamBold, stroke = false, z = 45 })
	for i, st in ipairs(STATS) do
		local v = info.stats[st[2]]
		local fillv = (st[2] == "Bodyfat") and (100 - v) or v
		local y = 0.34 + (i - 1) * 0.16
		local row = make("Frame", { BackgroundColor3 = C.panel, Size = UDim2.fromScale(1, 0.13), Position = UDim2.fromScale(0, y), BorderSizePixel = 0, ZIndex = 45 }, col)
		make("UICorner", { CornerRadius = UDim.new(0.2, 0) }, row)
		if rel[st[2]] then make("UIStroke", { Color = C.yellow, Thickness = 3 }, row) end
		S.label(row, st[1], { Size = UDim2.fromScale(0.26, 0.6), Position = UDim2.fromScale(0.03, 0.2), color = st[3], xAlign = Enum.TextXAlignment.Left, z = 46 })
		local back = make("Frame", { BackgroundColor3 = C.black, Size = UDim2.fromScale(0.5, 0.4), Position = UDim2.fromScale(0.3, 0.3), BorderSizePixel = 0, ZIndex = 46 }, row)
		make("UICorner", { CornerRadius = UDim.new(0.4, 0) }, back)
		local fill = make("Frame", { BackgroundColor3 = st[3], Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, ZIndex = 47 }, back)
		make("UICorner", { CornerRadius = UDim.new(0.4, 0) }, fill)
		local num = S.label(row, "0", { Size = UDim2.fromScale(0.15, 0.6), Position = UDim2.fromScale(0.83, 0.2), z = 46 })
		task.delay(0.8 + i * 0.18, function()
			if not fill.Parent then return end
			tween(fill, 0.7, { Size = UDim2.fromScale(math.clamp(fillv / 100, 0, 1), 1) })
			local t0 = os.clock()
			while os.clock() - t0 < 0.7 and num.Parent do
				num.Text = tostring(math.floor(v * (os.clock() - t0) / 0.7))
				task.wait()
			end
			if num.Parent then num.Text = tostring(v) S.pop(num, 1.3) end
		end)
	end
	return col
end

local function showVersus(d)
	local dim = make("Frame", { Name = "Versus", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 40, Active = true }, gui)
	tween(dim, 0.4, { BackgroundTransparency = 0.25 })
	local p = S.panel(dim, { Size = UDim2.fromScale(0.9, 0.82), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), cols = 40, rows = 22, z = 41 })
	make("UIAspectRatioConstraint", { AspectRatio = 1.75 }, p)
	S.title(p, d.type, UDim2.fromScale(0.6, 0.14), UDim2.fromScale(0.2, 0.02), C.yellow)
	S.label(p, d.desc .. "  (stats surlignees = celles qui comptent)", { Size = UDim2.fromScale(0.7, 0.05), Position = UDim2.fromScale(0.15, 0.17), font = Enum.Font.GothamBold, stroke = false, z = 44 })
	statColumn(p, 1, d.me, d.rel)
	statColumn(p, 2, d.opp, d.rel)
	local vs = S.stamp(p, "VS", C.red, UDim2.fromScale(0.16, 0.2), UDim2.fromScale(0.5, 0.5))
	vs.ZIndex = 50
	local cd = S.label(p, "", { Size = UDim2.fromScale(0.5, 0.06), Position = UDim2.fromScale(0.25, 0.93), font = Enum.Font.GothamBold, color = C.yellow, z = 44 })
	S.sfx("ping")
	task.spawn(function()
		for i = 4, 1, -1 do
			if not cd.Parent then return end
			cd.Text = "Le combat commence dans " .. i .. "..."
			task.wait(1)
		end
		if dim.Parent then
			tween(dim, 0.4, { BackgroundTransparency = 1 })
			for _, c in ipairs(dim:GetDescendants()) do
				if c:IsA("TextLabel") then tween(c, 0.3, { TextTransparency = 1 }) end
			end
			task.delay(0.4, function() dim:Destroy() end)
		end
	end)
end

------------------------------------------------------------------
-- MANCHES (calculees par le serveur)
------------------------------------------------------------------
local function startRound(d)
	if not hud then return end
	state.subLbl.Text = "MANCHE " .. d.round .. "/" .. d.total
	S.pop(state.subLbl, 1.5)
	local banner = S.stamp(hud, d.label, C.white, UDim2.fromScale(0.5, 0.18), UDim2.fromScale(0.5, 0.45))
	S.sfx("ping")
	task.delay(1.2, function()
		if banner.Parent then
			tween(banner, 0.3, { TextTransparency = 1 })
			task.delay(0.3, function() banner:Destroy() end)
		end
	end)
end

local function resultCard(parent, x, who, d, won)
	local f = S.panel(parent, { Size = UDim2.fromScale(0.27, 0.92), Position = UDim2.fromScale(x < 0.5 and -0.3 or 1.3, 0.04), AnchorPoint = Vector2.new(0.5, 0), cols = 10, rows = 7, color = C.brick:Lerp(C.black, 0.3), z = 41 })
	S.label(f, who, { Size = UDim2.fromScale(0.9, 0.14), Position = UDim2.fromScale(0.05, 0.03), font = Enum.Font.GothamBold, z = 43 })
	S.label(f, "STAT", { Size = UDim2.fromScale(0.4, 0.09), Position = UDim2.fromScale(0.3, 0.17), color = Color3.fromRGB(190, 192, 205), font = Enum.Font.GothamBold, stroke = false, z = 43 })
	local val = S.label(f, "0", { Size = UDim2.fromScale(0.6, 0.26), Position = UDim2.fromScale(0.2, 0.26), color = C.white, z = 43 })
	local luck = S.label(f, "", { Size = UDim2.fromScale(0.8, 0.1), Position = UDim2.fromScale(0.1, 0.55), font = Enum.Font.GothamBold, z = 43 })
	local pw = S.label(f, "", { Size = UDim2.fromScale(0.8, 0.2), Position = UDim2.fromScale(0.1, 0.68), color = C.yellow, z = 43 })
	tween(f, 0.5, { Position = UDim2.fromScale(x, 0.04) }, Enum.EasingStyle.Back)
	task.spawn(function()
		task.wait(0.45)
		local t0 = os.clock()
		while os.clock() - t0 < 0.6 and val.Parent do
			val.Text = tostring(math.floor(d.value * (os.clock() - t0) / 0.6))
			task.wait()
		end
		if not val.Parent then return end
		val.Text = tostring(d.value)
		S.pop(val, 1.3)
		task.wait(0.5)
		if not luck.Parent then return end
		luck.Text = "CHANCE " .. (d.luck >= 0 and "+" or "") .. d.luck .. "%"
		luck.TextColor3 = d.luck >= 0 and Color3.fromRGB(90, 230, 110) or C.red
		pw.Text = "PUISSANCE " .. d.power
		S.pop(pw, 1.3)
	end)
	return f
end

local function showResult(r)
	if not hud then return end
	local band = make("Frame", { BackgroundColor3 = C.black, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 0.4), Position = UDim2.fromScale(0, 0.28), ZIndex = 40, BorderSizePixel = 0 }, hud)
	tween(band, 0.25, { BackgroundTransparency = 0.3 })
	local cMe = resultCard(band, 0.22, "TOI", r.me)
	local cOpp = resultCard(band, 0.78, "ADVERSAIRE", r.opp)
	S.label(band, r.label, { Size = UDim2.fromScale(0.26, 0.2), Position = UDim2.fromScale(0.37, 0.15), color = C.yellow, z = 44 })
	S.label(band, "MANCHE " .. r.round .. "/" .. r.total, { Size = UDim2.fromScale(0.2, 0.1), Position = UDim2.fromScale(0.4, 0.38), font = Enum.Font.GothamBold, z = 44 })
	task.wait(2.1)
	local win = r.winner
	local wc = (win == "me") and cMe or ((win == "opp") and cOpp or nil)
	if wc then make("UIStroke", { Color = C.yellow, Thickness = 5 }, wc) end
	ring(win == "me" and Color3.fromRGB(80, 200, 255) or (win == "opp" and Color3.fromRGB(255, 70, 90) or Color3.fromRGB(255, 220, 90)))
	S.sfx("hit")
	state.shakeMag = 3.5
	if win == "me" then
		S.flash(gui, Color3.fromRGB(80, 200, 255), 0.7, 0.4)
		local d = S.stamp(hud, "-" .. r.damage, C.red, UDim2.fromScale(0.18, 0.14), UDim2.fromScale(0.8, 0.2))
		S.burst(hud, UDim2.fromScale(0.8, 0.09), C.red, 18, 120)
		S.shake(state.opp.frame, 10, 0.4)
		task.delay(1.1, function() d:Destroy() end)
	elseif win == "opp" then
		S.flash(gui, Color3.fromRGB(255, 60, 70), 0.6, 0.45)
		local d = S.stamp(hud, "-" .. r.damage, C.red, UDim2.fromScale(0.18, 0.14), UDim2.fromScale(0.2, 0.2))
		S.burst(hud, UDim2.fromScale(0.2, 0.09), C.red, 18, 120)
		S.shake(state.me.frame, 10, 0.4)
		state.shakeMag = 5
		task.delay(1.1, function() d:Destroy() end)
	else
		local d = S.stamp(hud, "EGALITE", C.yellow, UDim2.fromScale(0.3, 0.14), UDim2.fromScale(0.5, 0.22))
		task.delay(1.1, function() d:Destroy() end)
	end
	setHp(state.me, r.me.hp)
	setHp(state.opp, r.opp.hp)
	task.wait(1.3)
	band:Destroy()
end

------------------------------------------------------------------
-- RESUME DU COMBAT
------------------------------------------------------------------
local function finishBattle()
	clearHud()
	camOff()
	state.id = nil
	M.active = false
	if M.onActive then M.onActive(false) end
end

local function showEnd(d)
	if not hud then return end
	local win = d.result == "win"
	local col = win and C.yellow or C.red
	S.flash(gui, col, 0.5, 0.6)
	S.sfx(win and "ping" or "ko")
	state.shakeMag = win and 2 or 7
	local st = S.stamp(hud, win and "VICTOIRE !" or "DEFAITE...", col, UDim2.fromScale(0.5, 0.2), UDim2.fromScale(0.5, 0.4))
	if win then S.confetti(hud, 80) end
	task.wait(2)
	st:Destroy()
	local p = S.panel(hud, { Name = "Summary", Size = UDim2.fromScale(0.64, 0.7), Position = UDim2.fromScale(0.5, 1.2), AnchorPoint = Vector2.new(0.5, 0.5), cols = 28, rows = 20, z = 60 })
	make("UIAspectRatioConstraint", { AspectRatio = 1.3 }, p)
	tween(p, 0.55, { Position = UDim2.fromScale(0.5, 0.52) }, Enum.EasingStyle.Back)
	S.title(p, win and "VICTOIRE" or "DEFAITE", UDim2.fromScale(0.6, 0.15), UDim2.fromScale(0.2, 0.02), col)
	S.label(p, d.type .. " - pourquoi ?", { Size = UDim2.fromScale(0.8, 0.06), Position = UDim2.fromScale(0.1, 0.18), color = Color3.fromRGB(190, 192, 205), font = Enum.Font.GothamBold, z = 62 })
	for i, line in ipairs(d.lines) do
		local row = make("Frame", { BackgroundColor3 = C.panel, Size = UDim2.fromScale(0.9, 0.15), Position = UDim2.fromScale(0.05, 0.26 + (i - 1) * 0.17), BorderSizePixel = 0, ZIndex = 62 }, p)
		make("UICorner", { CornerRadius = UDim.new(0.15, 0) }, row)
		local l = S.label(row, line, { Size = UDim2.fromScale(0.94, 0.8), Position = UDim2.fromScale(0.03, 0.1), font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, stroke = false, z = 63 })
		l.TextWrapped = true
		row.BackgroundTransparency = 1
		l.TextTransparency = 1
		task.delay(0.4 + i * 0.3, function()
			if row.Parent then
				tween(row, 0.3, { BackgroundTransparency = 0 })
				tween(l, 0.3, { TextTransparency = 0 })
			end
		end)
	end
	if d.reward ~= "" then
		local rw = S.label(p, "RECOMPENSE : " .. d.reward, { Size = UDim2.fromScale(0.6, 0.07), Position = UDim2.fromScale(0.05, 0.84), color = Color3.fromRGB(90, 230, 110), xAlign = Enum.TextXAlignment.Left, z = 62 })
		task.delay(1.6, function() if rw.Parent then S.pop(rw, 1.5) end end)
	end
	local ok = S.button(p, "CONTINUER", { Size = UDim2.fromScale(0.3, 0.1), Position = UDim2.fromScale(0.66, 0.84), color = Color3.fromRGB(40, 130, 70), cols = 8, rows = 3, z = 64 })
	local closed = false
	local function close()
		if closed then return end
		closed = true
		finishBattle()
	end
	ok.Activated:Connect(close)
	task.delay(9, close)
end

------------------------------------------------------------------
-- INVITATION DUEL
------------------------------------------------------------------
local function showInvite(name, id)
	if invitePanel then invitePanel:Destroy() end
	invitePanel = S.panel(gui, { Name = "Invite", Size = UDim2.fromScale(0.34, 0.2), Position = UDim2.fromScale(0.5, -0.3), AnchorPoint = Vector2.new(0.5, 0), cols = 14, rows = 6, z = 25 })
	local p = invitePanel
	tween(p, 0.45, { Position = UDim2.fromScale(0.5, 0.04) }, Enum.EasingStyle.Back)
	S.label(p, name .. " te defie !", { Size = UDim2.fromScale(0.92, 0.3), Position = UDim2.fromScale(0.04, 0.07), z = 26 })
	local ok = S.button(p, "ACCEPTER", { Size = UDim2.fromScale(0.44, 0.36), Position = UDim2.fromScale(0.04, 0.52), color = Color3.fromRGB(40, 150, 70), cols = 6, rows = 3, z = 27 })
	local no = S.button(p, "REFUSER", { Size = UDim2.fromScale(0.44, 0.36), Position = UDim2.fromScale(0.52, 0.52), color = C.red, cols = 6, rows = 3, z = 27 })
	local function reply(a)
		remotes.BattleInviteReply:FireServer(id, a)
		if p.Parent then
			tween(p, 0.3, { Position = UDim2.fromScale(0.5, -0.3) })
			task.delay(0.35, function() p:Destroy() end)
		end
	end
	ok.Activated:Connect(function() reply(true) end)
	no.Activated:Connect(function() reply(false) end)
	task.delay(12, function() if p.Parent then reply(false) end end)
end

------------------------------------------------------------------
-- INIT
------------------------------------------------------------------
function M.init(g, rem)
	gui, remotes = g, rem
	remotes.BattleInvite.OnClientEvent:Connect(showInvite)
	remotes.BattleState.OnClientEvent:Connect(function(event, d)
		if event == "menu" then
			M.openMenu()
		elseif event == "queue" then
			showQueue(d)
		elseif event == "start" then
			closeMenu()
			showQueue({ on = false })
			clearHud()
			state.id = d.id
			M.active = true
			if M.onActive then M.onActive(true) end
			buildHud(d)
			camOn()
			showVersus(d)
		elseif event == "round" then
			task.spawn(startRound, d)
		elseif event == "result" then
			task.spawn(showResult, d)
		elseif event == "end" then
			task.spawn(showEnd, d)
		end
	end)
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[-- Tutorial : ModuleScript (enfant de MogClient) - cinematique d'introduction + fiche des niveaux
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local S = require(script.Parent.Studs)
local C, make, tween = S.C, S.make, S.tween

local M = {}
M.running = false

local function corner(o, r) make("UICorner", { CornerRadius = UDim.new(r or 0.2, 0) }, o) end

------------------------------------------------------------------
-- FICHE DES NIVEAUX (SUB-5 -> CHAD)
------------------------------------------------------------------
function M.buildTierCard(parent, pos, size, animate)
	local card = S.panel(parent, { Name = "TierCard", Size = size, Position = pos, cols = 16, rows = 20, z = 110 })
	S.title(card, "NIVEAUX", UDim2.fromScale(0.7, 0.11), UDim2.fromScale(0.15, 0.02), C.yellow)
	for i = 1, 6 do
		local t = S.TIERS[i]
		local y = 0.16 + (i - 1) * 0.138
		local row = make("Frame", { BackgroundColor3 = C.panel, Size = UDim2.fromScale(0.92, 0.12), Position = UDim2.fromScale(0.04, y), BorderSizePixel = 0, ZIndex = 112 }, card)
		corner(row, 0.15)
		make("UIStroke", { Color = t.col, Thickness = 2 }, row)
		make("Frame", { BackgroundColor3 = t.col, Size = UDim2.fromScale(0.035, 0.8), Position = UDim2.fromScale(0.02, 0.1), BorderSizePixel = 0, ZIndex = 113 }, row)
		S.label(row, t.name, { Size = UDim2.fromScale(0.45, 0.5), Position = UDim2.fromScale(0.08, 0.06), color = t.col, xAlign = Enum.TextXAlignment.Left, z = 114 })
		S.label(row, "RARETE " .. t.rarity, { Size = UDim2.fromScale(0.4, 0.4), Position = UDim2.fromScale(0.57, 0.08), color = C.white, font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Right, z = 114 })
		S.label(row, t.desc, { Size = UDim2.fromScale(0.88, 0.32), Position = UDim2.fromScale(0.08, 0.6), color = Color3.fromRGB(176, 180, 194), font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, stroke = false, z = 114 })
		if animate then
			row.Position = UDim2.fromScale(1.2, y)
			task.delay(0.4 + (i - 1) * 0.3, function()
				if row.Parent then
					tween(row, 0.5, { Position = UDim2.fromScale(0.04, y) }, Enum.EasingStyle.Back)
					S.sfx("ping")
				end
			end)
		end
	end
	return card
end

function M.showTiers(gui)
	if gui:FindFirstChild("TierPopup") then return end
	local pop = make("Frame", { Name = "TierPopup", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.fromScale(1, 1), ZIndex = 30, Active = true }, gui)
	local card = M.buildTierCard(pop, UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.42, 0.88), false)
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	make("UIAspectRatioConstraint", { AspectRatio = 0.82 }, card)
	local sc = make("UIScale", { Scale = 0.5 }, card)
	tween(sc, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	local x = S.button(card, "X", { Size = UDim2.fromScale(0.1, 0.08), Position = UDim2.fromScale(0.86, 0.02), color = C.red, cols = 3, rows = 3, textW = 0.7, textH = 0.7, z = 120 })
	make("UIAspectRatioConstraint", { AspectRatio = 1 }, x)
	x.Activated:Connect(function() pop:Destroy() end)
end

------------------------------------------------------------------
-- CINEMATIQUE
------------------------------------------------------------------
local function typeText(label, text, speed)
	local token = (label:GetAttribute("tt") or 0) + 1
	label:SetAttribute("tt", token)
	label.Text = text
	label.MaxVisibleGraphemes = 0
	local n = utf8.len(text) or #text
	task.spawn(function()
		for i = 1, n do
			if not label.Parent or label:GetAttribute("tt") ~= token then return end
			label.MaxVisibleGraphemes = i
			task.wait(speed or 0.03)
		end
	end)
end

local function orbit(c, r, h, a0, a1, ly)
	return function(a)
		local ang = a0 + (a1 - a0) * a
		return c + Vector3.new(math.sin(ang) * r, h, math.cos(ang) * r), c + Vector3.new(0, ly or 5, 0)
	end
end

local function line(p0, l0, p1, l1)
	return function(a) return p0:Lerp(p1, a), l0:Lerp(l1, a) end
end

local function buildShots(spawnPos)
	local T = S.TIERS
	return {
		{
			dur = 8.5, fov = { 74, 58 }, focus = 120, title = true,
			cap = "Bienvenue a MOG STREET. Ici, tout se joue sur une seule chose : le mog.",
			f = line(Vector3.new(0, 165, 205), Vector3.new(0, 10, 0), Vector3.new(0, 62, 132), Vector3.new(0, 8, 22)),
		},
		{
			dur = 8, fov = { 64, 56 }, focus = 70,
			cap = "Ton visage, ta carrure, ta taille, ton physique : chaque stat change vraiment ton apparence.",
			f = line(Vector3.new(0, 5, 112), Vector3.new(0, 9, 0), Vector3.new(0, 6.5, 50), Vector3.new(0, 9, -6)),
		},
		{
			dur = 7.5, fov = { 66, 54 }, focus = 38, chip = { "FRAME", Color3.fromRGB(214, 112, 48) },
			cap = "IRON GYM : souleve de la fonte pour gagner de la FRAME.",
			f = orbit(Vector3.new(-58, 5, -22), 34, 13, 0.2, 1.2, 6),
		},
		{
			dur = 7.5, fov = { 66, 54 }, focus = 38, chip = { "FACE", Color3.fromRGB(200, 92, 112) },
			cap = "FACE LAB : soigne ta peau, fais disparaitre les boutons, deviens beau.",
			f = orbit(Vector3.new(58, 5, -22), 34, 13, -1.2, -0.2, 6),
		},
		{
			dur = 7.5, fov = { 64, 54 }, focus = 38, chip = { "HEIGHT", Color3.fromRGB(70, 150, 200) },
			cap = "HEIGHT DOJO : etire-toi, grandis, et ton personnage prendra de la taille.",
			f = orbit(Vector3.new(-58, 5, 22), 34, 13, math.pi - 1.0, math.pi + 0.1, 6),
		},
		{
			dur = 7.5, fov = { 66, 54 }, focus = 38, chip = { "BODYFAT", Color3.fromRGB(80, 170, 110) },
			cap = "CARDIO CLUB : cours, esquive, et perds ton bodyfat pour afficher des abdos.",
			f = orbit(Vector3.new(58, 5, 22), 34, 13, math.pi + 1.0, math.pi - 0.1, 6),
		},
		{
			dur = 8, fov = { 68, 56 }, focus = 55,
			cap = "Au centre : l'arene. Defie des bots ou d'autres joueurs en Mog Battle.",
			f = orbit(Vector3.new(0, 4, 0), 40, 15, 0, 2.4, 6),
		},
		{
			dur = 11, fov = { 62, 54 }, focus = 75, tiers = true,
			cap = "Des bots de tous les niveaux se promenent en ville, du SUB-5 au CHAD. Plus ils sont forts, plus ils sont rares. Mog-les tous !",
			f = line(Vector3.new(0, 5, 78), Vector3.new(0, 7, 0), Vector3.new(0, 6, 64), Vector3.new(0, 7, 0)),
		},
		{
			dur = 11, fov = { 60, 52 }, focus = 22, buttons = true,
			cap = "Tes 3 boutons : STATS pour suivre ton evolution, BATTLE pour les duels, MAP pour te teleporter. A toi de monter jusqu'a CHAD !",
			f = function(a)
				return spawnPos + Vector3.new(0, 4.6 - 1.2 * a, 15 - 5 * a), spawnPos + Vector3.new(0, 3, 0)
			end,
		},
	}
end

function M.play(gui, ui, onDone)
	if M.running then return end
	M.running = true
	local player = Players.LocalPlayer
	local cam = Workspace.CurrentCamera
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local SHOTS = buildShots(hrp and hrp.Position or Vector3.new(0, 4, 118))
	local skipped = false

	local dof = make("DepthOfFieldEffect", { Name = "TutoDoF", FarIntensity = 0.3, NearIntensity = 0, FocusDistance = 60, InFocusRadius = 30 }, Lighting)
	local cc = make("ColorCorrectionEffect", { Name = "TutoCC", Contrast = 0.1, Saturation = 0.1, TintColor = Color3.fromRGB(255, 244, 230) }, Lighting)
	local blur = make("BlurEffect", { Name = "TutoBlur", Size = 18 }, Lighting)

	local root = make("Frame", { Name = "Cinematic", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 100, Active = true }, gui)
	local barT = make("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 0.12), Position = UDim2.fromScale(0, -0.12), BorderSizePixel = 0, ZIndex = 3 }, root)
	local barB = make("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 0.12), Position = UDim2.fromScale(0, 1), BorderSizePixel = 0, ZIndex = 3 }, root)
	tween(barT, 0.9, { Position = UDim2.fromScale(0, 0) })
	tween(barB, 0.9, { Position = UDim2.fromScale(0, 0.88) })
	local chapter = S.label(root, "", { Size = UDim2.fromScale(0.3, 0.05), Position = UDim2.fromScale(0.03, 0.035), color = Color3.fromRGB(210, 212, 224), font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, z = 6 })
	local skipBtn = S.button(root, "PASSER", { Size = UDim2.fromScale(0.12, 0.06), Position = UDim2.fromScale(0.85, 0.03), color = C.brick, cols = 6, rows = 2, z = 8 })
	skipBtn.Activated:Connect(function() skipped = true end)
	local cap = S.panel(root, { Size = UDim2.fromScale(0.64, 0.14), Position = UDim2.fromScale(0.18, 0.745), cols = 30, rows = 5, color = C.panel, z = 5 })
	S.label(cap, "NARRATEUR", { Size = UDim2.fromScale(0.2, 0.2), Position = UDim2.fromScale(0.03, 0.06), color = C.yellow, font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, z = 7 })
	local capLbl = S.label(cap, "", { Size = UDim2.fromScale(0.94, 0.6), Position = UDim2.fromScale(0.03, 0.3), font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, stroke = false, z = 7 })
	capLbl.TextWrapped = true
	local fade = make("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 1), ZIndex = 50, BorderSizePixel = 0 }, root)

	local conns, extras = {}, {}
	local chip

	local function cleanup()
		for _, c in ipairs(conns) do c:Disconnect() end
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = 70
		if hum then cam.CameraSubject = hum end
		dof:Destroy()
		cc:Destroy()
		blur:Destroy()
		root:Destroy()
		if ui.side then ui.side.Visible = false end
		for _, o in ipairs(extras) do if o.Parent then o:Destroy() end end
	end

	local ok, err = pcall(function()
		cam.CameraType = Enum.CameraType.Scriptable
		task.wait(0.4)
		for i, shot in ipairs(SHOTS) do
			if skipped then break end
			chapter.Text = string.format("%02d / %02d   MOG STREET", i, #SHOTS)
			typeText(capLbl, shot.cap, 0.032)
			if chip then chip:Destroy() chip = nil end
			if shot.chip then
				chip = S.panel(root, { Size = UDim2.fromScale(0.2, 0.09), Position = UDim2.fromScale(-0.3, 0.16), cols = 10, rows = 3, color = C.panel, z = 6 })
				S.label(chip, shot.chip[1], { Size = UDim2.fromScale(0.86, 0.6), Position = UDim2.fromScale(0.07, 0.2), color = shot.chip[2], z = 8 })
				tween(chip, 0.6, { Position = UDim2.fromScale(0.03, 0.16) }, Enum.EasingStyle.Back)
			end
			if shot.title then
				local grp = make("CanvasGroup", { BackgroundTransparency = 1, Size = UDim2.fromScale(0.8, 0.4), Position = UDim2.fromScale(0.1, 0.22), ZIndex = 4, GroupTransparency = 1 }, root)
				S.title(grp, "MOG STREET", UDim2.fromScale(1, 0.62), UDim2.fromScale(0, 0), C.yellow)
				S.label(grp, "LA VILLE DES MOGGERS", { Size = UDim2.fromScale(0.6, 0.14), Position = UDim2.fromScale(0.2, 0.66), font = Enum.Font.GothamBold, z = 6 })
				task.delay(0.8, function() if grp.Parent then tween(grp, 0.9, { GroupTransparency = 0 }) end end)
				task.delay(6.2, function() if grp.Parent then tween(grp, 0.9, { GroupTransparency = 1 }) task.delay(1, function() grp:Destroy() end) end end)
			end
			local card
			if shot.tiers then
				card = M.buildTierCard(root, UDim2.fromScale(0.62, 0.15), UDim2.fromScale(0.35, 0.58), true)
			end
			local marks = {}
			if shot.buttons and ui.side then
				ui.side.Visible = true
				task.wait()
				for _, e in ipairs(ui.buttons) do
					local b = e[1]
					local ap, asz = b.AbsolutePosition, b.AbsoluteSize
					local hl = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(asz.X + 14, asz.Y + 14), Position = UDim2.fromOffset(ap.X - 7, ap.Y - 7), ZIndex = 20 }, root)
					corner(hl, 0.15)
					local st = make("UIStroke", { Color = C.yellow, Thickness = 4 }, hl)
					local tx = S.label(root, e[2], { Size = UDim2.fromOffset(330, 36), Position = UDim2.fromOffset(ap.X - 346, ap.Y + asz.Y / 2 - 18), color = C.yellow, xAlign = Enum.TextXAlignment.Right, z = 20 })
					table.insert(marks, hl)
					table.insert(marks, tx)
					table.insert(conns, RunService.RenderStepped:Connect(function()
						st.Transparency = 0.5 + 0.5 * math.sin(os.clock() * 6)
					end))
				end
			end
			dof.FocusDistance = shot.focus or 50
			fade.BackgroundTransparency = 0
			tween(fade, 0.8, { BackgroundTransparency = 1 })
			tween(blur, 0.8, { Size = 0 })
			S.sfx("ping")
			local t0, outDone = os.clock(), false
			while not skipped do
				local a = (os.clock() - t0) / shot.dur
				if a >= 1 then break end
				local e = a * a * (3 - 2 * a)
				local pos, look = shot.f(e)
				local n = os.clock() * 0.7
				local sh = CFrame.new(math.noise(n, 1) * 0.18, math.noise(n, 5) * 0.18, 0) * CFrame.Angles(math.noise(n, 9) * 0.006, math.noise(n, 13) * 0.006, 0)
				cam.CFrame = CFrame.lookAt(pos, look) * sh
				cam.FieldOfView = shot.fov[1] + (shot.fov[2] - shot.fov[1]) * a
				if not outDone and a > 1 - 0.7 / shot.dur then
					outDone = true
					tween(fade, 0.65, { BackgroundTransparency = 0 })
					tween(blur, 0.65, { Size = 16 })
				end
				RunService.RenderStepped:Wait()
			end
			if card then card:Destroy() end
			for _, o in ipairs(marks) do o:Destroy() end
			if shot.buttons and ui.side then ui.side.Visible = false end
		end
		tween(barT, 0.6, { Position = UDim2.fromScale(0, -0.12) })
		tween(barB, 0.6, { Position = UDim2.fromScale(0, 1) })
		fade.BackgroundTransparency = 0
		task.wait(0.7)
	end)
	if not ok then warn("Tutorial: " .. tostring(err)) end
	cleanup()
	M.running = false
	if onDone then onDone(not skipped) end
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Menus</string><ProtectedString name="Source"><![CDATA[-- Menus : ModuleScript (enfant de MogClient)
-- Face Lab (apercu avant/apres), boutique, quetes, titres/succes, classements, prestige, zones,
-- recompense quotidienne, pieces, evenements, effets (photo, zone, ascension).
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")
local S = require(script.Parent.Studs)
local C, make, tween = S.C, S.make, S.tween
local Config = S.Config
local FaceShared = require(RS:WaitForChild("FaceShared"))

local M = {}
local player = Players.LocalPlayer
local gui, remotes, ctx, Req
local cur -- fenetre ouverte

local function corner(o, r) make("UICorner", { CornerRadius = UDim.new(r or 0.15, 0) }, o) end
local function attrJSON(name)
	local ok, t = pcall(function() return HttpService:JSONDecode(player:GetAttribute(name) or "{}") end)
	return ok and type(t) == "table" and t or {}
end
local function req(action, a, b)
	local ok, res = pcall(function() return Req:InvokeServer(action, a, b) end)
	return ok and res or { ok = false, msg = "Erreur reseau" }
end

------------------------------------------------------------------
-- FENETRE MODALE
------------------------------------------------------------------
local function closeCur()
	if not cur then return end
	local c = cur
	cur = nil
	for _, cn in ipairs(c.conns) do cn:Disconnect() end
	tween(c.sc, 0.2, { Scale = 0.4 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	tween(c.dim, 0.2, { BackgroundTransparency = 1 })
	task.delay(0.22, function() c.dim:Destroy() end)
end
M.close = closeCur

local function modal(title, color, w, h, aspect)
	closeCur()
	local dim = make("Frame", { Name = "MenuModal", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 30, Active = true }, gui)
	tween(dim, 0.25, { BackgroundTransparency = 0.45 })
	local panel = S.panel(dim, { Size = UDim2.fromScale(w, h), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), cols = 34, rows = 22, z = 31 })
	make("UIAspectRatioConstraint", { AspectRatio = aspect }, panel)
	local sc = make("UIScale", { Scale = 0.5 }, panel)
	tween(sc, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	S.title(panel, title, UDim2.fromScale(0.6, 0.11), UDim2.fromScale(0.03, 0.02), color)
	local x = S.button(panel, "X", { Size = UDim2.fromScale(0.07, 0.09), Position = UDim2.fromScale(0.91, 0.025), color = C.red, cols = 3, rows = 3, textW = 0.7, textH = 0.7, z = 40 })
	make("UIAspectRatioConstraint", { AspectRatio = 1 }, x)
	x.Activated:Connect(closeCur)
	cur = { dim = dim, panel = panel, sc = sc, conns = {} }
	return cur
end

local function listFrame(parent, size, pos)
	local sf = make("ScrollingFrame", {
		Size = size, Position = pos, BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 40,
	}, parent)
	make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, sf)
	return sf
end
local function row(sf, h, order, col)
	local r = make("Frame", { Size = UDim2.new(1, -10, 0, h), BackgroundColor3 = col or C.panel, BorderSizePixel = 0, LayoutOrder = order or 0, ZIndex = 41 }, sf)
	corner(r, 0.12)
	make("UIStroke", { Color = C.brickDark, Thickness = 2 }, r)
	return r
end
local function lbl(parent, text, size, pos, color, xa, font)
	return S.label(parent, text, { Size = size, Position = pos, color = color or C.white, xAlign = xa or Enum.TextXAlignment.Left, font = font, z = 45 })
end
local function bar(parent, pos, size, frac, color)
	local b = make("Frame", { BackgroundColor3 = C.black, Position = pos, Size = size, BorderSizePixel = 0, ZIndex = 44 }, parent)
	corner(b, 0.5)
	local f = make("Frame", { BackgroundColor3 = color, Size = UDim2.fromScale(math.clamp(frac, 0, 1), 1), BorderSizePixel = 0, ZIndex = 45 }, b)
	corner(f, 0.5)
	return f
end
local function mbtn(parent, text, size, pos, color)
	return S.button(parent, text, { Size = size, Position = pos, color = color, cols = 6, rows = 2, z = 46 })
end

------------------------------------------------------------------
-- FACE LAB
------------------------------------------------------------------
local function faceViewport(parent, lv)
	local vp = make("ViewportFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.black, BackgroundTransparency = 0.25, ZIndex = 44,
		Ambient = Color3.fromRGB(170, 170, 185), LightColor = Color3.fromRGB(255, 240, 220), LightDirection = Vector3.new(-0.4, -0.5, -0.7),
	}, parent)
	corner(vp, 0.08)
	local cam = make("Camera", { FieldOfView = 30 }, vp)
	vp.CurrentCamera = cam
	local model = make("Model", {}, vp)
	local hs = Vector3.new(1.2, 1.2, 1.2)
	local sk = lv.Skin or 0
	local skin = Color3.fromRGB(184, 170, 118):Lerp(Color3.fromRGB(228, 178, 140), math.clamp(0.35 + 0.13 * sk, 0, 1))
	local hair = Color3.fromRGB(32, 24, 20)
	local function p(size, cf, color, shape, mat)
		make("Part", { Size = size, CFrame = cf, Anchored = true, Color = color, Shape = shape or Enum.PartType.Block, Material = mat or Enum.Material.SmoothPlastic, CanCollide = false }, model)
	end
	p(hs, CFrame.new(), skin)
	p(Vector3.new(hs.X * 1.06, hs.Y * 0.3, hs.Z * 1.06), CFrame.new(0, hs.Y * 0.5, 0), hair)
	for _, sp in ipairs(FaceShared.specs(table.clone(lv), hs, skin, hair)) do
		p(sp.size, sp.off, sp.color, sp.shape, sp.mat)
	end
	local r = Random.new(5)
	for _ = 1, math.max(0, 8 - 2 * sk) do
		p(Vector3.one * 0.1, CFrame.new(r:NextNumber(-0.45, 0.45), r:NextNumber(-0.3, 0.35), -hs.Z * 0.5), Color3.fromRGB(190, 55, 55), Enum.PartType.Ball)
	end
	local conn = RunService.RenderStepped:Connect(function()
		local a = math.sin(os.clock() * 1.1) * 0.55
		cam.CFrame = CFrame.lookAt(Vector3.new(math.sin(a) * 3.3, 0.1, -math.cos(a) * 3.3), Vector3.new(0, -0.05, 0))
	end)
	return vp, conn
end

function M.openFaceLab()
	local w = modal("FACE LAB", C.pink, 0.9, 0.88, 1.65)
	local P = w.panel
	local sale = req("shop_list").sale and 0.7 or 1
	local selected = 1
	local coinsLbl = S.label(P, "", { Size = UDim2.fromScale(0.25, 0.07), Position = UDim2.fromScale(0.62, 0.035), color = C.yellow, xAlign = Enum.TextXAlignment.Right, z = 45 })
	local listArea = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(0.56, 0.78), Position = UDim2.fromScale(0.03, 0.16), ZIndex = 40 }, P)
	local sf = listFrame(listArea, UDim2.fromScale(1, 1), UDim2.new())
	local right = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(0.36, 0.78), Position = UDim2.fromScale(0.62, 0.16), ZIndex = 40 }, P)
	local vconns = {}
	local function clearV()
		for _, cn in ipairs(vconns) do cn:Disconnect() end
		vconns = {}
		for _, c in ipairs(right:GetChildren()) do c:Destroy() end
	end
	local refresh
	local function price(f, lv) return math.floor(Config.featPrice(f, lv) * sale) end

	local function buildRight()
		clearV()
		local lv = attrJSON("FeatJSON")
		for _, f in ipairs(Config.FEATURES) do lv[f.id] = lv[f.id] or 0 end
		local f = Config.FEATURES[selected]
		local cl = lv[f.id]
		S.label(right, "AVANT", { Size = UDim2.fromScale(0.47, 0.06), Position = UDim2.fromScale(0, 0), font = Enum.Font.GothamBold, z = 45 })
		S.label(right, "APRES", { Size = UDim2.fromScale(0.47, 0.06), Position = UDim2.fromScale(0.53, 0), font = Enum.Font.GothamBold, color = C.green, z = 45 })
		local a = make("Frame", { Size = UDim2.fromScale(0.47, 0.42), Position = UDim2.fromScale(0, 0.07), BackgroundTransparency = 1, ZIndex = 42 }, right)
		local b = make("Frame", { Size = UDim2.fromScale(0.47, 0.42), Position = UDim2.fromScale(0.53, 0.07), BackgroundTransparency = 1, ZIndex = 42 }, right)
		local _, c1 = faceViewport(a, lv)
		local after = table.clone(lv)
		after[f.id] = math.min(Config.MAXLV, cl + 1)
		local _, c2 = faceViewport(b, after)
		vconns = { c1, c2 }
		S.label(right, f.name, { Size = UDim2.fromScale(1, 0.09), Position = UDim2.fromScale(0, 0.52), color = C.white, z = 45 })
		S.label(right, f.desc, { Size = UDim2.fromScale(1, 0.07), Position = UDim2.fromScale(0, 0.61), color = Color3.fromRGB(190, 192, 205), font = Enum.Font.GothamBold, stroke = false, z = 45 })
		if cl >= Config.MAXLV then
			S.label(right, "NIVEAU MAXIMUM", { Size = UDim2.fromScale(1, 0.1), Position = UDim2.fromScale(0, 0.74), color = C.yellow, z = 45 })
		else
			S.label(right, string.format("NIVEAU %d -> %d   |   PRIX %d   |   +%d FACE", cl, cl + 1, price(f, cl), f.pts), { Size = UDim2.fromScale(1, 0.07), Position = UDim2.fromScale(0, 0.69), color = C.yellow, z = 45 })
			local buy = mbtn(right, "AMELIORER", UDim2.fromScale(0.8, 0.13), UDim2.fromScale(0.1, 0.8), Color3.fromRGB(40, 140, 70))
			buy.Activated:Connect(function()
				local res = req("feat_buy", f.id)
				if res.ok then
					S.flash(gui, C.pink, 0.7, 0.5)
					S.burst(right, UDim2.fromScale(0.75, 0.3), C.pink, 26, 150)
					S.shake(P, 8, 0.35)
					S.sfx("ping")
					ctx.toast(string.format("%s niveau %d ! +%d FACE", f.name, res.level, res.pts), "good")
				else
					ctx.toast(res.msg or "Impossible", "bad")
					S.shake(buy, 6, 0.25)
				end
			end)
		end
	end

	refresh = function()
		coinsLbl.Text = "COINS " .. (player:GetAttribute("Coins") or 0)
		local lv = attrJSON("FeatJSON")
		for _, c in ipairs(sf:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		for i, f in ipairs(Config.FEATURES) do
			local l = lv[f.id] or 0
			local r = row(sf, 76, i, (i == selected) and C.brick or C.panel)
			lbl(r, f.name, UDim2.fromScale(0.4, 0.3), UDim2.fromScale(0.03, 0.08))
			lbl(r, "LV " .. l .. " / " .. Config.MAXLV, UDim2.fromScale(0.2, 0.26), UDim2.fromScale(0.43, 0.1), C.pink, Enum.TextXAlignment.Left)
			for k = 1, Config.MAXLV do
				make("Frame", { Size = UDim2.fromScale(0.05, 0.14), Position = UDim2.fromScale(0.04 + (k - 1) * 0.06, 0.46), BackgroundColor3 = (k <= l) and C.pink or Color3.fromRGB(46, 47, 58), BorderSizePixel = 0, ZIndex = 45 }, r)
			end
			bar(r, UDim2.fromScale(0.04, 0.72), UDim2.fromScale(0.36, 0.12), l / Config.MAXLV, C.purple)
			if l < Config.MAXLV then
				lbl(r, price(f, l) .. " c", UDim2.fromScale(0.2, 0.28), UDim2.fromScale(0.43, 0.42), C.yellow)
				lbl(r, "+" .. f.pts .. " FACE", UDim2.fromScale(0.2, 0.24), UDim2.fromScale(0.43, 0.7), C.green)
			else
				lbl(r, "MAX", UDim2.fromScale(0.2, 0.4), UDim2.fromScale(0.43, 0.4), C.yellow)
			end
			local sel = make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(0.7, 1), ZIndex = 50 }, r)
			sel.Activated:Connect(function()
				selected = i
				refresh()
				buildRight()
			end)
		end
	end
	refresh()
	buildRight()
	for _, n in ipairs({ "Coins", "FeatJSON" }) do
		table.insert(w.conns, player:GetAttributeChangedSignal(n):Connect(function()
			if cur ~= w then return end
			refresh()
			if n == "FeatJSON" then buildRight() end
		end))
	end
	table.insert(w.conns, { Disconnect = clearV })
end

------------------------------------------------------------------
-- BOUTIQUE
------------------------------------------------------------------
function M.openShop(zoneId)
	local w = modal("BOUTIQUE", C.yellow, 0.7, 0.86, 1.1)
	local P = w.panel
	local coinsLbl = S.label(P, "", { Size = UDim2.fromScale(0.3, 0.07), Position = UDim2.fromScale(0.6, 0.035), color = C.yellow, xAlign = Enum.TextXAlignment.Right, z = 45 })
	local sf = listFrame(P, UDim2.fromScale(0.94, 0.78), UDim2.fromScale(0.03, 0.16))
	local function refresh()
		coinsLbl.Text = "COINS " .. (player:GetAttribute("Coins") or 0)
		local res = req("shop_list")
		for _, c in ipairs(sf:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		if not res.ok then return end
		if res.sale then
			local r = row(sf, 40, 0, C.red)
			lbl(r, "FLASH SALE : -30% !", UDim2.fromScale(0.9, 0.7), UDim2.fromScale(0.05, 0.15), C.white, Enum.TextXAlignment.Center)
		end
		for i, it in ipairs(res.items) do
			local r = row(sf, 70, i)
			lbl(r, it.name, UDim2.fromScale(0.5, 0.34), UDim2.fromScale(0.03, 0.08))
			lbl(r, it.desc, UDim2.fromScale(0.5, 0.24), UDim2.fromScale(0.03, 0.46), Color3.fromRGB(190, 192, 205), nil, Enum.Font.GothamBold)
			lbl(r, it.zone .. " (niv. " .. it.req .. ")", UDim2.fromScale(0.5, 0.2), UDim2.fromScale(0.03, 0.74), Color3.fromRGB(150, 154, 170), nil, Enum.Font.GothamBold)
			if it.locked then
				lbl(r, "VERROUILLE", UDim2.fromScale(0.3, 0.4), UDim2.fromScale(0.66, 0.3), C.red, Enum.TextXAlignment.Center)
			elseif it.owned then
				if it.kind == "hair" then
					local eq = mbtn(r, "EQUIPER", UDim2.fromScale(0.3, 0.6), UDim2.fromScale(0.66, 0.2), Color3.fromRGB(60, 110, 160))
					eq.Activated:Connect(function()
						local n = tonumber(string.sub(it.id, -1))
						req("hair_set", n)
						ctx.toast("Coiffure equipee", "good")
					end)
				else
					lbl(r, "POSSEDE", UDim2.fromScale(0.3, 0.4), UDim2.fromScale(0.66, 0.3), C.green, Enum.TextXAlignment.Center)
				end
			else
				local buy = mbtn(r, it.price .. " c", UDim2.fromScale(0.3, 0.6), UDim2.fromScale(0.66, 0.2), Color3.fromRGB(40, 140, 70))
				buy.Activated:Connect(function()
					local rr = req("shop_buy", it.id)
					if rr.ok then
						S.burst(r, UDim2.fromScale(0.8, 0.5), C.yellow, 20, 100)
						S.sfx("ping")
						ctx.toast("Achete : " .. it.name, "good")
						task.delay(0.2, refresh)
					else
						ctx.toast(rr.msg or "Impossible", "bad")
					end
				end)
			end
		end
	end
	refresh()
	table.insert(w.conns, player:GetAttributeChangedSignal("Coins"):Connect(function() coinsLbl.Text = "COINS " .. (player:GetAttribute("Coins") or 0) end))
end

------------------------------------------------------------------
-- QUETES
------------------------------------------------------------------
function M.openQuests()
	local w = modal("QUETES", C.green, 0.7, 0.8, 1.2)
	local sf = listFrame(w.panel, UDim2.fromScale(0.94, 0.8), UDim2.fromScale(0.03, 0.16))
	local look = {}
	for _, q in ipairs(Config.DAILY) do look[q.id] = q end
	for _, q in ipairs(Config.WEEKLY) do look[q.id] = q end
	local function refresh()
		for _, c in ipairs(sf:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		local qs = attrJSON("QuestJSON")
		local order = 0
		for _, group in ipairs({ { "QUOTIDIENNES", Config.DAILY }, { "HEBDOMADAIRES", Config.WEEKLY } }) do
			order += 1
			local h = row(sf, 34, order, C.brick)
			lbl(h, group[1], UDim2.fromScale(0.9, 0.8), UDim2.fromScale(0.05, 0.1), C.yellow)
			for _, q in ipairs(group[2]) do
				local st = qs[q.id]
				if st then
					order += 1
					local r = row(sf, 78, order)
					lbl(r, q.text, UDim2.fromScale(0.62, 0.32), UDim2.fromScale(0.03, 0.08))
					bar(r, UDim2.fromScale(0.03, 0.55), UDim2.fromScale(0.58, 0.18), st.p / q.goal, C.green)
					lbl(r, st.p .. " / " .. q.goal .. "   (+" .. q.reward .. " coins)", UDim2.fromScale(0.58, 0.2), UDim2.fromScale(0.03, 0.76), Color3.fromRGB(190, 192, 205), nil, Enum.Font.GothamBold)
					if st.c then
						lbl(r, "FAIT", UDim2.fromScale(0.3, 0.4), UDim2.fromScale(0.66, 0.3), C.green, Enum.TextXAlignment.Center)
					elseif st.p >= q.goal then
						local b = mbtn(r, "RECUPERER", UDim2.fromScale(0.3, 0.55), UDim2.fromScale(0.66, 0.22), Color3.fromRGB(40, 140, 70))
						b.Activated:Connect(function()
							local rr = req("quest_claim", q.id)
							if rr.ok then
								S.burst(r, UDim2.fromScale(0.8, 0.5), C.yellow, 22, 110)
								S.sfx("ping")
								ctx.toast("+" .. rr.reward .. " coins !", "good")
							end
						end)
					else
						lbl(r, "EN COURS", UDim2.fromScale(0.3, 0.4), UDim2.fromScale(0.66, 0.3), Color3.fromRGB(150, 154, 170), Enum.TextXAlignment.Center)
					end
				end
			end
		end
	end
	refresh()
	table.insert(w.conns, player:GetAttributeChangedSignal("QuestJSON"):Connect(refresh))
end

------------------------------------------------------------------
-- TITRES & SUCCES
------------------------------------------------------------------
function M.openTitles()
	local w = modal("TITRES & SUCCES", C.purple, 0.7, 0.85, 1.1)
	local sf = listFrame(w.panel, UDim2.fromScale(0.94, 0.8), UDim2.fromScale(0.03, 0.16))
	local function refresh()
		for _, c in ipairs(sf:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		local owned, badges = attrJSON("TitlesJSON"), attrJSON("BadgesJSON")
		local equipped = player:GetAttribute("TitleId")
		local n = 0
		local h = row(sf, 34, n, C.brick)
		lbl(h, "TITRES (affiches au-dessus de ta tete)", UDim2.fromScale(0.9, 0.8), UDim2.fromScale(0.05, 0.1), C.yellow)
		for _, id in ipairs(Config.TITLE_ORDER) do
			n += 1
			local r = row(sf, 46, n)
			local has = owned[id]
			lbl(r, Config.TITLES[id], UDim2.fromScale(0.55, 0.6), UDim2.fromScale(0.04, 0.2), has and C.white or Color3.fromRGB(100, 102, 114))
			if has then
				if equipped == id then
					lbl(r, "EQUIPE", UDim2.fromScale(0.3, 0.6), UDim2.fromScale(0.66, 0.2), C.green, Enum.TextXAlignment.Center)
				else
					local b = mbtn(r, "EQUIPER", UDim2.fromScale(0.3, 0.7), UDim2.fromScale(0.66, 0.15), Color3.fromRGB(60, 110, 160))
					b.Activated:Connect(function() req("title_equip", id) end)
				end
			else
				lbl(r, "VERROUILLE", UDim2.fromScale(0.3, 0.6), UDim2.fromScale(0.66, 0.2), Color3.fromRGB(100, 102, 114), Enum.TextXAlignment.Center)
			end
		end
		n += 1
		local h2 = row(sf, 34, n, C.brick)
		lbl(h2, "SUCCES", UDim2.fromScale(0.9, 0.8), UDim2.fromScale(0.05, 0.1), C.yellow)
		for id, b in pairs(Config.BADGES) do
			n += 1
			local r = row(sf, 52, n)
			local has = badges[id]
			lbl(r, b[1], UDim2.fromScale(0.6, 0.4), UDim2.fromScale(0.04, 0.08), has and C.yellow or Color3.fromRGB(100, 102, 114))
			lbl(r, b[2], UDim2.fromScale(0.6, 0.3), UDim2.fromScale(0.04, 0.55), Color3.fromRGB(170, 172, 186), nil, Enum.Font.GothamBold)
			lbl(r, has and "OBTENU" or "---", UDim2.fromScale(0.25, 0.5), UDim2.fromScale(0.72, 0.25), has and C.green or Color3.fromRGB(100, 102, 114), Enum.TextXAlignment.Center)
		end
	end
	refresh()
	for _, nme in ipairs({ "TitlesJSON", "BadgesJSON", "TitleId" }) do
		table.insert(w.conns, player:GetAttributeChangedSignal(nme):Connect(refresh))
	end
end

------------------------------------------------------------------
-- CLASSEMENTS
------------------------------------------------------------------
function M.openBoards()
	local w = modal("CLASSEMENTS", C.blue, 0.7, 0.85, 1.1)
	local P = w.panel
	local tabs = { { "score", "SCORE" }, { "Face", "FACE" }, { "Frame", "FRAME" }, { "Height", "HEIGHT" }, { "Lean", "BODYFAT" }, { "global", "MONDIAL" } }
	local sf = listFrame(P, UDim2.fromScale(0.94, 0.68), UDim2.fromScale(0.03, 0.28))
	local function show(key)
		for _, c in ipairs(sf:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		local res = req("board", key)
		local list = res.list or {}
		if #list == 0 then
			local r = row(sf, 40)
			lbl(r, "Pas encore de donnees...", UDim2.fromScale(0.9, 0.7), UDim2.fromScale(0.05, 0.15), Color3.fromRGB(170, 172, 186))
		end
		for i, e in ipairs(list) do
			local r = row(sf, 40, i, (i == 1) and C.brick or C.panel)
			lbl(r, "#" .. i, UDim2.fromScale(0.12, 0.7), UDim2.fromScale(0.03, 0.15), (i <= 3) and C.yellow or C.white)
			lbl(r, e.name, UDim2.fromScale(0.55, 0.7), UDim2.fromScale(0.16, 0.15))
			lbl(r, tostring(e.value), UDim2.fromScale(0.22, 0.7), UDim2.fromScale(0.74, 0.15), C.green, Enum.TextXAlignment.Right)
		end
	end
	for i, t in ipairs(tabs) do
		local b = S.button(P, t[2], { Size = UDim2.fromScale(0.145, 0.08), Position = UDim2.fromScale(0.03 + (i - 1) * 0.155, 0.16), color = C.brickLight, cols = 5, rows = 2, z = 46 })
		b.Activated:Connect(function() show(t[1]) end)
	end
	show("score")
end

------------------------------------------------------------------
-- PRESTIGE
------------------------------------------------------------------
function M.openPrestige()
	local w = modal("PRESTIGE", C.orange, 0.62, 0.72, 1.05)
	local P = w.panel
	local lv, pr = player:GetAttribute("Level") or 0, player:GetAttribute("Prestige") or 0
	local lines = {
		"Niveau de Mog requis : 90 (tu es niveau " .. lv .. ")",
		"Prestiges effectues : " .. pr .. " / 3",
		"Tes stats repartent a zero (traits du visage conserves).",
		"Bonus permanents : +10% de coins par prestige, +3 stats de depart.",
		"Rangs exclusifs : GIGACHAD, MOG GOD, LEGEND (ailes lumineuses).",
		"Recompense : 2000 coins x numero du prestige + titre exclusif.",
	}
	for i, l in ipairs(lines) do
		S.label(P, l, { Size = UDim2.fromScale(0.9, 0.07), Position = UDim2.fromScale(0.05, 0.16 + (i - 1) * 0.1), font = Enum.Font.GothamBold, xAlign = Enum.TextXAlignment.Left, stroke = false, z = 45 })
	end
	local b = mbtn(P, "PRESTIGE", UDim2.fromScale(0.5, 0.13), UDim2.fromScale(0.25, 0.8), Color3.fromRGB(176, 90, 30))
	local armed = false
	b.Activated:Connect(function()
		if not armed then
			armed = true
			S.pop(b, 1.2)
			ctx.toast("Clique encore pour confirmer le prestige !", "info")
			task.delay(4, function() armed = false end)
			return
		end
		local res = req("prestige")
		if res.ok then closeCur() else ctx.toast(res.msg or "Impossible", "bad") end
	end)
end

------------------------------------------------------------------
-- ZONES
------------------------------------------------------------------
function M.openZones()
	local w = modal("ZONES", C.green, 0.72, 0.88, 1.05)
	local sf = listFrame(w.panel, UDim2.fromScale(0.94, 0.8), UDim2.fromScale(0.03, 0.16))
	local lv = player:GetAttribute("Level") or 0
	for i, z in ipairs(Config.ZONES) do
		local r = row(sf, 74, i, C.panel)
		make("Frame", { BackgroundColor3 = z.col, Size = UDim2.fromScale(0.02, 0.8), Position = UDim2.fromScale(0.015, 0.1), BorderSizePixel = 0, ZIndex = 45 }, r)
		lbl(r, z.name, UDim2.fromScale(0.55, 0.34), UDim2.fromScale(0.05, 0.06), z.col)
		lbl(r, z.desc, UDim2.fromScale(0.6, 0.26), UDim2.fromScale(0.05, 0.42), Color3.fromRGB(190, 192, 205), nil, Enum.Font.GothamBold)
		local open = lv >= z.req
		lbl(r, open and "DEBLOQUEE" or ("NIVEAU " .. z.req .. " REQUIS (toi : " .. lv .. ")"), UDim2.fromScale(0.6, 0.22), UDim2.fromScale(0.05, 0.72), open and C.green or C.red, nil, Enum.Font.GothamBold)
		if open then
			local b = mbtn(r, "Y ALLER", UDim2.fromScale(0.26, 0.55), UDim2.fromScale(0.7, 0.22), Color3.fromRGB(40, 140, 70))
			b.Activated:Connect(function()
				local res = req("zone_go", i)
				if res.ok then closeCur() end
			end)
		end
	end
end

------------------------------------------------------------------
-- RECOMPENSE QUOTIDIENNE
------------------------------------------------------------------
function M.openDaily()
	local w = modal("RECOMPENSE QUOTIDIENNE", C.yellow, 0.84, 0.6, 1.9)
	local P = w.panel
	local streak = player:GetAttribute("Streak") or 1
	local today = ((streak - 1) % 7) + 1
	S.label(P, "Serie de connexion : " .. streak .. " jour(s)", { Size = UDim2.fromScale(0.6, 0.07), Position = UDim2.fromScale(0.2, 0.17), font = Enum.Font.GothamBold, z = 45 })
	for i, amt in ipairs(Config.LOGIN) do
		local card = S.panel(P, { Size = UDim2.fromScale(0.11, 0.36), Position = UDim2.fromScale(0.04 + (i - 1) * 0.13, 0.3), color = (i == today) and Color3.fromRGB(150, 110, 30) or C.panel, z = 44, stroke = (i == today) and 4 or 2, strokeColor = (i == today) and C.yellow or C.brickDark })
		S.label(card, "JOUR " .. i, { Size = UDim2.fromScale(0.9, 0.22), Position = UDim2.fromScale(0.05, 0.06), z = 46 })
		S.label(card, tostring(amt), { Size = UDim2.fromScale(0.9, 0.3), Position = UDim2.fromScale(0.05, 0.38), color = C.yellow, z = 46 })
		S.label(card, "coins", { Size = UDim2.fromScale(0.9, 0.16), Position = UDim2.fromScale(0.05, 0.72), font = Enum.Font.GothamBold, stroke = false, z = 46 })
		if i < today then S.label(card, "OK", { Size = UDim2.fromScale(0.6, 0.3), Position = UDim2.fromScale(0.2, 0.34), color = C.green, z = 48 }) end
	end
	local b = mbtn(P, "RECUPERER", UDim2.fromScale(0.34, 0.14), UDim2.fromScale(0.33, 0.76), Color3.fromRGB(40, 140, 70))
	b.Activated:Connect(function()
		local res = req("daily_claim")
		if res.ok then
			S.confetti(gui, 50)
			S.sfx("ping")
			ctx.toast("+" .. res.reward .. " coins (jour " .. res.day .. ") !", "good")
			closeCur()
		else
			closeCur()
		end
	end)
end

------------------------------------------------------------------
-- HUB
------------------------------------------------------------------
function M.openHub()
	local w = modal("MOG MENU", C.purple, 0.62, 0.8, 1.0)
	local P = w.panel
	local items = {
		{ "FACE LAB", M.openFaceLab, C.pink }, { "BOUTIQUE", function() M.openShop(1) end, C.yellow },
		{ "QUETES", M.openQuests, C.green }, { "TITRES & SUCCES", M.openTitles, C.purple },
		{ "CLASSEMENTS", M.openBoards, C.blue }, { "PRESTIGE", M.openPrestige, C.orange },
		{ "ZONES", M.openZones, Color3.fromRGB(60, 170, 120) }, { "RECOMPENSE DU JOUR", M.openDaily, Color3.fromRGB(176, 130, 40) },
	}
	for i, it in ipairs(items) do
		local col, rw = (i - 1) % 2, math.floor((i - 1) / 2)
		local b = S.button(P, it[1], { Size = UDim2.fromScale(0.44, 0.15), Position = UDim2.fromScale(0.04 + col * 0.48, 0.17 + rw * 0.19), color = it[3]:Lerp(C.black, 0.3), cols = 10, rows = 3, z = 46 })
		b.Activated:Connect(it[2])
	end
end

function M.open(name, zoneId)
	if name == "shop" then M.openShop(zoneId)
	elseif name == "quests" then M.openQuests()
	elseif name == "facelab" then M.openFaceLab()
	elseif name == "zones" then M.openZones() end
end

------------------------------------------------------------------
-- HUD : pieces + evenements
------------------------------------------------------------------
local coinChip, coinLbl, eventBox, events = nil, nil, nil, {}
local function buildHud()
	coinChip = S.panel(gui, { Name = "CoinChip", Size = UDim2.fromOffset(190, 44), Position = UDim2.fromOffset(14, 14), color = C.panel, cols = 10, rows = 2, z = 8, stroke = 3 })
	make("Frame", { BackgroundColor3 = C.yellow, Size = UDim2.fromScale(0.12, 0.5), Position = UDim2.fromScale(0.05, 0.25), BorderSizePixel = 0, ZIndex = 9 }, coinChip)
	coinLbl = S.label(coinChip, "0", { Size = UDim2.fromScale(0.7, 0.64), Position = UDim2.fromScale(0.22, 0.18), color = C.yellow, xAlign = Enum.TextXAlignment.Left, z = 10 })
	eventBox = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(250, 150), Position = UDim2.fromOffset(14, 66), ZIndex = 8 }, gui)
	make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, eventBox)
	local last = player:GetAttribute("Coins") or 0
	local function upd()
		local c = player:GetAttribute("Coins") or 0
		coinLbl.Text = tostring(c)
		if c > last then
			S.pop(coinLbl, 1.4)
			local f = S.label(gui, "+" .. (c - last), { Size = UDim2.fromOffset(120, 30), Position = UDim2.fromOffset(40, 60), color = C.green, xAlign = Enum.TextXAlignment.Left, z = 20 })
			tween(f, 0.9, { Position = UDim2.fromOffset(40, 20), TextTransparency = 1 })
			task.delay(1, function() f:Destroy() end)
		end
		last = c
	end
	upd()
	player:GetAttributeChangedSignal("Coins"):Connect(upd)
end

local function rebuildEvents()
	for _, c in ipairs(eventBox:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
	for i, e in ipairs(events) do
		local f = S.panel(eventBox, { Size = UDim2.fromOffset(250, 38), color = C.panel, cols = 12, rows = 2, z = 8, stroke = 3, strokeColor = e.col })
		f.LayoutOrder = i
		S.label(f, e.name, { Size = UDim2.fromScale(0.68, 0.6), Position = UDim2.fromScale(0.04, 0.2), color = e.col, xAlign = Enum.TextXAlignment.Left, z = 10 })
		e.timer = S.label(f, "", { Size = UDim2.fromScale(0.26, 0.6), Position = UDim2.fromScale(0.72, 0.2), xAlign = Enum.TextXAlignment.Right, z = 10 })
		S.pop(f, 1.15)
	end
end

------------------------------------------------------------------
-- EFFETS (photo, zone, ascension)
------------------------------------------------------------------
local function photo()
	local cam = Workspace.CurrentCamera
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local old = cam.CameraType
	cam.CameraType = Enum.CameraType.Scriptable
	local cf = hrp.CFrame
	local t0 = os.clock()
	local conn = RunService.RenderStepped:Connect(function()
		local a = (os.clock() - t0) * 0.5
		cam.CFrame = CFrame.lookAt(cf.Position + cf.LookVector * 9 + Vector3.new(math.sin(a) * 2, 2.5, 0), cf.Position + Vector3.new(0, 2, 0))
	end)
	local l = S.label(gui, "3", { Size = UDim2.fromScale(0.2, 0.25), Position = UDim2.fromScale(0.4, 0.3), z = 90 })
	for i = 3, 1, -1 do
		l.Text = tostring(i)
		S.pop(l, 1.6)
		S.sfx("ping")
		task.wait(0.8)
	end
	l:Destroy()
	S.flash(gui, Color3.new(1, 1, 1), 0, 0.8)
	local st = S.stamp(gui, "PHOTO !", C.yellow, UDim2.fromScale(0.4, 0.2), UDim2.fromScale(0.5, 0.4))
	task.wait(1.6)
	st:Destroy()
	conn:Disconnect()
	cam.CameraType = Enum.CameraType.Custom
end

local function fxEvent(kind, a, b, c)
	if kind == "ui" then
		M.open(a, b)
	elseif kind == "photo" then
		task.spawn(photo)
	elseif kind == "zone" then
		local st = S.stamp(gui, a, b, UDim2.fromScale(0.7, 0.14), UDim2.fromScale(0.5, 0.32))
		task.delay(2.4, function()
			tween(st, 0.4, { TextTransparency = 1 })
			task.delay(0.4, function() st:Destroy() end)
		end)
	elseif kind == "ascend" then
		local mine = (a == player.UserId)
		S.flash(gui, b, mine and 0.3 or 0.8, mine and 1.5 or 0.5)
		if mine then
			local st = S.stamp(gui, c .. " !", b, UDim2.fromScale(0.8, 0.2), UDim2.fromScale(0.5, 0.4))
			S.confetti(gui, 100)
			S.sfx("ping")
			task.delay(3.2, function()
				tween(st, 0.5, { TextTransparency = 1 })
				task.delay(0.5, function() st:Destroy() end)
			end)
		end
	end
end

function M.init(g, rem, c)
	gui, remotes, ctx = g, rem, c
	Req = remotes:WaitForChild("MogReq")
	buildHud()
	remotes:WaitForChild("FX").OnClientEvent:Connect(fxEvent)
	remotes:WaitForChild("EventState").OnClientEvent:Connect(function(list)
		events = list
		rebuildEvents()
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			for _, e in ipairs(events) do
				if e.timer and e.timer.Parent then
					local left = math.max(0, e.ends - os.time())
					e.timer.Text = string.format("%d:%02d", math.floor(left / 60), left % 60)
				end
			end
		end
	end)
	-- recompense quotidienne
	task.delay(8, function()
		if player:GetAttribute("DailyReady") and not ctx.isBusy() then M.openDaily() end
	end)
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">City</string><ProtectedString name="Source"><![CDATA[-- City : ModuleScript (enfant de MogClient) - ville vivante cote client (voitures, foules, bulles de dialogue)
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local M = {}
local V3, CF = Vector3.new, CFrame.new
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local function part(parent, size, cf, color, mat)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Size, p.CFrame, p.Color = size, cf, color
	p.Material = mat or Enum.Material.Plastic
	p.TopSurface = Enum.SurfaceType.Studs
	p.Parent = parent
	return p
end

local function buildCar(parent, color)
	local m = Instance.new("Model")
	m.Name = "MogCar"
	local o = CF(0, 0, 0)
	part(m, V3(8, 1.6, 4), o * CF(0, 1.4, 0), color)
	part(m, V3(4.4, 1.5, 3.6), o * CF(-0.4, 3, 0), color:Lerp(rgb(255, 255, 255), 0.1))
	part(m, V3(4.6, 1.1, 3.7), o * CF(-0.4, 3.1, 0), rgb(120, 170, 200), Enum.Material.Glass).Transparency = 0.35
	for _, sx in ipairs({ -2.6, 2.6 }) do
		for _, sz in ipairs({ -2.1, 2.1 }) do part(m, V3(1.8, 1.8, 0.7), o * CF(sx, 0.9, sz), rgb(25, 25, 28)) end
	end
	for _, sz in ipairs({ -1.3, 1.3 }) do
		part(m, V3(0.3, 0.6, 0.8), o * CF(4.05, 1.6, sz), rgb(255, 240, 190))
		part(m, V3(0.3, 0.6, 0.8), o * CF(-4.05, 1.6, sz), rgb(255, 50, 50))
	end
	m.PrimaryPart = m:FindFirstChildWhichIsA("BasePart")
	m.Parent = parent
	return m
end

local function buildDummy(parent, shirt)
	local m = Instance.new("Model")
	m.Name = "MogCrowd"
	local sk, black = rgb(245, 205, 48), rgb(24, 24, 28)
	local root = part(m, V3(2, 2, 1), CF(0, 0, 0), shirt)
	local head = part(m, V3(1.2, 1.2, 1.2), CF(0, 1.6, 0), sk)
	part(m, V3(0.22, 0.3, 0.1), CF(-0.3, 1.75, -0.62), black)
	part(m, V3(0.22, 0.3, 0.1), CF(0.3, 1.75, -0.62), black)
	part(m, V3(0.5, 0.1, 0.1), CF(0, 1.3, -0.62), black)
	part(m, V3(1.3, 0.4, 1.3), CF(0, 2.4, 0), rgb(40, 30, 28))
	for _, s in ipairs({ -1, 1 }) do
		part(m, V3(1, 1.4, 1), CF(s * 1.5, 0.3, 0), shirt)
		part(m, V3(1, 0.6, 1), CF(s * 1.5, -0.7, 0), sk)
		part(m, V3(1, 2, 1), CF(s * 0.5, -2, 0), rgb(40, 44, 60))
		part(m, V3(1, 0.5, 1.2), CF(s * 0.5, -2.75, -0.1), rgb(235, 235, 235))
	end
	m.PrimaryPart = root
	m.Parent = parent
	return m, head
end

local PHRASES = {
	"T'as vu le nouveau CHAD ?", "Je dois passer au Face Lab...", "Mon bodyfat baisse enfin !", "Ce soir : Mog Contest !",
	"Je vise le niveau MTN.", "Le Gym District, ca a l'air fou.", "Quelqu'un a un conseil pour la Height ?", "J'ai battu un HTN hier !",
	"Les portails, c'est par la-bas.", "Ce festival est incroyable !", "Je veux devenir GIGACHAD.", "Sub-5 un jour, CHAD toujours.",
}

function M.init()
	local folder = Instance.new("Folder")
	folder.Name = "MogLocalCity"
	folder.Parent = Workspace
	local rng = Random.new(os.time())

	-- voitures qui circulent sur les deux routes (hors arene)
	local cars = {}
	local lanes = {
		{ "x", 5.2, 34, 190, 1 }, { "x", -5.2, -190, -34, -1 }, { "x", -5.2, 34, 190, -1 }, { "x", 5.2, -190, -34, 1 },
		{ "z", 5.2, 34, 190, 1 }, { "z", -5.2, -190, -34, -1 }, { "z", -5.2, 34, 190, -1 }, { "z", 5.2, -190, -34, 1 },
	}
	local colors = { rgb(200, 60, 60), rgb(60, 110, 200), rgb(230, 190, 70), rgb(90, 90, 100), rgb(80, 160, 120), rgb(220, 220, 224), rgb(150, 70, 160) }
	task.spawn(function()
		for i, l in ipairs(lanes) do
			for k = 1, 2 do
				local m = buildCar(folder, colors[rng:NextInteger(1, #colors)])
				local t = rng:NextNumber(l[3], l[4])
				table.insert(cars, { m = m, l = l, t = t + (k - 1) * 0, speed = rng:NextNumber(16, 26) })
				task.wait()
			end
		end
	end)

	-- groupes de PNJ qui discutent
	local crowd = {}
	local groups = {
		V3(-26, 0, -27), V3(26, 0, -27), V3(-26, 0, 27), V3(26, 0, 27), V3(0, 0, 76), V3(-70, 0, -66), V3(-120, 0, -100), V3(120, 0, 100),
		V3(-18, 0, 44), V3(18, 0, 44),
	}
	local shirts = { rgb(120, 60, 60), rgb(60, 90, 130), rgb(80, 110, 80), rgb(130, 100, 60), rgb(100, 60, 130), rgb(50, 50, 58) }
	task.spawn(function()
		for gi, c in ipairs(groups) do
			local n = rng:NextInteger(3, 4)
			for i = 1, n do
				local a = (i / n) * math.pi * 2
				local pos = c + V3(math.sin(a) * 3.2, 3.15, math.cos(a) * 3.2)
				local m, head = buildDummy(folder, shirts[rng:NextInteger(1, #shirts)])
				local base = CFrame.lookAt(pos, V3(c.X, pos.Y, c.Z))
				m:PivotTo(base)
				local bb = Instance.new("BillboardGui")
				bb.Size = UDim2.fromOffset(190, 40)
				bb.StudsOffset = V3(0, 2.6, 0)
				bb.MaxDistance = 48
				bb.LightInfluence = 0
				bb.Enabled = false
				bb.Parent = head
				local t = Instance.new("TextLabel")
				t.Size = UDim2.fromScale(1, 1)
				t.BackgroundColor3 = rgb(250, 250, 250)
				t.TextColor3 = rgb(30, 30, 36)
				t.Font = Enum.Font.GothamBold
				t.TextScaled = true
				t.Text = ""
				t.Parent = bb
				local cn = Instance.new("UICorner")
				cn.CornerRadius = UDim.new(0.3, 0)
				cn.Parent = t
				table.insert(crowd, { m = m, base = base, phase = rng:NextNumber(0, 6), bb = bb, t = t, next = os.clock() + rng:NextNumber(1, 6) })
			end
			task.wait()
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		for _, c in ipairs(cars) do
			local l = c.l
			c.t += l[5] * c.speed * dt
			if c.t > l[4] then c.t = l[3] elseif c.t < l[3] then c.t = l[4] end
			if l[1] == "x" then
				c.m:PivotTo(CF(c.t, 0.2, l[2]) * CFrame.Angles(0, (l[5] == 1) and 0 or math.pi, 0))
			else
				c.m:PivotTo(CF(l[2], 0.2, c.t) * CFrame.Angles(0, (l[5] == 1) and -math.pi / 2 or math.pi / 2, 0))
			end
		end
		for _, p in ipairs(crowd) do
			local s = math.sin(now * 2 + p.phase)
			p.m:PivotTo(p.base * CFrame.Angles(0, math.sin(now * 0.7 + p.phase) * 0.18, 0) * CF(0, math.abs(s) * 0.12, 0))
			if now > p.next then
				p.next = now + rng:NextNumber(4, 9)
				p.t.Text = PHRASES[rng:NextInteger(1, #PHRASES)]
				p.bb.Enabled = true
				task.delay(3, function() p.bb.Enabled = false end)
			end
		end
	end)
end

return M
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>