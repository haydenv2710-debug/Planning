	bodyfat = { wall = rgb(150, 160, 130), roof = rgb(60, 66, 52), accent = rgb(80, 170, 110), floor = rgb(150, 92, 80), title = "CARDIO CLUB", sub = "MOVE. SWEAT. IMPROVE.", stat = "BODYFAT" },
}

