local function busStop(x, z, ang)
	local b = CF(x, 0, z) * CFrame.Angles(0, ang, 0)
	part(V3(9, 0.4, 3.6), b * CF(0, 0.2, 0), rgb(120, 116, 110))
	for _, sx in ipairs({ -4, 4 }) do part(V3(0.4, 7, 0.4), b * CF(sx, 3.7, 1.4), C.dark) end
	part(V3(9.6, 0.5, 4.2), b * CF(0, 7.4, 0.3), rgb(70, 110, 96))
	part(V3(8.4, 5.4, 0.2), b * CF(0, 4, 1.6), rgb(150, 200, 220), MAT.Glass, { Transparency = 0.6 })
	part(V3(5.6, 0.5, 1.4), b * CF(0, 1.6, 0.8), C.wood)
	part(V3(0.4, 9, 0.4), b * CF(5.2, 4.5, -0.8), C.steel)
	part(V3(2, 1.6, 0.3), b * CF(5.2, 8.6, -0.8), rgb(40, 100, 160))
end
