for _, sx in ipairs({ -1, 1 }) do
	for _, sz in ipairs({ -1, 1 }) do
		for _, xi in ipairs({ 100, 130, 160, 190 }) do
			filler(V3(sx * xi, 0, sz * 34), V3(0, 0, -sz), 26, rng:NextInteger(16, 32))
		end
		for _, zi in ipairs({ 80, 108, 136, 164, 192 }) do
			filler(V3(sx * 34, 0, sz * zi), V3(-sx, 0, 0), 26, rng:NextInteger(16, 34))
		end
	end
end

for i = -4, 4 do
	for _, e in ipairs({ { i * 46, -206 }, { i * 46, 206 }, { -206, i * 46 }, { 206, i * 46 } }) do
		local pos = V3(e[1], 0, e[2])
		local base = CFrame.lookAt(pos, V3(0, 0, 0))
		local h = rng:NextInteger(44, 96)
		local wall = WALLS[rng:NextInteger(1, #WALLS)]:Lerp(C.dark, 0.35)
		part(V3(30, h, 26), base * CF(0, h / 2, 13), wall)
		part(V3(31, 1.4, 27), base * CF(0, h + 0.7, 13), C.dark)
		windows(base, 24, 4, h - 2, 4, math.floor(h / 14), -0.2, true)
		if rng:NextNumber() < 0.4 then part(V3(1, 10, 1), base * CF(0, h + 6, 13), C.steel) end
	end
end

local function park(cx, cz)
	part(V3(66, 0.4, 66), CF(cx, 0.2, cz), C.grass)
	for _, o in ipairs({ { -22, -22 }, { 22, -22 }, { -22, 22 }, { 22, 22 }, { 0, -26 }, { 0, 26 }, { -26, 0 }, { 26, 0 } }) do
		tree(cx + o[1], cz + o[2])
	end
	part(V3(14, 1.4, 14), CF(cx, 0.9, cz), rgb(160, 156, 150))
	part(V3(10, 1, 10), CF(cx, 1.9, cz), rgb(90, 170, 220), MAT.Glass, { Transparency = 0.2 })
	part(V3(2, 4, 2), CF(cx, 3.6, cz), rgb(160, 156, 150))
	part(V3(5, 0.6, 5), CF(cx, 5.8, cz), rgb(90, 170, 220), MAT.Glass, { Transparency = 0.3 })
	for _, a in ipairs({ 0, 90, 180, 270 }) do
		bench(CF(cx, 0.4, cz) * CFrame.Angles(0, math.rad(a), 0) * CF(0, 0, 14))
	end
	lamp(cx + 12, cz + 12, 0)
	lamp(cx - 12, cz - 12, math.pi)
	firefly(V3(cx, 6, cz), 8)
end
park(-130, -120)
park(130, -120)
park(-130, 120)
park(130, 120)

