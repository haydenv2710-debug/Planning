local function pad(base, theme, key)
	part(V3(40, 0.3, 18), base * CF(0, 0.15, -12), theme.floor)
	for _, sx in ipairs({ -1, 1 }) do
		part(V3(0.6, 0.2, 18), base * CF(sx * 19.7, 0.35, -12), theme.accent, MAT.Plastic)
	end
	part(V3(40, 0.2, 0.6), base * CF(0, 0.35, -20.7), theme.accent, MAT.Plastic)
	local p = part(V3(7, 0.5, 7), base * CF(0, 0.55, -12), theme.accent, MAT.Neon, { Transparency = 0.3, CanCollide = false })
	gui(p, Enum.NormalId.Top, theme.stat, WHITE, 30)
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText, pr.ObjectText = "Lancer le mini-jeu", theme.title
	pr.HoldDuration = 0.4
	pr.MaxActivationDistance = 12
	pr.RequiresLineOfSight = false
	pr:SetAttribute("Station", key)
	if theme.zone then pr:SetAttribute("Zone", theme.zone) end
	pr.Parent = p
	local l = part(V3(1, 1, 1), base * CF(0, 9, -12), WHITE, MAT.Plastic, { Transparency = 1, CanCollide = false })
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(180, 50)
	bb.AlwaysOnTop = false
	bb.LightInfluence = 0
	bb.MaxDistance = 90
	bb.Parent = l
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = theme.stat .. " STATION"
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.TextColor3 = theme.accent
	t.Parent = bb
	local st = Instance.new("UIStroke")
	st.Thickness = 2
	st.Parent = t
end

local function shop(pos, front, theme, key)
	local base = CFrame.lookAt(pos, pos + front)
	building(base, 44, 24, 22, theme.wall, theme.roof, true)
	-- vitrines + porte
	for _, sx in ipairs({ -1, 1 }) do
		part(V3(15, 6, 0.4), base * CF(sx * 12, 4, -0.3), rgb(255, 205, 130), MAT.Plastic, { Transparency = 0.12 })
		part(V3(16, 0.6, 0.7), base * CF(sx * 12, 7.2, -0.4), C.dark)
		part(V3(16, 0.6, 0.7), base * CF(sx * 12, 0.9, -0.4), C.dark)
	end
	part(V3(5, 7.4, 0.6), base * CF(0, 3.9, -0.45), C.wood)
	part(V3(5.8, 0.6, 0.9), base * CF(0, 7.9, -0.45), C.dark)
	neonSign(base * CF(0, 17.5, -1.2), V3(30, 5, 0.8), theme.title, theme.accent)
	neonSign(base * CF(0, 13.4, -1), V3(22, 2.2, 0.6), theme.sub, WHITE)
	awning(base, 36, theme.accent:Lerp(C.dark, 0.3), C.cream)
	pad(base, theme, key)
	return base
end

