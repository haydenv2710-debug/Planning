local function streetSign(x, z, ang, t1, t2)
	local b = CF(x, 0, z) * CFrame.Angles(0, ang, 0)
	part(V3(0.5, 11, 0.5), b * CF(0, 5.5, 0), C.steel)
	local p = part(V3(6, 1.4, 0.3), b * CF(0, 10.6, -0.4), rgb(40, 100, 70), MAT.Plastic, { TopSurface = Enum.SurfaceType.Smooth })
	gui(p, Enum.NormalId.Front, t1, WHITE, 30)
	local q = part(V3(6, 1.4, 0.3), b * CF(0, 8.9, -0.4) * CFrame.Angles(0, math.pi / 2, 0), rgb(40, 100, 70), MAT.Plastic, { TopSurface = Enum.SurfaceType.Smooth })
	gui(q, Enum.NormalId.Front, t2, WHITE, 30)
end
