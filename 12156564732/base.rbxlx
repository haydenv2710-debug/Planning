------------------------------------------------------------------
-- BIG UPDATE V2 : portails, PNJ, boutiques, classements, zones debloquables
------------------------------------------------------------------
local CONFIG = require(game:GetService("ReplicatedStorage"):WaitForChild("MogConfig"))
local ZONES = CONFIG.ZONES
local STONE = rgb(196, 190, 180)
local STATNAME = { face = "FACE", frame = "FRAME", height = "HEIGHT", bodyfat = "BODYFAT" }

local function prompt(p, action, obj, attrs, dist, hold)
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText, pr.ObjectText = action, obj
	pr.HoldDuration = hold or 0.3
	pr.MaxActivationDistance = dist or 12
	pr.RequiresLineOfSight = false
	for k, v in pairs(attrs) do pr:SetAttribute(k, v) end
	pr.Parent = p
	return pr
end

-- PNJ (bonhomme en briques) avec interaction
local function npc(pos, face, name, shirt, action, attrs)
	local b = CFrame.lookAt(pos, Vector3.new(face.X, pos.Y, face.Z))
	local sk = rgb(245, 205, 48)
	local torso = part(V3(2, 2, 1), b * CF(0, 3.1, 0), shirt)
	local head = part(V3(1.2, 1.2, 1.2), b * CF(0, 4.7, 0), sk)
	part(V3(0.22, 0.3, 0.1), b * CF(-0.3, 4.85, -0.62), C.dark)
	part(V3(0.22, 0.3, 0.1), b * CF(0.3, 4.85, -0.62), C.dark)
	part(V3(0.5, 0.1, 0.1), b * CF(0, 4.4, -0.62), C.dark)
	part(V3(1.3, 0.4, 1.3), b * CF(0, 5.5, 0), rgb(40, 30, 28))
	for _, sx in ipairs({ -1, 1 }) do
		part(V3(1, 1.4, 1), b * CF(sx * 1.5, 3.4, 0), shirt)
		part(V3(1, 0.6, 1), b * CF(sx * 1.5, 2.4, 0), sk)
		part(V3(1, 2, 1), b * CF(sx * 0.5, 1.1, 0), rgb(40, 44, 60))
		part(V3(1, 0.5, 1.2), b * CF(sx * 0.5, 0.25, -0.1), rgb(235, 235, 235))
	end
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(180, 34)
	bb.StudsOffset = Vector3.new(0, 2.6, 0)
	bb.LightInfluence = 0
	bb.MaxDistance = 80
	bb.Parent = head
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = name
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.TextColor3 = rgb(255, 224, 150)
	t.Parent = bb
	local st = Instance.new("UIStroke")
	st.Thickness = 2
	st.Parent = t
	if action then prompt(torso, action, name, attrs, 12, 0.3) end
	return torso
end

-- arche de portail
local function arch(cf, label, req, col, zid)
	for _, sx in ipairs({ -5, 5 }) do part(V3(2, 13, 2), cf * CF(sx, 6.5, 0), STONE) end
	part(V3(12.4, 2.4, 2.6), cf * CF(0, 13.2, 0), STONE)
	local panel = part(V3(8, 11, 0.6), cf * CF(0, 5.8, 0), col, MAT.Neon, { Transparency = 0.5, CanCollide = false })
	gui(panel, Enum.NormalId.Front, label .. "\nNIVEAU " .. req, WHITE, 26)
	gui(panel, Enum.NormalId.Back, label .. "\nNIVEAU " .. req, WHITE, 26)
	local pad = part(V3(8, 0.3, 5), cf * CF(0, 0.35, -3.5), col, MAT.Neon, { Transparency = 0.4, CanCollide = false })
	prompt(pad, "Entrer", label, { Portal = zid }, 12, 0.4)
end

-- salle accessible (porte ouverte, interieur, comptoir, PNJ)
local function walkIn(pos, front, w, d, h, wall, roof, title, accent, action, attrs, npcName)
	local b = CFrame.lookAt(pos, pos + front)
	part(V3(w, 0.4, d), b * CF(0, 0.2, d / 2), rgb(206, 184, 150))
	part(V3(w, h, 1), b * CF(0, h / 2, d - 0.5), wall)
	for _, sx in ipairs({ -1, 1 }) do
		part(V3(1, h, d), b * CF(sx * (w / 2 - 0.5), h / 2, d / 2), wall)
		part(V3((w - 8) / 2, h, 1), b * CF(sx * ((w - 8) / 4 + 4), h / 2, 0.5), wall)
		part(V3((w - 8) / 2 - 4, 5, 0.3), b * CF(sx * ((w - 8) / 4 + 4), 5, -0.2), rgb(255, 214, 150), MAT.Glass, { Transparency = 0.35 })
	end
	part(V3(8, h - 8, 1), b * CF(0, 8 + (h - 8) / 2, 0.5), wall)
	part(V3(w + 1.4, 1, d + 1.4), b * CF(0, h + 0.5, d / 2), roof)
	neonSign(b * CF(0, h - 2, -1.2), V3(math.min(w * 0.6, 26), 3, 0.7), title, accent)
	awning(b, w - 8, accent:Lerp(C.dark, 0.3), C.cream)
	part(V3(w * 0.55, 3, 2), b * CF(0, 1.5, d - 6), C.wood)
	part(V3(w * 0.5, 0.3, 2.4), b * CF(0, 3.1, d - 6), rgb(216, 196, 160))
	for k = 1, 2 do
		part(V3(w * 0.85, 0.4, 1.2), b * CF(0, 2 + k * 3, d - 1.4), C.wood)
		for i = -3, 3 do
			part(V3(0.9, 1.2, 0.9), b * CF(i * w * 0.11, 2.8 + k * 3, d - 1.4), NEONS[(i + k + 8) % #NEONS + 1]:Lerp(WHITE, 0.3))
		end
	end
	for _, sx in ipairs({ -1, 1 }) do
		part(V3(4, 0.4, 4), b * CF(sx * (w / 4), 2.4, 7), C.wood)
		part(V3(0.6, 2.2, 0.6), b * CF(sx * (w / 4), 1.2, 7), C.dark)
		part(V3(2.2, 1.8, 2.2), b * CF(sx * (w / 2 - 3), 0.9, d - 3), rgb(70, 128, 64))
	end
	local lp = part(V3(2, 0.4, 2), b * CF(0, h - 0.4, d / 2), rgb(255, 232, 190))
	local pl = Instance.new("PointLight")
	pl.Range, pl.Brightness, pl.Color, pl.Shadows = 26, 1.2, rgb(255, 214, 160), false
	pl.Parent = lp
	if action then npc((b * CF(0, 0, d - 9)).Position, pos, npcName or title, accent:Lerp(C.dark, 0.3), action, attrs) end
	return b
end

local function photoSpot(pos, name)
	local b = CF(pos)
	part(V3(1, 8, 1), b * CF(-4, 4, 0), C.wood)
	part(V3(1, 8, 1), b * CF(4, 4, 0), C.wood)
	part(V3(9, 1, 1), b * CF(0, 8.5, 0), C.wood)
	part(V3(9, 1, 1), b * CF(0, 0.5, 0), C.wood)
	local pad = part(V3(5, 0.3, 4), b * CF(0, 0.4, -4), rgb(255, 214, 120), MAT.Neon, { Transparency = 0.5, CanCollide = false })
	gui(pad, Enum.NormalId.Top, "PHOTO", WHITE, 30)
	prompt(pad, "Prendre une photo", "PHOTO", { Photo = name }, 10, 0.3)
end

