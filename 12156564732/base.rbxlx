part(V3(29, 0.5, 1.4), CF(0, 12.2, -62), rgb(120, 96, 70))

neonSign(CF(0, 22, 100) * CFrame.Angles(0, math.pi, 0), V3(30, 6, 1), "WELCOME TO MOG STREET", rgb(255, 190, 90), true)

