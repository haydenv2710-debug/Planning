]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">FaceShared</string><ProtectedString name="Source"><![CDATA[-- FaceShared : ModuleScript (ReplicatedStorage) - geometrie du visage partagee serveur/client
-- Renvoie la liste des pieces du visage (en espace local de la tete) pour des niveaux de traits donnes.
local M = {}
local V = Vector3.new

function M.defaults()
	return { Jawline = 0, Cheekbones = 0, Eyes = 0, Eyebrows = 0, Nose = 0, Lips = 0, Symmetry = 0, Structure = 0, Skin = 0, Harmony = 0 }
end

-- lv : niveaux 0..5 ; hs : taille de la tete ; skin : couleur de peau ; hair : couleur des cheveux
function M.specs(lv, hs, skin, hair)
	local L = setmetatable(lv or {}, { __index = function() return 0 end })
	local out = {}
	local function add(name, size, off, color, shape, mat)
		table.insert(out, { name = name, size = size, off = off, color = color, shape = shape, mat = mat })
	end
	local fz = -hs.Z * 0.52
	local dark = Color3.fromRGB(18, 16, 18)
	local asym = (5 - L.Symmetry) * 0.012 * hs.X -- visage asymetrique si symetrie faible
	local spread = 0.2 + 0.012 * L.Harmony -- ecartement des yeux (proportions)
	-- yeux : blanc + iris (+ halo pour les hauts niveaux)
	local ew, eh = hs.X * (0.13 + 0.012 * L.Eyes), hs.Y * (0.09 + 0.012 * L.Eyes)
	local iris = (L.Eyes >= 4) and Color3.fromRGB(70, 170, 230) or ((L.Eyes >= 2) and Color3.fromRGB(90, 70, 50) or dark)
	for _, s in ipairs({ -1, 1 }) do
		local ey = hs.Y * 0.08 + (s == 1 and asym or -asym)
		add("EyeW", V(ew * 1.25, eh * 1.1, 0.05), CFrame.new(s * hs.X * spread, ey, fz), Color3.fromRGB(240, 240, 240))
		add("Iris", V(ew * 0.7, eh * 0.9, 0.06), CFrame.new(s * hs.X * spread, ey, fz - 0.02), iris, nil, (L.Eyes >= 5) and Enum.Material.Neon or nil)
		add("Pupil", V(ew * 0.3, eh * 0.45, 0.07), CFrame.new(s * hs.X * spread, ey, fz - 0.04), dark)
	end
	-- sourcils : epaisseur + inclinaison dominante
	local bt = hs.Y * (0.03 + 0.011 * L.Eyebrows)
	for _, s in ipairs({ -1, 1 }) do
		add("Brow", V(hs.X * (0.22 + 0.01 * L.Eyebrows), bt, 0.07), CFrame.new(s * hs.X * spread, hs.Y * (0.2 + (s == 1 and asym * 0.4 or 0)), fz) * CFrame.Angles(0, 0, s * math.rad(-4 - L.Eyebrows * 2)), hair)
	end
	-- nez : bulbe large -> arete fine
	if L.Nose == 0 then
		add("Nose", V(hs.X * 0.2, hs.Y * 0.14, hs.Z * 0.16), CFrame.new(asym * 0.5, -hs.Y * 0.07, fz - 0.06), skin:Lerp(Color3.fromRGB(220, 120, 110), 0.2), Enum.PartType.Ball)
	else
		add("Nose", V(hs.X * (0.13 - 0.008 * L.Nose), hs.Y * (0.16 + 0.018 * L.Nose), hs.Z * (0.13 + 0.025 * L.Nose)), CFrame.new(asym * 0.3, -hs.Y * 0.04, fz - 0.05), skin:Lerp(Color3.new(0, 0, 0), 0.06))
	end
	-- levres
	local lw = hs.X * (0.24 + 0.02 * L.Lips)
	local lc = Color3.fromRGB(200, 120, 120):Lerp(Color3.fromRGB(190, 70, 90), L.Lips / 5)
	add("LipU", V(lw, hs.Y * (0.022 + 0.008 * L.Lips), 0.06), CFrame.new(0, -hs.Y * 0.2, fz) * CFrame.Angles(0, 0, math.rad(asym * 20)), lc)
	add("LipL", V(lw * 0.9, hs.Y * (0.03 + 0.012 * L.Lips), 0.06), CFrame.new(0, -hs.Y * (0.2 + 0.04 + 0.004 * L.Lips), fz), lc:Lerp(Color3.new(1, 1, 1), 0.08))
	-- machoire : menton mou -> menton carre
	if L.Jawline == 0 then
		add("Jaw", V(hs.X * 0.55, hs.Y * 0.3, hs.Z * 0.5), CFrame.new(0, -hs.Y * 0.42, -hs.Z * 0.12), skin, Enum.PartType.Ball)
	else
		add("Jaw", V(hs.X * (0.6 + 0.06 * L.Jawline), hs.Y * (0.12 + 0.025 * L.Jawline), hs.Z * 0.6), CFrame.new(0, -hs.Y * 0.43, -hs.Z * 0.12), skin:Lerp(Color3.new(0, 0, 0), 0.04 + 0.01 * L.Jawline))
	end
	-- pommettes
	if L.Cheekbones > 0 then
		for _, s in ipairs({ -1, 1 }) do
			add("Cheek", V(hs.X * (0.08 + 0.025 * L.Cheekbones), hs.Y * 0.1, hs.Z * 0.2), CFrame.new(s * hs.X * 0.4, -hs.Y * 0.02, -hs.Z * 0.42) * CFrame.Angles(0, s * math.rad(25), 0), skin:Lerp(Color3.new(1, 1, 1), 0.06))
		end
	end
	-- structure : arcade sourciliere + tempes
	if L.Structure >= 2 then
		add("Ridge", V(hs.X * 0.86, hs.Y * (0.03 + 0.012 * L.Structure), hs.Z * 0.18), CFrame.new(0, hs.Y * 0.17, -hs.Z * 0.46), skin:Lerp(Color3.new(0, 0, 0), 0.05))
	end
	return out
end

return M
]]></ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="RBX17"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX13"><Properties><string name="Name">MogMap</string><ProtectedString name="Source"><![CDATA[-- MogMap : construit "MOG STREET CITY" (tout en studs, lumiere cosy)
-- Script a placer dans ServerScriptService
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

for _, n in ipairs({ "Baseplate", "MogMap" }) do
	local o = Workspace:FindFirstChild(n)
	if o then o:Destroy() end
end

------------------------------------------------------------------
-- ECLAIRAGE COSY MAIS LUMINEUX
------------------------------------------------------------------
for _, c in ipairs(Lighting:GetChildren()) do
	if c:IsA("PostEffect") or c:IsA("Atmosphere") then c:Destroy() end
end
Lighting.ClockTime = 17.3
Lighting.GeographicLatitude = 25
Lighting.Brightness = 2.6
Lighting.Ambient = Color3.fromRGB(128, 112, 108)
Lighting.OutdoorAmbient = Color3.fromRGB(155, 136, 128)
Lighting.ColorShift_Top = Color3.fromRGB(255, 205, 150)
Lighting.EnvironmentDiffuseScale = 0.6
Lighting.EnvironmentSpecularScale = 0.3
Lighting.ExposureCompensation = 0.3
Lighting.GlobalShadows = true
Lighting.FogColor = Color3.fromRGB(255, 196, 160)
Lighting.FogStart = 350
Lighting.FogEnd = 1100

local function fx(class, props)
	local i = Instance.new(class)
	for k, v in pairs(props) do i[k] = v end
	i.Parent = Lighting
	return i
end
fx("Atmosphere", { Density = 0.27, Offset = 0.25, Color = Color3.fromRGB(255, 208, 175), Decay = Color3.fromRGB(255, 150, 110), Glare = 0.2, Haze = 1.1 })
fx("ColorCorrectionEffect", { Brightness = 0.02, Contrast = 0.1, Saturation = 0.06, TintColor = Color3.fromRGB(255, 246, 236) })
fx("BloomEffect", { Intensity = 0.25, Size = 24, Threshold = 1.1 })
fx("SunRaysEffect", { Intensity = 0.06, Spread = 0.6 })

------------------------------------------------------------------
-- OUTILS
------------------------------------------------------------------
local map = Instance.new("Folder")
map.Name = "MogMap"
map.Parent = Workspace
local rng = Random.new(2026)
local curParent = nil
local V3, CF = Vector3.new, CFrame.new
local MAT = Enum.Material
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
local WHITE = rgb(240, 236, 228)
local C = {
	asphalt = rgb(54, 56, 64), sidewalk = rgb(156, 150, 142), curb = rgb(214, 204, 186),
	dark = rgb(34, 35, 42), steel = rgb(110, 116, 128), cream = rgb(238, 222, 188),
	brick = rgb(150, 78, 62), wood = rgb(150, 98, 58), grass = rgb(96, 146, 86),
	warm = rgb(255, 198, 120), red = rgb(190, 40, 40), blue = rgb(40, 110, 220),
}

local function part(size, cf, color, mat, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	if typeof(cf) == "Vector3" then cf = CFrame.new(cf) end
	p.CFrame = cf
	p.Color = color
	p.Material = mat or MAT.Plastic
	p.TopSurface = Enum.SurfaceType.Studs
	p.BottomSurface = Enum.SurfaceType.Smooth
	if size.Magnitude < 3.5 then p.CastShadow = false end
	if props then for k, v in pairs(props) do p[k] = v end end
	p.Parent = curParent or map
	return p
end

local function gui(p, face, text, color, ppS)
	local g = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = ppS or 40
	g.LightInfluence = 0
	g.Parent = p
	local l = Instance.new("TextLabel")
	l.Name = "BoardText"
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextScaled = true
	l.Font = Enum.Font.GothamBlack
	l.TextColor3 = color
	l.Parent = g
	return l
end

-- enseigne peinte (plus de neon) : planche sombre, texte creme, liseres de couleur
local function neonSign(cf, size, text, color, both)
	local p = part(size, cf, rgb(46, 40, 38), MAT.Plastic, { TopSurface = Enum.SurfaceType.Smooth })
	local txt = color:Lerp(rgb(244, 236, 218), 0.62)
	gui(p, Enum.NormalId.Front, text, txt)
	if both then gui(p, Enum.NormalId.Back, text, txt) end
	local trim = color:Lerp(rgb(40, 34, 32), 0.25)
	part(V3(size.X + 0.8, 0.35, size.Z + 0.3), cf * CF(0, size.Y / 2 + 0.17, 0), trim)
	part(V3(size.X + 0.8, 0.35, size.Z + 0.3), cf * CF(0, -size.Y / 2 - 0.17, 0), trim)
	return p
end

------------------------------------------------------------------
-- PROPS
------------------------------------------------------------------
local function lamp(x, z, ang)
	local b = CF(x, 0, z) * CFrame.Angles(0, ang, 0)
	part(V3(1.8, 0.8, 1.8), b * CF(0, 0.4, 0), C.dark)
	part(V3(0.8, 13, 0.8), b * CF(0, 6.5, 0), C.dark)
	part(V3(0.6, 0.6, 4.4), b * CF(0, 13, -1.8), C.dark)
	part(V3(1.8, 0.6, 2.4), b * CF(0, 12.7, -3.6), C.dark)
	local bulb = part(V3(1.3, 0.4, 1.9), b * CF(0, 12.3, -3.6), rgb(255, 214, 150), MAT.Neon)
	local pl = Instance.new("PointLight")
	pl.Range = 30
	pl.Brightness = 1.6
	pl.Color = rgb(255, 200, 140)
	pl.Shadows = false
	pl.Parent = bulb
end

local function tree(x, z)
	local col = ({ rgb(86, 140, 72), rgb(224, 142, 56), rgb(198, 98, 64), rgb(120, 164, 82) })[rng:NextInteger(1, 4)]
	part(V3(4.4, 0.8, 4.4), CF(x, 0.4, z), C.brick)
	part(V3(1.6, 5, 1.6), CF(x, 3.3, z), rgb(112, 76, 48))
	part(V3(7, 3, 7), CF(x, 6.8, z), col)
	part(V3(5, 3, 5), CF(x, 9.6, z), col:Lerp(WHITE, 0.08))
	part(V3(3, 2.4, 3), CF(x, 12, z), col:Lerp(WHITE, 0.16))
end

local function car(base, color)
	part(V3(8, 1.6, 4), base * CF(0, 1.4, 0), color)
	part(V3(4.4, 1.5, 3.6), base * CF(-0.4, 3, 0), color:Lerp(WHITE, 0.1))
	part(V3(4.6, 1.1, 3.7), base * CF(-0.4, 3.1, 0), rgb(120, 170, 200), MAT.Glass, { Transparency = 0.35 })
	for _, sx in ipairs({ -2.6, 2.6 }) do
		for _, sz in ipairs({ -2.1, 2.1 }) do
			part(V3(1.8, 1.8, 0.7), base * CF(sx, 0.9, sz), rgb(25, 25, 28))
		end
	end
	for _, sz in ipairs({ -1.3, 1.3 }) do
		part(V3(0.3, 0.6, 0.8), base * CF(4.05, 1.6, sz), rgb(255, 240, 190), MAT.Plastic)
		part(V3(0.3, 0.6, 0.8), base * CF(-4.05, 1.6, sz), rgb(255, 50, 50), MAT.Plastic)
	end
end

local function bench(base)
	part(V3(5, 0.4, 1.6), base * CF(0, 1.5, 0), C.wood)
	part(V3(5, 1.4, 0.4), base * CF(0, 2.4, 0.7), C.wood)
	for _, sx in ipairs({ -2.2, 2.2 }) do part(V3(0.4, 1.5, 1.6), base * CF(sx, 0.75, 0), C.dark) end
end

local function hydrant(x, z)
	part(V3(1.2, 2.2, 1.2), CF(x, 1.1, z), C.red)
	part(V3(1.6, 0.5, 1.6), CF(x, 2.3, z), C.red)
	part(V3(2.2, 0.6, 0.6), CF(x, 1.5, z), C.red)
end

local function bin(x, z)
	part(V3(2, 2.8, 2), CF(x, 1.4, z), rgb(70, 110, 96))
	part(V3(2.3, 0.4, 2.3), CF(x, 2.9, z), C.dark)
end

local function crate(x, y, z, s)
	part(V3(s, s, s), CF(x, y + s / 2, z) * CFrame.Angles(0, rng:NextNumber(0, 1), 0), C.wood)
end

local function firefly(pos, rate)
	local a = part(V3(1, 1, 1), pos, WHITE, MAT.Plastic, { Transparency = 1, CanCollide = false, CanQuery = false })
	local e = Instance.new("ParticleEmitter")
	e.Rate = rate or 6
	e.Lifetime = NumberRange.new(4, 7)
	e.Speed = NumberRange.new(0.4, 1.2)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new(0.35)
	e.Color = ColorSequence.new(rgb(255, 214, 140))
	e.LightEmission = 1
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.2), NumberSequenceKeypoint.new(1, 1) })
	e.Parent = a
	local sh = Instance.new("Attachment")
	sh.Parent = a
end

------------------------------------------------------------------
-- BATIMENTS
------------------------------------------------------------------
local LIT = { rgb(246, 222, 164), rgb(240, 204, 140), rgb(250, 232, 190), rgb(228, 190, 130) }
local function windows(base, w, y0, h, cols, rows, z, lite)
	local cw, rh = w / cols, (h - y0) / rows
	local list = {}
	for c = 1, cols do
		for r = 1, rows do
			local x = -w / 2 + (c - 0.5) * cw
			local y = y0 + (r - 0.5) * rh
			local lit = rng:NextNumber() < 0.42
			if not lite then
				part(V3(cw * 0.68, rh * 0.64, 0.2), base * CF(x, y, z + 0.1), rgb(232, 224, 208))
			end
			local col = lit and LIT[rng:NextInteger(1, #LIT)] or rgb(74, 90, 112)
			local mat = (lit and rng:NextNumber() < 0.1) and MAT.Neon or MAT.Plastic
			part(V3(cw * 0.5, rh * 0.48, 0.2), base * CF(x, y, z - 0.05), col, mat)
			if not lite then
				part(V3(cw * 0.5, 0.18, 0.25), base * CF(x, y, z - 0.08), rgb(232, 224, 208))
				table.insert(list, { x, y, cw, rh })
			end
		end
	end
	return list
end

-- base : centre bas de la facade, facade vers -Z, corps vers +Z
local function building(base, w, d, h, wall, roof, noShopfront)
	part(V3(w, h, d), base * CF(0, h / 2, d / 2), wall)
	part(V3(w + 1.4, 1.2, d + 1.4), base * CF(0, h + 0.6, d / 2), roof)
	part(V3(w + 0.8, 1.6, 0.8), base * CF(0, 0.8, -0.4), C.curb)
	local floors = math.max(2, math.floor(h / 7))
	for i = 1, floors - 1 do
		part(V3(w + 0.8, 0.5, 0.9), base * CF(0, i * 7, -0.45), wall:Lerp(WHITE, 0.2))
	end
	if h > 12 then
		local list = windows(base, w - 5, 8, h - 1.5, math.max(2, math.floor(w / 6)), math.max(1, floors - 1), -0.2)
		for _, o in ipairs(list) do
			local x, y, cw, rh = o[1], o[2], o[3], o[4]
			local roll = rng:NextNumber()
			if roll < 0.28 then
				-- jardiniere fleurie
				part(V3(cw * 0.62, 0.7, 1.1), base * CF(x, y - rh * 0.4, -0.75), rgb(120, 82, 54))
				part(V3(cw * 0.56, 0.5, 0.9), base * CF(x, y - rh * 0.4 + 0.55, -0.75), rgb(70, 128, 64))
				for k = -1, 1 do
					part(V3(0.4, 0.4, 0.4), base * CF(x + k * cw * 0.18, y - rh * 0.4 + 0.95, -0.8), (k % 2 == 0) and rgb(232, 120, 140) or rgb(240, 210, 90))
				end
			elseif roll < 0.4 and y > 12 then
				-- petit balcon
				part(V3(cw * 0.95, 0.4, 2.2), base * CF(x, y - rh * 0.42, -1.2), rgb(176, 170, 160))
				part(V3(cw * 0.95, 0.25, 0.25), base * CF(x, y - rh * 0.42 + 1.1, -2.2), rgb(40, 40, 46))
				for k = -2, 2 do
					part(V3(0.2, 1.1, 0.2), base * CF(x + k * cw * 0.22, y - rh * 0.42 + 0.55, -2.2), rgb(40, 40, 46))
				end
			end
		end
	end
	-- descente de gouttiere + perron
	part(V3(0.5, h, 0.5), base * CF(-w / 2 + 1.2, h / 2, -0.8), C.steel)
	for k = 1, 3 do
		part(V3(5.6, 0.35 * k, 1.1), base * CF(w / 2 - 6, 0.175 * k, -1.1 - (3 - k) * 0.9), rgb(166, 160, 150))
	end
	-- pilastres
	for _, sx in ipairs({ -1, 1 }) do
		part(V3(1.2, h, 1.2), base * CF(sx * (w / 2 - 0.2), h / 2, -0.4), wall:Lerp(WHITE, 0.15))
	end
	-- toit : clim, cheminee, citerne
	for _ = 1, rng:NextInteger(1, 3) do
		local x, z = rng:NextNumber(-w / 2 + 3, w / 2 - 3), rng:NextNumber(3, d - 3)
		part(V3(3.4, 2.2, 3.4), base * CF(x, h + 2.3, z), C.steel)
		part(V3(2.2, 0.3, 2.2), base * CF(x, h + 3.5, z), C.dark)
	end
	if rng:NextNumber() < 0.5 then
		local x = rng:NextNumber(-w / 3, w / 3)
		part(V3(2, 5, 2), base * CF(x, h + 3.6, d - 4), C.brick)
	end
	if not noShopfront then
		part(V3(w - 6, 5, 0.4), base * CF(0, 3.6, -0.3), rgb(255, 205, 130), MAT.Plastic, { Transparency = 0.15 })
		part(V3(w - 5, 0.6, 0.6), base * CF(0, 6.3, -0.4), C.dark)
		part(V3(4, 6.4, 0.5), base * CF(w / 2 - 6, 3.4, -0.45), C.wood)
	end
end

local function awning(base, w, c1, c2)
	local n = math.max(4, math.floor(w / 3))
	local sw = w / n
	for i = 1, n do
		local x = -w / 2 + (i - 0.5) * sw
		part(V3(sw, 0.5, 4.4), base * CF(x, 7.3, -2.2) * CFrame.Angles(math.rad(-16), 0, 0), i % 2 == 0 and c1 or c2)
	end
end

local SHOPS = { "COFFEE", "RAMEN", "BOOKS", "ARCADE", "PIZZA", "TACOS", "VINYL", "TEA", "BAKERY", "SNEAKERS", "NOODLES", "BARBER" }
local NEONS = { rgb(132, 56, 52), rgb(52, 98, 90), rgb(46, 66, 110), rgb(176, 130, 52), rgb(98, 62, 98) }
local WALLS = {
	rgb(158, 92, 74), rgb(214, 196, 160), rgb(150, 150, 154), rgb(190, 164, 132), rgb(172, 104, 78), rgb(122, 134, 150), rgb(206, 190, 170), rgb(128, 82, 66),
}

local function filler(pos, front, w, h)
	local base = CFrame.lookAt(pos, pos + front)
	local wall = WALLS[rng:NextInteger(1, #WALLS)]
	building(base, w, 22, h, wall, wall:Lerp(C.dark, 0.6))
	local neon = NEONS[rng:NextInteger(1, #NEONS)]
	neonSign(base * CF(-w / 2 + 8, 9.2, -1.1), V3(11, 2.6, 0.7), SHOPS[rng:NextInteger(1, #SHOPS)], neon)
	awning(base * CF(0, -0.4, 0), w - 8, neon:Lerp(C.dark, 0.35), C.cream)
end

