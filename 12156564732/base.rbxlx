local ADS = {
	"FACE LAB\nTon visage, ton futur", "IRON GYM\nPas de pitie", "MOG ENERGY\nCoins x2", "CHAD COLA\nLa boisson des CHADs",
	"MODEL AVENUE\nCasting ouvert", "SIGMA GRINDSET\nReste focus", "LOOKSMAX CLINIC\n-30% ce soir",
}
local adLabels = {}
for i, e in ipairs({ { -150, 18, 0 }, { -100, 18, 0 }, { 100, 18, 0 }, { 150, 18, 0 }, { -150, -18, 1 }, { 150, -18, 1 } }) do
	local dir = (e[3] == 0) and V3(0, 0, -1) or V3(0, 0, 1)
	local pos = V3(e[1], 11, e[2])
	part(V3(0.8, 11, 0.8), CF(e[1] - 6, 5.5, e[2]), C.dark)
	part(V3(0.8, 11, 0.8), CF(e[1] + 6, 5.5, e[2]), C.dark)
	local p = part(V3(16, 8, 0.8), CFrame.lookAt(pos, pos + dir), rgb(30, 30, 36), MAT.Plastic, { TopSurface = Enum.SurfaceType.Smooth })
	local sgui = Instance.new("SurfaceGui")
	sgui.Face = Enum.NormalId.Front
	sgui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sgui.PixelsPerStud = 40
	sgui.LightInfluence = 0
	sgui.Parent = p
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundColor3 = NEONS[i % #NEONS + 1]:Lerp(rgb(20, 20, 24), 0.2)
	l.Text = ADS[i]
	l.TextScaled = true
	l.Font = Enum.Font.GothamBlack
	l.TextColor3 = WHITE
	l.Parent = sgui
	table.insert(adLabels, l)
end
task.spawn(function()
	local n = 0
	while true do
		task.wait(8)
		n += 1
		for i, l in ipairs(adLabels) do l.Text = ADS[(n + i) % #ADS + 1] end
	end
end)

-- cafe accessible + spots photo + groupes (details)
walkIn(V3(-78, 0, -84), V3(0, 0, 1), 30, 22, 14, rgb(168, 112, 84), rgb(70, 50, 44), "MOG CAFE", rgb(176, 130, 52), "Acheter un cafe", { Open = "shop", OpenZone = 1 }, "BARISTA")
photoSpot(V3(-14, 0.4, 26), "arena")
for _, p in ipairs({ { -130, -120 }, { 130, -120 }, { -130, 120 }, { 130, 120 } }) do photoSpot(V3(p[1] + 18, 0.4, p[2] + 14), "park" .. p[1] .. p[2]) end
for i = 1, 90 do
	local x, z = rng:NextInteger(-180, 180), rng:NextInteger(-180, 180)
	if (math.abs(x) > 30 or math.abs(z) > 30) and (math.abs(x) > 14 and math.abs(z) > 14) then
		local k = rng:NextInteger(1, 4)
		if k == 1 then
			part(V3(2.4, 1, 2.4), CF(x, 0.5, z), C.brick)
			part(V3(1.8, 1, 1.8), CF(x, 1.4, z), rgb(70, 128, 64))
			part(V3(0.6, 0.6, 0.6), CF(x, 2.1, z), (i % 2 == 0) and rgb(232, 120, 140) or rgb(240, 210, 90))
		elseif k == 2 then
			part(V3(3, 0.4, 1.2), CF(x, 1, z), C.wood)
			part(V3(0.4, 1, 0.4), CF(x - 1.2, 0.5, z), C.dark)
			part(V3(0.4, 1, 0.4), CF(x + 1.2, 0.5, z), C.dark)
		elseif k == 3 then
			part(V3(2, 3, 2), CF(x, 1.5, z), rgb(60, 100, 160))
			part(V3(1.4, 1.4, 0.2), CF(x, 2, z - 1.05), rgb(250, 232, 190))
		else
			part(V3(1.2, 4, 1.2), CF(x, 2, z), rgb(70, 72, 80))
			part(V3(2.6, 1.4, 0.3), CF(x, 3.6, z), rgb(150, 70, 60))
		end
	end
end

------------------------------------------------------------------
-- ZONES DEBLOQUABLES (7 mondes)
------------------------------------------------------------------
local ZT = {
	[2] = { ground = rgb(236, 212, 218), walls = { rgb(238, 190, 204), rgb(246, 226, 214), rgb(206, 176, 214) }, roof = rgb(120, 84, 104), accent = rgb(220, 108, 148), stn = { "MIRROR LAB", "GLOW SPA", "STRETCH BAR" } },
	[3] = { ground = rgb(110, 110, 114), walls = { rgb(124, 126, 132), rgb(150, 100, 80), rgb(96, 100, 110) }, roof = rgb(46, 48, 54), accent = rgb(220, 120, 50), stn = { "POWER HALL", "CARDIO BOX", "IRON PIT" } },
	[4] = { ground = rgb(240, 236, 226), walls = { rgb(244, 240, 230), rgb(230, 218, 190), rgb(214, 206, 190) }, roof = rgb(150, 120, 50), accent = rgb(214, 170, 60), stn = { "GOLD SPA", "SKY LIFT", "VIP GYM" } },
	[5] = { ground = rgb(70, 76, 90), walls = { rgb(70, 96, 140), rgb(90, 110, 150), rgb(60, 70, 96) }, roof = rgb(30, 36, 50), accent = rgb(90, 160, 230), stn = { "ALPHA GYM", "TOWER LIFT", "EXEC CARDIO" } },
	[6] = { ground = rgb(244, 244, 246), walls = { rgb(250, 250, 252), rgb(220, 220, 226), rgb(236, 226, 232) }, roof = rgb(90, 90, 100), accent = rgb(250, 150, 170), stn = { "FACE STUDIO", "RUNWAY FIT", "POSE LAB" } },
	[7] = { ground = rgb(232, 244, 255), walls = { rgb(244, 248, 255), rgb(214, 232, 250), rgb(236, 226, 255) }, roof = rgb(130, 150, 200), accent = rgb(150, 190, 255), stn = { "ASCENT", "ORACLE FACE", "TITAN FORGE" } },
	[8] = { ground = rgb(140, 40, 44), walls = { rgb(212, 170, 70), rgb(176, 130, 50), rgb(150, 36, 40) }, roof = rgb(90, 24, 28), accent = rgb(255, 214, 70), stn = { "ROYAL FORGE", "COURT FACE", "KING LIFT", "ROYAL RUN" } },
}

local function ring(c, r, n, fn)
	for i = 1, n do
		local a = i / n * math.pi * 2
		fn(c + V3(math.sin(a) * r, 0, math.cos(a) * r), a)
	end
end

local function cylX(pos, dia, th, color)
	return part(V3(th, dia, dia), CFrame.new(pos), color, MAT.Plastic, { Shape = Enum.PartType.Cylinder })
end
local function cyl(pos, dia, th, color, mat)
	return part(V3(th, dia, dia), CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2), color, mat or MAT.Plastic, { Shape = Enum.PartType.Cylinder })
end

local LANDMARK = {}
LANDMARK[2] = function(c) -- miroirs geants
	part(V3(16, 1, 6), CF(c.X, 0.5, c.Z), rgb(230, 180, 90))
	part(V3(14, 18, 1.4), CF(c.X, 10, c.Z), rgb(214, 170, 70))
	part(V3(12, 16, 0.5), CF(c.X, 10, c.Z - 0.9), rgb(190, 220, 240), MAT.Glass, { Reflectance = 0.4 })
	for _, o in ipairs({ { -22, -22 }, { 22, -22 }, { -22, 22 }, { 22, 22 } }) do
		part(V3(7, 9, 1), CF(c.X + o[1], 5.5, c.Z + o[2]), rgb(214, 170, 70))
		part(V3(5.6, 7.6, 0.4), CF(c.X + o[1], 5.5, c.Z + o[2] - 0.6), rgb(190, 220, 240), MAT.Glass, { Reflectance = 0.4 })
	end
	ring(c, 30, 18, function(p) part(V3(3, 1, 3), CF(p.X, 0.5, p.Z), rgb(232, 120, 150)) part(V3(1.4, 1.2, 1.4), CF(p.X, 1.5, p.Z), rgb(255, 210, 120)) end)
end
LANDMARK[3] = function(c) -- halteres geants + piste
	part(V3(5, 12, 5), CF(c.X - 14, 6, c.Z), C.steel)
	part(V3(5, 12, 5), CF(c.X + 14, 6, c.Z), C.steel)
	part(V3(34, 1.4, 1.4), CF(c.X, 12.5, c.Z), rgb(150, 154, 166))
	for _, sx in ipairs({ -15, 15 }) do
		cylX(V3(c.X + sx, 12.5, c.Z), 14, 2.2, rgb(40, 40, 46))
		cylX(V3(c.X + sx * 1.2, 12.5, c.Z), 10, 2.2, rgb(190, 50, 40))
	end
	for _, o in ipairs({ { 0, -34, 70, 4 }, { 0, 34, 70, 4 }, { -34, 0, 4, 70 }, { 34, 0, 4, 70 } }) do
		part(V3(o[3], 0.2, o[4]), CF(c.X + o[1], 0.35, c.Z + o[2]), rgb(176, 80, 64))
	end
	for i = 0, 3 do part(V3(3.6, 1.2 * (i + 1), 3.6), CF(c.X - 12 + i * 4, 0.6 * (i + 1), c.Z + 20), rgb(30, 30, 34)) end
end
LANDMARK[4] = function(c) -- fontaine doree + colonnes + palmiers
	for i, d in ipairs({ 22, 14, 7 }) do cyl(V3(c.X, 0.4 + i * 1.6, c.Z), d, 1.4, (i == 3) and rgb(214, 170, 60) or rgb(236, 232, 224)) end
	cyl(V3(c.X, 5.2, c.Z), 5, 0.8, rgb(120, 200, 240), MAT.Glass)
	ring(c, 36, 10, function(p)
		part(V3(3, 16, 3), CF(p.X, 8, p.Z), rgb(246, 242, 232))
		part(V3(4.4, 1.2, 4.4), CF(p.X, 16.4, p.Z), rgb(214, 170, 60))
	end)
	ring(c, 48, 8, function(p)
		part(V3(1.4, 9, 1.4), CF(p.X, 4.5, p.Z), rgb(120, 86, 50))
		for k = 0, 4 do part(V3(7, 0.5, 1.4), CF(p.X, 9.2, p.Z) * CFrame.Angles(0, k * 0.63, math.rad(-12)), rgb(70, 150, 80)) end
	end)
	local b = CF(c.X + 14, 0, c.Z + 26)
	part(V3(8, 1.6, 4), b * CF(0, 1.4, 0), rgb(214, 170, 60))
	part(V3(4.4, 1.4, 3.6), b * CF(-0.4, 2.9, 0), rgb(224, 184, 80))
end
LANDMARK[5] = function(c) -- helipad + tours de verre
	part(V3(34, 0.6, 34), CF(c.X, 0.5, c.Z), rgb(50, 54, 64))
	part(V3(2, 0.2, 14), CF(c.X - 4, 0.9, c.Z), rgb(255, 214, 70))
	part(V3(2, 0.2, 14), CF(c.X + 4, 0.9, c.Z), rgb(255, 214, 70))
	part(V3(8, 0.2, 2), CF(c.X, 0.9, c.Z), rgb(255, 214, 70))
	part(V3(8, 4, 4), CF(c.X, 3, c.Z + 8), rgb(180, 190, 210))
	part(V3(1, 3, 3), CF(c.X, 3.2, c.Z + 3.5), rgb(120, 130, 150))
	part(V3(22, 0.3, 1), CF(c.X, 5.4, c.Z + 8), rgb(60, 60, 66))
	part(V3(1, 0.3, 14), CF(c.X + 9, 3, c.Z + 8), rgb(180, 190, 210))
	ring(c, 135, 14, function(p, a)
		local base = CFrame.lookAt(p, c)
		local h = rng:NextInteger(60, 120)
		part(V3(26, h, 26), base * CF(0, h / 2, 13), rgb(44, 66, 104), MAT.Glass, { Transparency = 0.15 })
		windows(base, 22, 4, h - 2, 4, math.floor(h / 16), -0.2, true)
		part(V3(27, 1.4, 27), base * CF(0, h + 0.7, 13), C.dark)
	end)
end
LANDMARK[6] = function(c) -- podium de defile + projecteurs
	part(V3(16, 1, 130), CF(c.X, 0.5, c.Z - 10), rgb(250, 250, 252))
	for k = -6, 5 do
		part(V3(0.8, 0.3, 4), CF(c.X - 7.6, 1.15, c.Z + k * 10), rgb(255, 245, 210))
		part(V3(0.8, 0.3, 4), CF(c.X + 7.6, 1.15, c.Z + k * 10), rgb(255, 245, 210))
	end
	for _, sx in ipairs({ -14, 14 }) do
		for k = -2, 2 do
			part(V3(1, 14, 1), CF(c.X + sx, 7, c.Z + k * 22), C.dark)
			part(V3(2.4, 2, 2.4), CF(c.X + sx, 14.5, c.Z + k * 22) * CFrame.Angles(math.rad(35) * (sx > 0 and 1 or -1), 0, 0), rgb(255, 250, 230))
		end
	end
	part(V3(44, 18, 1), CF(c.X, 9, c.Z - 78), rgb(236, 226, 232))
	part(V3(30, 4, 0.4), CF(c.X, 9, c.Z - 77.4), rgb(250, 150, 170))
	for i = -2, 2 do part(V3(0.6, 5, 0.6), CF(c.X + i * 6, 2.5, c.Z - 70), C.dark) part(V3(2, 1.6, 1.4), CF(c.X + i * 6, 5.3, c.Z - 70), C.dark) end
end
LANDMARK[7] = function(c) -- temple celeste + iles flottantes
	for i = 1, 3 do part(V3(44 - i * 8, 1, 44 - i * 8), CF(c.X, i * 0.5, c.Z), rgb(246, 248, 255)) end
	ring(c, 14, 8, function(p) part(V3(2.4, 14, 2.4), CF(p.X, 8.5, p.Z), rgb(244, 246, 255)) end)
	part(V3(34, 1.4, 34), CF(c.X, 16, c.Z), rgb(214, 226, 250))
	local orb = part(V3(7, 7, 7), CF(c.X, 6, c.Z), rgb(190, 220, 255), MAT.Neon, { Shape = Enum.PartType.Ball, Transparency = 0.2 })
	local pl = Instance.new("PointLight")
	pl.Range, pl.Brightness, pl.Color = 40, 2, rgb(190, 220, 255)
	pl.Parent = orb
	part(V3(3, 160, 3), CF(c.X, 90, c.Z), rgb(190, 220, 255), MAT.Neon, { Transparency = 0.7, CanCollide = false })
	ring(c, 90, 7, function(p, a)
		local y = 25 + (math.floor(a * 10) % 4) * 14
		part(V3(24, 3, 24), CF(p.X, y, p.Z), rgb(236, 244, 255))
		part(V3(18, 2, 18), CF(p.X, y - 2.4, p.Z), rgb(150, 130, 100))
		part(V3(3, 8, 3), CF(p.X, y + 5.5, p.Z), rgb(244, 246, 255))
		part(V3(8, 1.2, 8), CF(p.X, y + 10, p.Z), rgb(214, 226, 250))
	end)
	for i = 1, 26 do
		local x, y, z = c.X + rng:NextInteger(-140, 140), rng:NextInteger(10, 45), c.Z + rng:NextInteger(-140, 140)
		part(V3(10, 5, 8), CF(x, y, z), WHITE, MAT.Plastic, { Shape = Enum.PartType.Ball, CanCollide = false, Transparency = 0.1 })
	end
end
LANDMARK[8] = function(c) -- chateau + tapis rouge + trone
	part(V3(10, 0.3, 100), CF(c.X, 0.35, c.Z + 48), rgb(190, 30, 36))
	for i = 1, 3 do part(V3(26 - i * 6, 1, 18 - i * 4), CF(c.X, i * 0.5, c.Z - 4), rgb(214, 170, 70)) end
	part(V3(6, 1.2, 5), CF(c.X, 2, c.Z - 4), rgb(214, 170, 70))
	part(V3(6, 9, 1.2), CF(c.X, 6.5, c.Z - 6), rgb(214, 170, 70))
	for _, sx in ipairs({ -3.4, 3.4 }) do part(V3(1, 3, 5), CF(c.X + sx, 3, c.Z - 4), rgb(214, 170, 70)) end
	local keep = CF(c.X, 0, c.Z - 150)
	part(V3(70, 46, 40), keep * CF(0, 23, 0), rgb(176, 130, 50))
	for _, sx in ipairs({ -40, 40 }) do
		part(V3(14, 62, 14), keep * CF(sx, 31, 0), rgb(150, 110, 44))
		part(V3(18, 4, 18), keep * CF(sx, 63, 0), rgb(150, 36, 40))
	end
	for i = -8, 8 do part(V3(3, 3, 3), keep * CF(i * 4, 47.5, -19), rgb(176, 130, 50)) end
	part(V3(14, 18, 1), keep * CF(0, 9, 20.5), rgb(60, 36, 30))
	for i = 1, 8 do
		local side = (i % 2 == 0) and 1 or -1
		local z = c.Z + 10 + i * 10
		part(V3(3, 1.2, 3), CF(c.X + side * 9, 0.6, z), rgb(214, 170, 70))
		part(V3(2, 6, 2), CF(c.X + side * 9, 4.2, z), rgb(214, 170, 70))
		part(V3(1.6, 1.6, 1.6), CF(c.X + side * 9, 8, z), rgb(214, 170, 70))
		part(V3(0.4, 10, 4), CF(c.X + side * 13, 8, z), rgb(190, 30, 36))
	end
end

for zi = 2, 8 do
	local zc, th = ZONES[zi], ZT[zi]
	local c = zc.center
	local folder = Instance.new("Folder")
	folder.Name = "Zone_" .. zi
	folder.Parent = map
	curParent = folder
	part(V3(300, 2, 300), CF(c.X, -1, c.Z), th.ground)
	for _, w in ipairs({ { 0, -151, 302, 2 }, { 0, 151, 302, 2 }, { -151, 0, 2, 302 }, { 151, 0, 2, 302 } }) do
		part(V3(w[3], 120, w[4]), CF(c.X + w[1], 60, c.Z + w[2]), WHITE, MAT.Plastic, { Transparency = 1, CanQuery = false })
		part(V3(w[3], 3, w[4]), CF(c.X + w[1], 1.5, c.Z + w[2]), th.walls[1]:Lerp(C.dark, 0.3))
	end
	-- plaza centrale en damier
	for i = -4, 3 do
		for j = -4, 3 do
			part(V3(6, 0.2, 6), CF(c.X + i * 6 + 3, 0.1, c.Z + j * 6 + 3), ((i + j) % 2 == 0) and th.ground:Lerp(WHITE, 0.15) or th.ground:Lerp(th.accent, 0.18))
		end
	end
	LANDMARK[zi](c)
	local function T(i, key)
		return { wall = th.walls[(i % #th.walls) + 1], roof = th.roof, accent = th.accent, floor = th.ground:Lerp(th.accent, 0.25), title = th.stn[i], sub = "ZONE " .. zi .. " - PRO TRAINING", stat = STATNAME[key], zone = zi }
	end
	local function front(p) return (c - p) * V3(1, 0, 1) end
	local stn = zc.stations
	local slots = { V3(c.X + 74, 0, c.Z), V3(c.X - 74, 0, c.Z), V3(c.X + 56, 0, c.Z + 56), V3(c.X - 56, 0, c.Z + 56) }
	for i = 1, #stn do
		local p = slots[i]
		shop(p, front(p).Unit, T(i, stn[i]), stn[i])
	end
	-- boutique, quetes, boss, clinique
	local shopPos = V3(c.X, 0, c.Z - 78)
	walkIn(shopPos, V3(0, 0, 1), 34, 24, 15, th.walls[1], th.roof, "BOUTIQUE", th.accent, "Ouvrir la boutique", { Open = "shop", OpenZone = zi }, "VENDEUR")
	walkIn(V3(c.X + 58, 0, c.Z - 58), front(V3(c.X + 58, 0, c.Z - 58)).Unit, 26, 20, 13, th.walls[2], th.roof, "QUETES", th.accent, "Voir les quetes", { Open = "quests" }, "QUEST MASTER")
	if #stn < 4 then
		walkIn(V3(c.X - 56, 0, c.Z + 56), front(V3(c.X - 56, 0, c.Z + 56)).Unit, 26, 20, 13, th.walls[3], th.roof, "FACE CLINIC", th.accent, "Ouvrir le Face Lab", { Open = "facelab", OpenZone = zi }, "DOCTEUR")
	end
	local bp = V3(c.X - 58, 0, c.Z - 58)
	part(V3(30, 0.5, 30), CF(bp.X, 0.25, bp.Z), th.accent:Lerp(C.dark, 0.4))
	for _, sx in ipairs({ -14, 14 }) do part(V3(2, 8, 2), CF(bp.X + sx, 4, bp.Z - 14), th.accent) part(V3(2, 8, 2), CF(bp.X + sx, 4, bp.Z + 14), th.accent) end
	neonSign(CF(bp.X, 12, bp.Z - 15), V3(14, 3, 0.7), "BOSS ARENA", th.accent, true)
	npc(bp + V3(0, 0.5, 0), c, zc.boss .. " (BOSS)", th.accent:Lerp(C.dark, 0.5), "Defier le boss", { Boss = zi })
	-- portails : retour ville, zone precedente, zone suivante
	local gz = c.Z + 112
	arch(CF(c.X, 0, gz) * CFrame.Angles(0, 0, 0), "", 0, ZONES[1].col, 1)
	local back = part(V3(9, 2.2, 0.4), CF(c.X, 15.6, gz - 1.6), rgb(46, 40, 38), MAT.Plastic, { TopSurface = Enum.SurfaceType.Smooth })
	gui(back, Enum.NormalId.Front, "BEGINNER CITY", WHITE, 30)
	if zi > 2 then
		arch(CF(c.X - 26, 0, gz), "", ZONES[zi - 1].req, ZONES[zi - 1].col, zi - 1)
		local l = part(V3(9, 2.2, 0.4), CF(c.X - 26, 15.6, gz - 1.6), rgb(46, 40, 38), MAT.Plastic, { TopSurface = Enum.SurfaceType.Smooth })
		gui(l, Enum.NormalId.Front, string.gsub(ZONES[zi - 1].name, " ", "\n", 1), WHITE, 30)
	end
	if zi < 8 then
		arch(CF(c.X + 26, 0, gz), "", ZONES[zi + 1].req, ZONES[zi + 1].col, zi + 1)
		local l = part(V3(9, 2.2, 0.4), CF(c.X + 26, 15.6, gz - 1.6), rgb(46, 40, 38), MAT.Plastic, { TopSurface = Enum.SurfaceType.Smooth })
		gui(l, Enum.NormalId.Front, string.gsub(ZONES[zi + 1].name, " ", "\n", 1), WHITE, 30)
	end
	neonSign(CF(c.X, 24, c.Z + 20) * CFrame.Angles(0, math.pi, 0), V3(40, 6, 0.8), zc.name, th.accent, true)
	-- lampadaires + details
	ring(c, 62, 12, function(p) lamp(p.X, p.Z, 0) end)
	for i = 1, 40 do
		local a, r = rng:NextNumber(0, math.pi * 2), rng:NextNumber(40, 135)
		local p = c + V3(math.sin(a) * r, 0, math.cos(a) * r)
		if zi ~= 7 and (math.abs(p.X - c.X) > 12) then tree(p.X, p.Z) end
	end
	photoSpot(c + V3(26, 0.4, 24), "zone" .. zi)
	for i = 1, 3 do
		local a = rng:NextNumber(0, 6)
		bench(CFrame.new(c.X + math.sin(a) * 30, 0, c.Z + math.cos(a) * 30) * CFrame.Angles(0, a, 0))
	end
	curParent = nil
end

-- murs invisibles
for _, w in ipairs({ { 0, -221, 440, 2 }, { 0, 221, 440, 2 }, { -221, 0, 2, 440 }, { 221, 0, 2, 440 } }) do
	part(V3(w[3], 120, w[4]), CF(w[1], 60, w[2]), WHITE, MAT.Plastic, { Transparency = 1, CanQuery = false })
end
