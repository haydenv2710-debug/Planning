-- DECOR DE RUE
------------------------------------------------------------------
for i = -5, 5 do
	local x = i * 32
	if math.abs(x) > 40 then
		lamp(x, -14, 0)
		lamp(x, 14, math.pi)
		lamp(14, x, -math.pi / 2)
		lamp(-14, x, math.pi / 2)
	end
end
lamp(-30, -14, 0) lamp(30, -14, 0) lamp(-30, 14, math.pi) lamp(30, 14, math.pi)

local carColors = { rgb(200, 60, 60), rgb(60, 110, 200), rgb(230, 190, 70), rgb(90, 90, 100), rgb(80, 160, 120), rgb(220, 220, 224) }
for i = 1, 14 do
	local x = rng:NextInteger(-170, 170)
	if math.abs(x) > 26 then
		local z = (i % 2 == 0) and 8.5 or -8.5
		car(CF(x, 0.2, z) * CFrame.Angles(0, (z > 0) and 0 or math.pi, 0), carColors[rng:NextInteger(1, #carColors)])
	end
end
for i = 1, 8 do
	local z = rng:NextInteger(-170, 170)
	if math.abs(z) > 30 then
		local x = (i % 2 == 0) and 8.5 or -8.5
		car(CF(x, 0.2, z) * CFrame.Angles(0, (x > 0) and math.pi / 2 or -math.pi / 2, 0), carColors[rng:NextInteger(1, #carColors)])
	end
end

for i = -4, 4 do
	if math.abs(i * 40) > 30 then
		tree(i * 40 + 12, -28)
		tree(i * 40 - 12, 28)
		tree(28, i * 40 + 12)
		tree(-28, i * 40 - 12)
		bench(CF(i * 40, 0, -16.5))
		bench(CF(i * 40 + 20, 0, 16.5) * CFrame.Angles(0, math.pi, 0))
		hydrant(i * 40 + 6, -15)
		bin(i * 40 - 6, 15)
		bin(15, i * 40 + 6)
	end
end
for i = 1, 20 do
	local x, z = rng:NextInteger(-170, 170), (rng:NextNumber() < 0.5) and -21 or 21
	if math.abs(x) > 30 then
		crate(x, 0, z, 2.4)
		crate(x + 2.6, 0, z, 2.4)
	end
end

